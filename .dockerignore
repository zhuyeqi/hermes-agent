# Git
.git
.gitignore
.gitmodules

# Dependencies
node_modules
**/node_modules
.venv
**/.venv

# Built artifacts that are regenerated inside the image.  Excluded so local
# rebuilds on the developer's machine don't invalidate the npm-install layer
# that now depends on the full ui-tui/packages/hermes-ink/ tree being present.
ui-tui/dist/
ui-tui/packages/hermes-ink/dist/

# CI/CD
.github

# Environment files
.env

*.md
!docker/webwright/**/*.md

# macOS
.DS_Store
**/.DS_Store

# IDE / editor
.idea/
.vscode/
.cursor/

# Claude / agent artifacts
.claude/
.remember/
.plans/
.tmp-hermes-home/

# Test / debug
.pytest_cache/
tests/

# Runtime data (bind-mounted at /opt/data; must not leak into build context)
data/

# Compose/profile runtime state (bind-mounted; avoid ownership/secret issues)
hermes-config/
runtime/

# Optional local Webwright checkout for Dockerfile.yc.
# Leave ignored by git; include in Docker build context when present.
!docker/webwright/
!docker/webwright/**
