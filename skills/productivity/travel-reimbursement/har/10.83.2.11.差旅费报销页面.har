          "content": {
            "size": 2905,
            "mimeType": "application/x-javascript",
            "text": "define(['jquery'],function($) {\t\n\tvar billcheck = {};\n\t\n\tbillcheck.callback=null;\n\tbillcheck.timeFlag=null;\n\tbillcheck.result={};\n\n\tvar djzt=getRequestString(\"djzt\");\n\tif(\"35\"==djzt){\n\t\tdisablebtn();\t\n\t}\n\n\tbillcheck.checkbill=function(result,callback){\t\t \n\t\t init(result,callback);\t \n\t\t //billcheck.timeFlag = window.setInterval(function() { startcheckbill (); }, 5000);\n\t\t// startcheckbill ();\n\t\tif( result.success == \"false\"){\n\t\t\terror_show();\n\t\t}else{\n\t\t\tresult_show();\n\t\t}\n\t}\n\t\n\tfunction error_show(){\t\n\t\tdisablebtn();\n\t\tlocation.hash = '/view/' + billcheck.result.msg_pk_bill;\n\t\t$.showMessageDialog({\n\t\t\t\t\t\t\t\ttype : \"info\",\n\t\t\t\t\t\t\t\ttitle : \"提示\",\n\t\t\t\t\t\t\t\tmsg : billcheck.result.message,\n\t\t\t\t\t\t\t\tbackdrop : true\n\t\t\t\t\t\t\t});\n\t}\n \n\tfunction result_show(){\t\n\t\tif(billcheck.callback){\n\t\t\tbillcheck.callback();\n\t\t}else{\n\t\t\twindow.location.reload();\n\t\t}\n\t}\n\n\tfunction init(result,callback){\t\n\t\tbillcheck.result=result;\n\t\tbillcheck.callback=callback;\n\t}\n\n\tfunction disablebtn(){\n\t\t$(\"#bfAdd\").attr(\"disabled\",\"disabled\");\n\t\t$(\"#bfEdit\").attr(\"disabled\",\"disabled\");\n\t\t$(\"#bfDelete\").attr(\"disabled\",\"disabled\");\n\t\t$(\"#bfPrint\").attr(\"disabled\",\"disabled\");\n\t\t$(\"#imageupload\").attr(\"disabled\",\"disabled\");\n\t\t$(\"#editBtn #imageupload:first\").attr(\"disabled\",\"disabled\")\n\n\t\t$(\"#imageshow\").attr(\"disabled\",\"disabled\");\n\t\t\n\t\t$(\"#bfSubmit\").attr(\"disabled\",\"disabled\");\n\t\t$(\"#bfUnsendapprove\").attr(\"disabled\",\"disabled\");\t\n\t\t$(\"#bfSave\").attr(\"disabled\",\"disabled\");\n\t\t$(\"#bfTemporary\").attr(\"disabled\",\"disabled\");\n\t}\n\n\tfunction getRequestString(name){\n\t\tvar reg = new RegExp(\"(^|&)\"+ name +\"=([^&]*)(&|$)\");\n\t\tvar r = window.location.search.substr(1).match(reg);\n\t\tif(r!=null)return  unescape(r[2]); return null;\n\t}\n\n\tfunction stopcheckbill(){\t\t \n\t\tif(billcheck.timeFlag){\n\t\t\tclearInterval(billcheck.timeFlag);\n\t\t\tbillcheck.timeFlag = null;\n\t\t}\n\t}\n\tfunction startcheckbill(){\t\n\t\tif(billcheck.timeFlag == null){\n\t\t\treturn;\n\t\t}\n\t\tvar param={};\n\t\tparam.pk_bill = billcheck.result.pk_bill;\n\n\t\t$.ajax({ \n\t\t\t\ttype: \"GET\", \n\t\t\t\turl: \"/iwebap/msg_ctr/checkbill?time=\"+ new Date().getTime(), \n\t\t\t\tdata:param, \n\t\t\t\tdataType: \"json\" ,\n\t\t\t\tsuccess: function(result) {\n\t\t\t\t\tif(billcheck.timeFlag == null){\n\t\t\t\t\t\treturn;\n\t\t\t\t\t}\n\t\t\t\t\tvar ret = result[\"code\"];\n\t\t\t\t\tif(ret ==\"0\"){  //  0:not_exsit or finished\n\t\t\t\t\t\tstopcheckbill();\n\t\t\t\t\t\tresult_show();\n\t\t\t\t\t}else if(ret ==\"1\"){ // 1:excute; \n\t\t\t\t\t\t\n\t\t\t\t\t\t\n\t\t\t\t\t}else if(ret ==\"2\"){ // 2 :error\n\t\t\t\t\t\tstopcheckbill();\n\t\t\t\t\t\tvar msghit =  result[\"bizerror\"] != null ? result[\"bizerror\"] : \"发生未知原因错误\";\n\t\t\t\t\t\t$.showMessageDialog({\n\t\t\t\t\t\t\t\ttype : \"info\",\n\t\t\t\t\t\t\t\ttitle : \"提示\",\n\t\t\t\t\t\t\t\tmsg : msghit,\n\t\t\t\t\t\t\t\tbackdrop : true\n\t\t\t\t\t\t\t});\n\n\t\t\t\t\t}else{// other :nerver run here\n\t\t\t\t\t\tstopcheckbill();\n\t\t\t\t\t\t\n\t\t\t\t\t}\n\t\t\t\t},\n\t\t\t\terror: function(XMLHttpRequest, textStatus, errorThrown) {\n\t\t\t\t\t\tstopcheckbill();\n                }\n\t\t\t});\n\t\t\n\t}\n\n\treturn billcheck;\n})\n"
          },
