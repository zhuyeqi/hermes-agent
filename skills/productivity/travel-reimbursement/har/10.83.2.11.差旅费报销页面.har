            "mimeType": "application/x-javascript",
            "text": "// 模版前台工具方法\r\n// ======================\r\nTempletUtils.prototype.queryBillList = function(funcode, nodekey) {\r\n\treturn this.queryTempletInfo(0, funcode, nodekey, \"v_pub_billlist\");\r\n}\r\n\r\nTempletUtils.prototype.queryBillForm = function(funcode, nodekey) {\r\n\treturn this.queryTempletInfo(0, funcode, nodekey, \"v_pub_billform\");\r\n}\r\n\r\nTempletUtils.prototype.queryQTInfo = function(funcode, nodekey) {\r\n\treturn this.queryTempletInfo(1, funcode, nodekey, \"v_pub_queryform\");\r\n}\r\n\r\nTempletUtils.prototype.queryTempletInfo = function(type, funcode, nodekey, page) {\r\n\tvar templetvo = {};\r\n\tvar btPara = {};\r\n\tbtPara.templateType = type;\r\n\tbtPara.funNode = funcode;\r\n\tbtPara.nodeKey = nodekey;\r\n\tbtPara.pageTemplate = page;\r\n\r\n\tthis.app.ajax({\r\n\t\ttype : \"POST\",\r\n\t\turl : \"/iwebap/templet_ctr/query\",\r\n\t\tdata : btPara,\r\n\t\tasync : false,\r\n\t\tdataType : \"json\",\r\n\t\tsuccess : function(result) {\r\n\t\t\tret = result;\r\n\t\t}\r\n\t});\r\n\r\n\treturn ret;\r\n}\r\n\r\nfunction TempletUtils(app) {\r\n\tthis.app = app;\r\n}"
