            "size": 2979,
            "mimeType": "application/x-javascript",
            "text": "/* ==========================================================\r\n * sco.message.js\r\n * http://github.com/terebentina/sco.js\r\n * ==========================================================\r\n * Copyright 2013 Dan Caragea.\r\n *\r\n * Licensed under the Apache License, Version 2.0 (the \"License\");\r\n * you may not use this file except in compliance with the License.\r\n * You may obtain a copy of the License at\r\n *\r\n * http://apache.org/licenses/LICENSE-2.0\r\n *\r\n * Unless required by applicable law or agreed to in writing, software\r\n * distributed under the License is distributed on an \"AS IS\" BASIS,\r\n * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.\r\n * See the License for the specific language governing permissions and\r\n * limitations under the License.\r\n * ========================================================== */\r\n\r\n/*jshint laxcomma:true, sub:true, browser:true, jquery:true, eqeqeq: false */\r\n\r\n;(function($, undefined) {\r\n\t\"use strict\";\r\n\r\n\tvar pluginName = 'scojs_message';\r\n\r\n\t$[pluginName] = function(message, type) {\r\n\t\tclearTimeout($[pluginName].timeout);\r\n\t\tvar $selector = $('#' + $[pluginName].options.id);\r\n\t\tvar htmlmessage;\r\n\t\t\r\n\t\tif (!$selector.length) {\r\n\t\t\t$selector = $('<div/>', {id: $[pluginName].options.id}).appendTo($[pluginName].options.appendTo);\r\n\t\t}\r\n\t\tif (message.indexOf('保存成功')!=-1) {\r\n\t\t\thtmlmessage = \"<span class='savespan'><img src='/iwebap/images/savesuc.png'></span><span class='infowords'>\"+message+\"</span>\";\r\n\t\t}else if(message.indexOf('保存失败')!=-1){\r\n\t\t\thtmlmessage = \"<span class='savespan'><img src='/iwebap/images/savefalse.png'></span><span class='infowords'>\"+message+\"</span>\";\r\n\t\t}else{\r\n\t\t\thtmlmessage = \"<span class='infowords'>\"+message+\"</span>\";\r\n\t\t}\r\n\t\t$selector.html(htmlmessage);\r\n        $selector.css({cursor:'pointer'});\r\n\t\tif (type === undefined || type == $[pluginName].TYPE_ERROR) {\r\n\t\t\t$selector.removeClass($[pluginName].options.okClass).addClass($[pluginName].options.errClass);\r\n\t\t} else if (type == $[pluginName].TYPE_OK) {\r\n\t\t\t$selector.removeClass($[pluginName].options.errClass).addClass($[pluginName].options.okClass);\r\n        } else if (type == $[pluginName].TYPE_WARN) {\r\n            $selector.removeClass($[pluginName].options.errClass).addClass($[pluginName].options.warnClass);\r\n\t\t}\r\n\t\t$selector.slideDown('fast', function() {\r\n\t\t\t$[pluginName].timeout = setTimeout(function() { $selector.slideUp('fast'); }, $[pluginName].options.delay);\r\n\t\t});\r\n        $selector.click(function(){\r\n            $selector.slideUp('fast');\r\n        });\r\n\t};\r\n\r\n\r\n\t$.extend($[pluginName], {\r\n\t\toptions: {\r\n\t\t\tid: 'page_message'\r\n\t\t\t,okClass: 'page_mess_ok'\r\n            ,warnClass: 'page_mess_warn'\r\n\t\t\t,errClass: 'page_mess_error'\r\n\t\t\t,delay: 4000\r\n\t\t\t,appendTo: 'body'\t// where should the modal be appended to (default to document.body). Added for unit tests, not really needed in real life.\r\n\t\t},\r\n\r\n\t\tTYPE_ERROR: 1,\r\n        TYPE_WARN:3,\r\n\t\tTYPE_OK: 2\r\n\t});\r\n})(jQuery);"
          },
