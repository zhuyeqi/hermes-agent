          "content": {
            "size": 13030,
            "mimeType": "application/x-javascript",
            "text": "define(['jquery', 'knockout','compevent','bignumber','/iwebap/js/BillFormActionUtils.js','/iwebap/erm/js/SimpleMap.js'], function($, ko, compevent, bignumber) {\n\tvar ctrl = {};\n\tparent.lianchactrl = ctrl;\n\tctrl.headButtongroups = [];//按钮注册\n\tctrl.pagesize=\"\";\n\tctrl.bignumber = bignumber;\n\tctrl.tradetype;\n\tctrl.openBillId;\n    var billData = [];\n    var applyData = [];\n\tctrl.extendViewModel = function(viewModel, app, preProcessInfo){\n\t\tvar dataTableIDs = preProcessInfo.dataTableIDs;\n\t}\n\n\tctrl.init = function(viewModel,app, billListModel){\t\n\t\tctrl.viewModel = viewModel;\n\t\tctrl.app = app;\n\t\tctrl.billListModel = billListModel;\n\t\tif(window.location.hash!==\"#/add\"){\n\t\t\tvar str = window.location.hash;\n\t\t\tvar openBillId = str.substr(str.lastIndexOf('/')+1);\n\t\t\tvar tradetype = getRequest().tradetype;\n\t\t\tctrl.loadData(tradetype,openBillId);\n\t\t}\t\n\t}\n\n\tctrl.loadData = function(tradetype,openBillId){\n\t\tctrl.tradetype = tradetype;\n\t\tctrl.openBillId = openBillId;\n\t\t//设置页签名称\n\t\tif(tradetype.indexOf(\"264\")===0){\n\t\t\t$(\"#grid_jkbx_title\").html(\"联查借款单\");\n\t\t}else if(tradetype.indexOf(\"263\")===0){\n\t\t\t$(\"#grid_jkbx_title\").html(\"联查报销单\");\n\t\t}\n\t\t$(\"#grid_ys_title\").html(\"联查预算\");\n\t\t$(\"#grid_pz_title\").html(\"联查凭证\");\n\t\tif(tradetype!=\"2647\"){\n\t\t\t$(\"#grid_apply_title\").html(\"联查费用申请单\");\n\t\t}\n\t\t//默认选中联查预算页签\n\t\tctrl.lianchaShow(0); \n\t}\n\n\tctrl.loadJKBX = function(tradetype,openBillId){\n\t\t//加载模板和数据\n\t\t$.ajax({\n\t\t\ttype: 'GET',\n\t\t\turl: \"/iwebap/jkbx_linkquery_ctr/loadTemplate?tradetype=\"+tradetype+\"&time=\"+ new Date().getTime(),\n\t\t\tdataType: 'json',\n\t\t\tasync:false,\n\t\t\tsuccess: function (data) {\n\t\t\t\t// $(\"#grid_jkbx\").empty();\n\t\t\t\tif(data[\"success\"] == \"true\"){\n\t\t\t\t\tif(data.columns){\n\t\t\t\t\t\t//创建表格\n\t\t\t\t\t\tctrl.viewModel[\"grid_jkbx\"] =$(\"#grid_jkbx\").grid({\n\t\t\t\t\t\t\tid: \"grid_jkbx\",\n\t\t\t\t\t\t\teditable: false, //是否可修改\n\t\t\t\t\t\t\tsortable: false,\n\t\t\t\t\t\t\tshowNumCol: true,\n\t\t\t\t\t\t\tmultiSelect: false,\n\t\t\t\t\t\t\tshowSumRow: false,\n\t\t\t\t\t\t\tshowTree: false,\n\t\t\t\t\t\t\tautoExpand: true,\n\t\t\t\t\t\t\tkeyField: 'id',\n\t\t\t\t\t\t\tparentKeyField: 'pid',\n\t\t\t\t\t\t\tcolumnMenu: false,\n\t\t\t\t\t\t\tcanDrag: true,\n\t\t\t\t\t\t\tcolumns:data.columns\n\t\t\t\t\t\t});\n\t\t\t\t\t\t//加载数据\n\t\t\t\t\t\tif(openBillId == \"\"){\n\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t$.ajax({\n\t\t\t\t\t\t\t\ttype: 'GET',\n\t\t\t\t\t\t\t\turl: \"/iwebap/jkbx_linkquery_ctr/loadData?queryType=jkbx&openBillId=\"+openBillId+\"&tradetype=\"+tradetype+\"&time=\"+ new Date().getTime(),\n\t\t\t\t\t\t\t\tdataType: 'json',\n\t\t\t\t\t\t\t\tsuccess: function (data) {\n\t\t\t\t\t\t\t\t\tif(data[\"success\"] == \"true\"){\n\t\t\t\t\t\t\t\t\t\tvar jkbxValues = {};//借款报销页签\n\t\t\t\t\t\t\t\t\t\tjkbxValues.values = data.jkbxValues;\n\t\t\t\t\t\t\t\t\t\tctrl.viewModel[\"grid_jkbx\"].setDataSource(jkbxValues);\n\t\t\t\t\t\t\t\t\t\tbillData = data.jkbxValues;\n\t\t\t\t\t\t\t\t\t\tctrl.setJkBxId();\n\t\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\t\t$.showMessageDialog({type:\"info\",title:\"提示\",msg: data[\"Msg\"],backdrop:true});\n\t\t\t\t\t\t\t\t\t} \n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}else{\n\t\t\t\t\t$.showMessageDialog({type:\"info\",title:\"提示\",msg: data[\"Msg\"],backdrop:true});\n\t\t\t\t} \n\t\t\t}\n\t\t});\n\n\t}\n\n\tctrl.loadYS = function(tradetype,openBillId){\n\t\t//加载模板和数据\n\t\tctrl.viewModel[\"grid_ys\"] = $(\"#grid_ys\").grid({\n\t\t\tid: \"grid_ys\",\n\t\t\teditable: false, //是否可修改\n\t\t\tsortable: false,\n\t\t\tshowNumCol: true,\n\t\t\tmultiSelect: false,\n\t\t\tshowSumRow: false,\n\t\t\tshowTree: false,\n\t\t\tautoExpand: true,\n\t\t\tkeyField: 'id',\n\t\t\tparentKeyField: 'pid',\n\t\t\tcolumnMenu: false,\n\t\t\tcanDrag: true,\n\t\t\tcolumns:ctrl[\"grid_ys\"].columns\n\t\t});\n\t\t//加载数据\n\t\tif(openBillId == \"\"){\n\t\t\treturn;\n\t\t}else{\n\t\t\t$.ajax({\n\t\t\t\ttype: 'GET',\n\t\t\t\turl: \"/iwebap/jkbx_linkquery_ctr/loadData?queryType=ys&openBillId=\"+openBillId+\"&tradetype=\"+tradetype+\"&time=\"+ new Date().getTime(),\n\t\t\t\tdataType: 'json',\n\t\t\t\tsuccess: function (data) {\n\t\t\t\t\t//$(\"#grid_ys\").empty();\n\t\t\t\t\tif(data[\"success\"] == \"true\"){\n\t\t\t\t\t\tvar ysValues = {};//预算页签\n\t\t\t\t\t\tysValues.values = data.ysValues;\n\t\t\t\t\t\tctrl.viewModel[\"grid_ys\"].setDataSource(ysValues);\n\t\t\t\t\t}else{\n\t\t\t\t\t\t$.showMessageDialog({type:\"info\",title:\"提示\",msg: data[\"Msg\"],backdrop:true});\n\t\t\t\t\t} \n\t\t\t\t}\n\t\t\t});\n\t\t}\n\t}\n\n\tctrl.loadPZ = function(tradetype,openBillId){\n\t\t//加载数据\n\t\tif(openBillId == \"\"){\n\t\t\treturn;\n\t\t}else{\n\t\t\t$.ajax({\n\t\t\t\ttype: 'GET',\n\t\t\t\turl: \"/iwebap/jkbx_linkquery_ctr/loadData?queryType=pz&openBillId=\"+openBillId+\"&tradetype=\"+tradetype+\"&time=\"+ new Date().getTime(),\n\t\t\t\tdataType: 'json',\n\t\t\t\tsuccess: function (data) {\n\t\t\t\t\t//$(\"#grid_pz\").empty();\n\t\t\t\t\tif(data[\"success\"] == \"true\"){\n\t\t\t\t\t\tif(data.pzValues.length>0){\n\t\t\t\t\t\t\tfor(var i=0;i<data.pzValues.length;i++){//凭证可能有多张\n\t\t\t\t\t\t\t\tif(data.pzValues[i]){\n\t\t\t\t\t\t\t\t\tvar before = \"grid_pz_before\" + i;\n\t\t\t\t\t\t\t\t\tvar main = \"grid_pz_main\" + i;\n\t\t\t\t\t\t\t\t\tvar after = \"grid_pz_after\" + i;\n\t\t\t\t\t\t\t\t\t$(\"#grid_pz\").append(\"<div id='\" + before + \"' class='\" + before + \"'></div>\");\n\t\t\t\t\t\t\t\t\t$(\"#grid_pz\").append(\"<div id='\" + main + \"'></div>\");\n\t\t\t\t\t\t\t\t\t$(\"#grid_pz\").append(\"<div id='\" + after + \"' class='\" + after + \"'></div>\");\n\t\t\t\t\t\t\t\t\tctrl.viewModel[main] = $(\"#\" + main).grid({\n\t\t\t\t\t\t\t\t\t\tid: main,\n\t\t\t\t\t\t\t\t\t\teditable: false, //是否可修改\n\t\t\t\t\t\t\t\t\t\tsortable: false,\n\t\t\t\t\t\t\t\t\t\tshowNumCol: true,\n\t\t\t\t\t\t\t\t\t\tmultiSelect: false,\n\t\t\t\t\t\t\t\t\t\tshowSumRow: false,\n\t\t\t\t\t\t\t\t\t\tshowTree: false,\n\t\t\t\t\t\t\t\t\t\tautoExpand: true,\n\t\t\t\t\t\t\t\t\t\tkeyField: 'id',\n\t\t\t\t\t\t\t\t\t\tparentKeyField: 'pid',\n\t\t\t\t\t\t\t\t\t\tcolumnMenu: false,\n\t\t\t\t\t\t\t\t\t\tcanDrag: true,\n\t\t\t\t\t\t\t\t\t\tcolumns:ctrl[\"grid_pz_main\"].columns\n\t\t\t\t\t\t\t\t\t});\n\t\t\t\t\t\t\t\t\tvar pzValues = {};//凭证页签\n\t\t\t\t\t\t\t\t\tpzValues.values = data.pzValues[i];\n\t\t\t\t\t\t\t\t\tctrl.viewModel[main].setDataSource(pzValues);\n\t\t\t\t\t\t\t\t\tvar vouchertypename = (data.pzValues[i])[0].vouchertypename===null ? \"\" : (data.pzValues[i])[0].vouchertypename;\n\t\t\t\t\t\t\t\t\tvar pk_accountingbook = (data.pzValues[i])[0].pk_accountingbook===null ? \"\" : (data.pzValues[i])[0].pk_accountingbook;\n\t\t\t\t\t\t\t\t\tvar prepareddate = (data.pzValues[i])[0].prepareddate===null ? \"\" : (data.pzValues[i])[0].prepareddate;\n\t\t\t\t\t\t\t\t\tvar no = (data.pzValues[i])[0].no===null ? \"\" : (data.pzValues[i])[0].no;\n\t\t\t\t\t\t\t\t\tvar totalLocaldebitamount = (data.pzValues[i])[0].totalLocaldebitamount===null ? \"\" : (data.pzValues[i])[0].totalLocaldebitamount;\n\t\t\t\t\t\t\t\t\tvar totalLocalcreditamount = (data.pzValues[i])[0].totalLocalcreditamount===null ? \"\" : (data.pzValues[i])[0].totalLocalcreditamount;\n\t\t\t\t\t\t\t\t\tvar pk_system = \"费用管理\";\n\t\t\t\t\t\t\t\t\tvar billmaker = (data.pzValues[i])[0].billmaker===null ? \"\" : (data.pzValues[i])[0].billmaker;\n\t\t\t\t\t\t\t\t\tvar pzBefore = \"<h4>\" + vouchertypename + \"</h4><div class='row'><div class='col-md-4'>财务核算账簿：\" + pk_accountingbook + \" </div><div class='col-md-4'>凭证日期：\" + prepareddate + \" </div><div class='col-md-4'>凭证号：\" + no+\"</div></div>\";\n\t\t\t\t\t\t\t\t\tvar pzAfter = \"<div class='row'><div class='col-md-12'>本币金额合计，借方：\" + ctrl.getFormatNumber(totalLocaldebitamount) +\"，贷方：\" + ctrl.getFormatNumber(totalLocalcreditamount) + \"</div></div> <div class='row'><div class='col-md-8'>来源系统：\" \n\t\t\t\t\t\t\t\t\t+ pk_system + \" </div><div class='col-md-4'>制单人：\" + billmaker+'</div></div>';\n\t\t\t\t\t\t\t\t\t$(\"#\" + before).html(pzBefore);\n\t\t\t\t\t\t\t\t\t$(\"#\" + after).html(pzAfter);\n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t$(\"#grid_pz\").append(\"<div id='grid_pz_main0'></div>\");\n\t\t\t\t\t\t\tctrl.viewModel['grid_pz_main0'] = $(\"#grid_pz_main0\").grid({\n\t\t\t\t\t\t\t\t\tid: 'grid_pz_main0',\n\t\t\t\t\t\t\t\t\teditable: false, //是否可修改\n\t\t\t\t\t\t\t\t\tsortable: false,\n\t\t\t\t\t\t\t\t\tshowNumCol: true,\n\t\t\t\t\t\t\t\t\tmultiSelect: false,\n\t\t\t\t\t\t\t\t\tshowSumRow: false,\n\t\t\t\t\t\t\t\t\tshowTree: false,\n\t\t\t\t\t\t\t\t\tautoExpand: true,\n\t\t\t\t\t\t\t\t\tkeyField: 'id',\n\t\t\t\t\t\t\t\t\tparentKeyField: 'pid',\n\t\t\t\t\t\t\t\t\tcolumnMenu: false,\n\t\t\t\t\t\t\t\t\tcanDrag: true,\n\t\t\t\t\t\t\t\t\tcolumns:ctrl[\"grid_pz_main\"].columns\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\t\t\n\t\t\t\t\t}else{\n\t\t\t\t\t\t$.showMessageDialog({type:\"info\",title:\"提示\",msg: data[\"Msg\"],backdrop:true});\n\t\t\t\t\t} \n\t\t\t\t}\n\t\t\t});\n\t\t}\n\t}\n\n\tctrl.loadApply = function (tradetype,openBillId){\n\t\t//加载模板和数据\n\t\t$.ajax({\n\t\t\ttype: 'GET',\n\t\t\turl: \"/iwebap/jkbx_linkquery_ctr/loadTemplate?tradetype=\"+tradetype+\"&time=\"+ new Date().getTime(),\n\t\t\tdataType: 'json',\n\t\t\tasync:false,\n\t\t\tsuccess: function (data) {\n\t\t\t\tif(data[\"success\"] == \"true\"){\n\t\t\t\t\t//$(\"#grid_apply\").empty();\n\t\t\t\t\tif(data.columns){\n\t\t\t\t\t\t//创建表格\n\t\t\t\t\t\tctrl.viewModel[\"grid_apply\"] =$(\"#grid_apply\").grid({\n\t\t\t\t\t\t\tid: \"grid_apply\",\n\t\t\t\t\t\t\teditable: false, //是否可修改\n\t\t\t\t\t\t\tsortable: false,\n\t\t\t\t\t\t\tshowNumCol: true,\n\t\t\t\t\t\t\tmultiSelect: false,\n\t\t\t\t\t\t\tshowSumRow: false,\n\t\t\t\t\t\t\tshowTree: false,\n\t\t\t\t\t\t\tautoExpand: true,\n\t\t\t\t\t\t\tkeyField: 'id',\n\t\t\t\t\t\t\tparentKeyField: 'pid',\n\t\t\t\t\t\t\tcolumnMenu: false,\n\t\t\t\t\t\t\tcanDrag: true,\n\t\t\t\t\t\t\tcolumns:data.columns\n\t\t\t\t\t\t});\n\t\t\t\t\t\t//加载数据\n\t\t\t\t\t\tif(openBillId == \"\"){\n\t\t\t\t\t\t\treturn;\n\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t$.ajax({\n\t\t\t\t\t\t\t\ttype: 'GET',\n\t\t\t\t\t\t\t\turl: \"/iwebap/jkbx_linkquery_ctr/loadData?queryType=apply&openBillId=\"+openBillId+\"&tradetype=\"+tradetype+\"&time=\"+ new Date().getTime(),\n\t\t\t\t\t\t\t\tdataType: 'json',\n\t\t\t\t\t\t\t\tsuccess: function (data) {\n\t\t\t\t\t\t\t\t\tif(data[\"success\"] == \"true\"){\n\t\t\t\t\t\t\t\t\t\tvar applyValues = {};//借款报销页签\n\t\t\t\t\t\t\t\t\t\tapplyValues.values = data.appValues;\n\t\t\t\t\t\t\t\t\t\tctrl.viewModel[\"grid_apply\"].setDataSource(applyValues);\n\t\t\t\t\t\t\t\t\t\tapplyData = data.appValues;\n\t\t\t\t\t\t\t\t\t\tctrl.setApplyId();\n\t\t\t\t\t\t\t\t\t}else{\n\t\t\t\t\t\t\t\t\t\t$.showMessageDialog({type:\"info\",title:\"提示\",msg: data[\"Msg\"],backdrop:true});\n\t\t\t\t\t\t\t\t\t} \n\t\t\t\t\t\t\t\t}\n\t\t\t\t\t\t\t});\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}else{\n\t\t\t\t\t$.showMessageDialog({type:\"info\",title:\"提示\",msg: data[\"Msg\"],backdrop:true});\n\t\t\t\t} \n\t\t\t}\n\t\t});\n\t}\n\t//注册表格第一个td的click事件\n\tctrl.setJkBxId = function(){\n\t\t$(\"#grid_jkbx_content_tbody\").off(\"click\");//解除click绑定\n\t\tvar head_tr = $(\"#grid_jkbx_header_thead tr th\");//标题字段\n\t\tfor(var index = 0; index < head_tr.length;index++){\n\t\t\tif(head_tr[index].attributes[\"data-filed\"].value == \"djbh\"){\n\t\t\t\tvar index_ = parseInt(index)+1;\n\t\t\t\tvar trs = $(\"#grid_jkbx_content_tbody tr td:nth-child(\"+index_+\")\");\n\t\t\t\tfor(var i = 0;i < billData.length;i++){\n\t\t\t\t\ttrs[i].id = i;\n\t\t\t\t\tvar val = trs[i].children[0].innerText;\n\t\t\t\t\ttrs[i].children[0].innerText = \"\";\n\t\t\t\t\tvar add = document.createElement('a');\n\t\t\t\t\tadd.innerHTML=val;\n\t\t\t\t\ttrs[i].children[0].appendChild(add);\n\t\t\t\t\ttrs[i].onclick = function(){\n\t\t\t\t\t\tvar OpenbillId_pk = billData[this.id].pk_jkbx;\n\t\t\t\t\t\tvar tradetype = billData[this.id].djlxbm;\n\t\t\t\t\t\t$.ajax({\n\t\t\t\t\t\t\ttype:\"POST\",\n\t\t\t\t\t\t\turl:\"/iwebap/jkbx_linkquery_ctr/getUrlById?OpenbillId=\"+OpenbillId_pk+\"&tradetype=\"+tradetype+\"&ts=\"+new Date().getTime(),\n\t\t\t\t\t\t\tdataType:\"json\",\n\t\t\t\t\t\t\tasync:true,\n\t\t\t\t\t\t\tsuccess:function(data){\n\t\t\t\t\t\t\t\twindow.open(data.url);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treturn ;\n\t\t\t}else{\n\t\t\t\tcontinue ;\n\t\t\t}\n\t\t}\n\t}\n\t//注册费用申请单表格第一个td的click事件\n\tctrl.setApplyId = function(){\n\t\t$(\"#grid_apply_content_tbody\").off(\"click\");//解除click绑定\n\t\tvar head_tr = $(\"#grid_apply_header_thead tr th\");//标题字段\n\t\tfor(var index = 0; index < head_tr.length;index++){\n\t\t\tif(head_tr[index].attributes[\"data-filed\"].value == \"billno\"){\n\t\t\t\tvar index_ = parseInt(index)+1;\n\t\t\t\tvar trs = $(\"#grid_apply_content_tbody tr td:nth-child(\"+index_+\")\");\n\t\t\t\tfor(var i = 0;i < applyData.length;i++){\n\t\t\t\t\ttrs[i].id = i;\n\t\t\t\t\tvar val = trs[i].children[0].innerText;\n\t\t\t\t\ttrs[i].children[0].innerText = \"\";\n\t\t\t\t\tvar add = document.createElement('a');\n\t\t\t\t\tadd.innerHTML=val;\n\t\t\t\t\ttrs[i].children[0].appendChild(add);\n\t\t\t\t\ttrs[i].onclick = function(){\n\t\t\t\t\t\tvar OpenbillId_pk = applyData[this.id].pk_mtapp_bill;\n\t\t\t\t\t\tvar tradetype = applyData[this.id].pk_tradetype;\n\t\t\t\t\t\t$.ajax({\n\t\t\t\t\t\t\ttype:\"POST\",\n\t\t\t\t\t\t\turl:\"/iwebap/jkbx_linkquery_ctr/getUrlById?OpenbillId=\"+OpenbillId_pk+\"&tradetype=\"+tradetype+\"&ts=\"+new Date().getTime(),\n\t\t\t\t\t\t\tdataType:\"json\",\n\t\t\t\t\t\t\tasync:true,\n\t\t\t\t\t\t\tsuccess:function(data){\n\t\t\t\t\t\t\t\twindow.open(data.url);\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t});\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\treturn ;\n\t\t\t}else{\n\t\t\t\tcontinue ;\n\t\t\t}\n\t\t}\n\t}\n\n\tctrl.lianchaShow = function(index){\n\t\t$(\".tab_css\").each(function(i){\n\t\tif(index == i){\n\t\t  $(\".tab_css\")[i].style.display = \"block\";\n\t\t  $('#tab_bar ul li').removeClass('active');\n\t\t  $('.'+this.id).addClass('active');\n\t\t  if(i===0){\n\t\t  \tctrl.loadJKBX(ctrl.tradetype,ctrl.openBillId);\n\t\t  }else if(i===1){\n\t\t  \tctrl.loadYS(ctrl.tradetype,ctrl.openBillId);\n\t\t  }else if(i===2){\n\t\t  \tctrl.loadPZ(ctrl.tradetype,ctrl.openBillId);\n\t\t  }else if(i===3){\n\t\t  \tctrl.loadApply(\"2611_\"+ctrl.tradetype,ctrl.openBillId); \n\t\t  }\n\t\t}else{\n\t\t  $(\".tab_css\")[i].style.display = \"none\"; \n\t\t} \n\t\t});\n\t}\n\tctrl.getFormatNumber = function(obj){\n\t\tif(obj == null || obj == '' || obj == undefined){\n\t\t\treturn;\n\t\t}\n\t\tvar maskerMeta = iweb.Core.getMaskerMeta('float') || {};\n\t\tmaskerMeta.precision = new BigNumber(obj).precision(); \n\t\tvar formater = new u.NumberFormater(obj.substr(obj.indexOf(\".\") + 1,obj.length ).length); \n\t\tvar masker = new u.NumberMasker(maskerMeta); \n\t\tvar svalue = masker.format(formater.format(obj)).value \n\t\treturn svalue;\n\t} \n\treturn ctrl;\n});\n\n\n"
          },
