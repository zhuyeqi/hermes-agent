            "mimeType": "text/plain",
            "text": "define(['jquery', 'knockout','compevent','/iwebap/erm/js/commonctrl.js','/iwebap/js/BillFormActionUtils.js',\"u.biz\"], function($, ko, compevent,commonctrl) {\n\tvar templateName = decodeURIComponent(getRequest().templateName);\n\twindow.title = templateName;\n\tdocument.title = templateName;\n\t$(\".panel-title\").html(templateName);\n\tvar myControllerFunction = function(){};\n\tmyControllerFunction.prototype = commonctrl;\n\tvar myController = new myControllerFunction();\n\t//节点级ViewModel，可注册节点级按钮\n\tvar funcViewModel = {\n\t\tmainOrg : new $.DataTable({\t\n\t\t\t\tparams:{\n    \t\t\t\t\"tabtype\":\"head\",\n    \t\t\t\t\"cls\":\"nc.vo.erm.BXBillVO\"\n    \t\t\t},meta:{\n\t\t\t\t\t'pk_org':{ \n\t\t\t\t\t\tlabel:'财务组织', \n\t\t\t\t\t\trequired:true, \n\t\t\t\t\t\trefmodel:'{\"refUIType\":\"RefTree\",\"rootName\":\"\\u8D22\\u52A1\\u7EC4\\u7EC7\",\"refName\":\"\\u8D22\\u52A1\\u7EC4\\u7EC7\"}'\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}),\n\t\theadButtongroups:ko.observableArray([]),\n\t\tadd:myController.add,\n\t\tedit:myController.edit,\n\t\tcopy:myController.copy,\n\t\tdel:myController.del,\n\t\tprint:myController.print,\n\t\taccessory:myController.accessory,\n\t\tdzfpaccessory:myController.dzfpaccessory,\n\t\timageupload:myController.imageupload,\n\t\timageshow:myController.imageshow,\n\t\tsave:myController.save,\n\t\tcancel:myController.cancel,\n\t\tsubmitBottom:myController.submitBottom,\n\t\tsubmit:myController.submit,\n\t\tunsendapprove:myController.unsendapprove,\n\t\tcjk:myController.cjk,\n\t    isEditable: ko.observable(false)// viewModel上加页面状态                \n\t};\n\tmyController.draw = function(v_pub_billform){\n\t\tmyController.setupapp(funcViewModel,v_pub_billform);\n\t}\n\t\n\tmyController.extendViewModel = function(viewModel, app, preProcessInfo){\n\t\tcommonctrl.mainOrg = myController.mainOrg;\n\t\tcommonctrl.extendViewModel(viewModel, app, preProcessInfo);\n\t}\n\treturn myController;\n});"
