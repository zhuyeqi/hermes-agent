            "text": ".body{\n\tfont-family: 'Microsoft YaHei',arial;\n\tfont-size: 14px;\n\tline-height: 1.5;\n\tcolor: #6f7b8a;\n\tbackground-color: #fff;\n}\n.billitem{\n\tmargin-right:17px;\n\tposition: relative;\n\twidth:306px;\n\tmin-width: 306px;\n    max-width: 330px;\n}\n\n.billitem-label{\n\twidth: 98px;\n    text-align: right;\n\tpadding-left:0;\n\theight:28px;\n\tvertical-align: middle;\n}\n\n.billitem .Validform_checktip {\n\tposition: absolute;\n\tleft: -12px;\n\ttop: 5px;\n\tz-index: 2;\n}\n\n.billitem-checkbox {\n\tvertical-align:middle;\n\tmargin-left: 105px;\n\twidth:192px !important;\n\theight: 28px;\n}\n\n.billitem-checkbox .billitem-label-content {\n    width: 175px !important;\n    padding-left: 27px;\n}\n\n.billitem-checkbox input{\n\tdisplay: table-cell;\n    margin: 0;\n    height: 28px;\n}\n\n.billitem-checkbox label {\n\ttext-align:left;\n\tmargin-left:10px;\n}\n\n.billitem [type=text]{\n\tpadding-top:2px;\n\tpadding-bottom:2px;\n\tpadding-right:0px;\n\t/*min-height: 30px;*/\n\theight:30px;\n}\n\n.billitem .divinput{\n\theight: 30px!important;\n\tline-height: 30px;\n\tpadding: 0 5px;\n\tborder:1px solid #e5e9ec;\n\tposition: relative;\n\tborder-radius: 4px;\n\toverflow: hidden;\n\tdisplay: inline-block;\n\t\n}\n\n.billitem textarea {\n\theight: 40px;\n}\n\n.selected-div-error .Validform_checktip {\n\tmargin-left: 8px;\n\tline-height: 30px;\n\theight: 30px;\n\toverflow: hidden;\n\tcolor: red;\n\tfont-size: 12px;\n\tposition: absolute;\n\ttop: -35px;\n\tleft: 49px;\n\tz-index: 2;\n\tbackground-color: #fff;\n}\n\n.selected-div-error .valid-arrow-bottom {\n\tdisplay: none;\n\tposition: absolute;\n\tz-index: 2;\n\twidth: 0;\n\theight: 0;\n\ttop: -6px;\n\tleft: 119px;\n\tborder: 6px solid red;\n\tborder-right-color: transparent;\n\tborder-left-color: transparent;\n\tborder-bottom-color: transparent;\n}\n\n.grid-title .billcardactions {\n\tmargin-top: 0 !important;\n\tfloat: right;\n}\n\n.grid-title .billcardactions .pagination {\n\tmargin: 0;\n}\n\n.form-inline {\n\tpadding: 25px 0px 15px 40px;\n}\n\n.form-inline:hover {\n\t/*border: 1px solid #8cb6ed;*/\n}\n\n.billitem-textarea {\n\tdislay:block;\n}\n\n.form-inline > fieldset.billitem, .form-readonly-item {\n\twidth: 300px;\n\tmax-width:300px;\n\tmin-width:300px;\n}\n\n.form-readonly-item.receipt-details {\n\t  width: 292px;\n\t  max-width:292px;\n\t  min-width:292px;\n\t}\n\n@media (min-width: 380px) {\n\t.form-inline > fieldset.billitem.billitem-textarea {\n\t\twidth: 271px;\n\t\tmax-width: 271px;\n\t\tmin-width: 271px;\n\t}\n}\n\n@media (min-width: 785px) {\n\t.form-inline > fieldset.billitem.billitem-textarea {\n\t\twidth: 559px;\n\t\tmax-width: 559px;\n\t\tmin-width: 559px;\n\t}\n}\n\n@media (min-width: 992px) {\n\t.form-inline > fieldset.billitem.billitem-textarea {\n\t\twidth: 848px;\n\t\tmax-width: 848px;\n\t\tmin-width: 848px;\n\t}\n}\n\n@media (min-width: 1345px) {\n\t.form-inline > fieldset.billitem.billitem-textarea {\n\t\twidth: 1136px;\n\t\tmax-width: 1136px;\n\t\tmin-width: 1136px;\n\t}\n}\n\n@media (min-width: 1700px) {\n\t.form-inline > fieldset.billitem.billitem-textarea {\n\t\twidth: 1420px;\n\t\tmax-width: 1420px;\n\t\tmin-width: 1420px;\n\t}\n}\n\n.item-ta-wrap {\n\tmargin-left:99px;\n}\n\n.item-ta-wrap .form-control{\n\twidth:100%;\n}\n\n.item-ta-lab-wrap {\n\tfloat:left;\n}\n\n.form-readonly-item.receipt-details .form-readonly-label {\n\twidth: 111px !important;\n\tdisplay: table-cell;\n\theight: 28px;\n\tline-height: 14px;\n\ttext-align: right;\n\tvertical-align: middle;\n\tcolor: #595959;\n}\n.form-readonly-item.receipt-details .form-readonly-label:after{\n\tcontent: ':';\n}\n\n.form-readonly-item.receipt-details .form-readonly-content {\n\twidth: 196px !important;\n\tmax-width: 196px;\n\tpadding-left: 18px;\n\tdisplay: table-cell;\n\tfont-weight: normal;\n\theight: 28px;\n\tline-height: 14px;\n\tvertical-align: middle;\n\twhite-space: normal;\n    word-wrap: break-word;\n\tword-break:break-all;\n}\n\n.form-readonly-item {\n\tmargin-bottom: 0px;\n\tdisplay: inline-block;\n}\n\nfieldset.billitem.form-group {\n    margin-bottom: 10px;\n}\n\nfieldset.billitem > input.form-control, fieldset.billitem > div.divinput, fieldset.billitem > div.select-input, fieldset.billitem > .form_date, fieldset.billitem > .billitem-checkbox {\n\twidth:175px;\n\tmargin-left: 10px;\n}\n/*begin业务主组织*/\n.mainorgpanel > fieldset.billitem > div.form_date {\n\twidth: 350px;\n}\n.mainorgpanel .form-group .input-group .input-group-addon {\n\twidth: 13px;\n}\n/*end业务主组织*/\n\n.billitem {\n   margin-right: 0;\n}\n\n.billitem a{\n\tfloat: right;\n\tmargin-left: 10px;\n\twidth: 175px !important;\n\tcursor: pointer;\n\tfont-size: 12px;\n\tpadding-top: 5px;\n\tpadding-bottom: 5px;\n}\n\n\n.btn-select {\n  padding: 3px 10px !important;\n  color:#c9c9c9;\n}\n\n.billitem .input-group-addon:hover,.billitem .btn-select:hover {\n  color:#00b5f4;\n}\n\n.billitem input[type=text],.billitem div.form-control {\n  height:28px;\n}\n\ndiv.input-group.date.form_date .form-control{\n\tpadding-right: 0;\n\tborder-top-left-radius: 5px;\n\tborder-bottom-left-radius: 5px;\n}\n\n.billitem div.form-control {\n\twidth:141px !important;\n}\n\n.form-readonly {\n  padding-top: 25px;\n  padding-bottom: 15px;\n}\n\n.billitem .input-group-addon {\n\t  background: #fff;\n\t  border-radius: 5px;\n\t  border-bottom-left-radius: 0 !important;\n\t  border-top-left-radius: 0 !important;\n\t  border: 1px solid #c9c9c9;\n\t  border-left:none;\n\t  padding: 3px 10px;\n\t  color:#c9c9c9;\n}\n\n.billitem .form-control {\n  border: 1px solid #c9c9c9;\n  -webkit-box-shadow:none;\n  box-shadow:none;\n  -webkit-transition:none;\n  transition:none;\n  \n}\n\nfieldset > .input-group > .form-control {\n\tborder-right:none;\n}\n\n\n.billitem label {\n  margin-bottom: 0;\n  font-weight: 400;\n}\n\n\nfieldset.billitem > .select-input {\n\t  height: 28px !important;\n}\n\nfieldset.billitem > .btn-select {\n  height: 28px;\n  width: 35px;\n  border-bottom-left-radius: 0;\n  border-top-left-radius: 0;\n  background-color: #fff;\n  padding: 3px 10px;\n  font-size: 14px;\n    color: #9EA9B2;\n    border-left:none;\n}\n\n\n\n\n.input-group-addon > .fa.fa-angle-down,.btn-select > .fa.fa-angle-down{\n\tfont-size:20px;\n}\n\n.billitem .form-control:focus,.input-group.form_date.focus input.form-control{\n\tborder-color:#00b5f4;\n}\n.form-control:focus +.input-group-addon,.input-group.form_date.focus .input-group-addon,.form-control.focus + .input-group-addon{\n\tborder-color:#00b5f4 !important;\n\tcolor:#00b5f4 !important;\n}\n.input-group.form_date.focus,.u-grid-edit-div.focus,u-grid-content-td-div.focus{\n\t-webkit-box-shadow: inset 0 1px 1px rgba(0,0,0,.075),0 0 8px rgba(0,181,244,.6) !important;\n\tbox-shadow: inset 0 1px 1px rgba(0,0,0,.075),0 0 8px rgba(0,181,244,.6) !important;\n}\ninput.form-control.focus{\n\t-webkit-box-shadow: inset 0 1px 1px rgba(0,0,0,.075),0 0 8px rgba(0,181,244,.6) !important;\n    box-shadow: inset 0 1px 1px rgba(0,0,0,.075),0 0 8px rgba(0,181,244,.6) !important;\n    border-color:#00b5f4;\n}\ndiv.form-control.focus,.u-grid-content-td-div.focus .u-grid-edit-item-date .form-control{\n\tborder-color:#00b5f4;\n}\n\n\n.billitem .divinput {\n\tborder-color:#c9c9c9;\n}\n.btn-select:hover, .btn-select:focus{\n\tborder-color:#00b5f4;\n}\n\n.billitem-number .form-control {\n\ttext-align: right;\n}\n.form-readonly .billitem .form-control{\n\tborder:none !important;\n\tbackground-color:#f4f9ff !important;\n}\n.form-readonly .form-group  input {\n\tborder:none !important;\n\tbackground-color:#f4f9ff !important;\n}\n\n.form-readonly .input-group-addon {\n\tvisibility:hidden;\n\tdisplay:none;\n}\n\n.form-control {\n\tdisplay:inline-block;\n}\n\n.input-group {\n\tdisplay:inline-table;\n}\n\ninput[datatype=\"f\"] {\n\ttext-align: right;\n}\n\n\n\n.billitem > .item-ta-wrap > textarea.form-control {\n\theight: 56px;\n}\n\n.form-readonly > .billitem  textarea.form-control {\n\tresize: none;\n}\n\n.head-more {\n\tmargin-top:20px;\n}\n\n.billitem .input-group div.form-control {\n\tline-height: 24px;\n}\n\n.billitem .form-control {\n\tpadding-left: 7px;\n\tpadding-right: 7px;\n}\n\n.billitem-label-content {\n\tdisplay: table-cell;\n    height: 28px;\n    vertical-align: middle;\n    width: 98px;\n    line-height: 14px;\n}\n\n.form-readonly .billitem-mustFlag {\n\tdisplay: none;\n}\n\n.billitem .form-readonly-content{\n\twidth: 175px;\n\theight: 28px;\n\tmargin-left: 10px;\t\n\tfont-size: 12px;\n  \tvertical-align: middle;\n  \tpadding: 5px 10px;\n  \tline-height: 20px;\n \tdisplay: inline-block;\n}\n\n.disablecover .checkbox label:before, .disablecover.checkbox label:before{\n\tbackground-color: #dedede;\n}\n\n.checkbox label:before {\n\ttop:0;\n}\n\n.billitem-checkbox .check-success{\n\tposition: absolute;\n  \tmargin-top: 4px;\n}\n\n.billitem-mustFlag {\n    position: absolute;\n    top: 10px;\n    left: 101px;\n}\n\n\n.billbodyoper{\n\ttext-align: center;\n\tdisplay: inline-block;\n\tpadding: 0px;\n\tline-height: 30px;\n\tcursor: pointer;\n\tcolor: #fff;\n\tmargin: 0 10px;\n\twidth: auto !important;\n\tvertical-align: sub;\n}\n\n\n.billitem .table-condensed a{\n\tfloat:none;\n\tmargin-left: 0px;\n}\n.bootstrap-datetimepicker-widget .picker-switch td span{\n\twidth: 95%;\n}\n.u-grid-header-th{\n\tborder: 0\n}\n.u-grid-header-num{\n\tborder: 0;\n}\n\n\n\n/******************************* 响应式布局 *******************************/\n@media (min-width: 768px) and (max-width: 1081px) {\n    fieldset.form-group, .form-inline fieldset.form-group, div.u-grid-edit-whole-div, .form-view-show .form-readonly-item, .form-readonly-item.receipt-details {\n        min-width: 48%;\n    }\n    .u-grid-edit-whole-div {\n    \twidth: 303px;\n    }\n    .form-readonly-item.receipt-details {\n    \twidth: 290px;\n    }\n}\n@media (min-width: 1082px) and (max-width: 1421px) {\n    fieldset.form-group, .form-inline fieldset.form-group, div.u-grid-edit-whole-div, .form-view-show .form-readonly-item, .form-readonly-item.receipt-