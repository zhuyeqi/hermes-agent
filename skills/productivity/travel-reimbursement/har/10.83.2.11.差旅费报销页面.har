            "mimeType": "application/x-javascript",
            "text": "window.refDList = function(options) {\n    //var init = function (refer) {\n        var $dom = options.dom;\n\t\tvar refInput = options.refInput || options['searchInput'] || $dom.find(\"input\");\n\t\tvar refIcon  = $dom.find(\".input-group-addon\");\n        var contentId = options.contentId;\n        var refContainer='#'+contentId.replace(/[^\\w\\s]/gi, '\\\\$&');\n        if($('#'+contentId).length=== 0){\n\t\t\t$('body').append($('<div>').attr('id',contentId));\n\t\t}        \n        var $contentEle = $('#'+contentId);\n\t\ttry{\n        var refmodel = JSON.parse($dom.attr('data-refmodel'));\n        var isNotLeafSelected=true;\n\n        \tif('isNotLeafSelected' in refmodel){\n\t        \tisNotLeafSelected = refmodel['isNotLeafSelected'];\n\t        }\n        }catch(e){}\n        \n        // console.log(JSON.parse($dom.attr('data-refmodel')));\n    \tvar ref=$(refContainer).Refer({\n\t\t\tctx:window.ctx,\n\t\t\tdataOfdom:$dom,\n\t\t\twrapRefer:{\n\t\t\t\tsetVal:options.setVal,\n\t\t\t\tdialog:null,\n\t\t\t\tcontentEle:$contentEle,   //options.$contentEle,//参照容器的el\n\t\t\t\tcontentId:contentId,//参照的id\n\t\t\t\t//isPOPMode:refer.options.isPOPMode\n\t\t\t},\n\t\t\trefIcon:refIcon,\n\t\t\trefInput:refInput,\n\t\t\tisNotLeafSelected:isNotLeafSelected\n\t\t});\n        \n//        refer.registerSubmitFunc(function () {\n//            return $(refContainer).Refer('getSelections',true);\n//        })\n}\n//    return {\n//        template: '',\n//        init: init\n//    }\n//})\n\n"
