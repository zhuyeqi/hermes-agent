            "text": "html,body {\n\theight:100%;\n}\n\nbody{\n\tfont-family: 'Microsoft YaHei',arial;\n\tfont-size: 14px;\n\tline-height: 1.5;\n\tcolor: #464646;\n\tbackground-color: #fff;\n}\n\n.head_top{\n\tpadding:10px 0;\n}\n\n.bill-tab>li>a {\n  padding: 0;\n}\n\n.bill-tab>li {\n\tpadding:0 15px;\n}\n\n.bill-tab>li {\n\tborder-right:solid 1px #cdcdcd;\n\tpadding-right:15px;\n}\n\n.bill-tab>:last-child {\n\tborder-right:none;\n}\n\n/*.grid.simple {\n\t  padding: 5px !important;\n}*/\n.grid.simple .body_tab{\n\n}\n.billrow .grid.simple {\n\t  padding: 0 !important;\n\t  position: relative;\n}\n\n.grid.simple .grid-title .tools {\n  margin-right: 10px;\n}\n\n.bill-tab > li > a {\n\tbackground:none !important;\n\tborder:solid 1px #cdcdcd;\n\tcolor:#cdcdcd;\n}\n\n.bill-tab>li.active>a {\n\tcolor:#87ceeb !important;\n\tborder:solid 1px #3ccef9;\n}\n\n.bill-tab>li>a {\n  border-radius: 0;\n}\n\nbody {  \n   background-image: -webkit-linear-gradient(top, #fff, #e4e4e4 580px);  // Safari 5.1-6, Chrome 10+\n\tbackground-image: -o-linear-gradient(top, #fff, #e4e4e4 580px);  // Opera 12\n    background-image: linear-gradient(to bottom, #fff, #e4e4e4 580px); // Standard, IE10, Firefox 16+, Opera 12.10+, Safari 7+, Chrome 26+\n    background-repeat: repeat-x;\n    background-attachment:fixed;\n}\n\nbody > .container {\n\twidth: 90%;\n\theight:100%;\n\tpadding:0;\n}\n\n.panel-success {\n  border: none;\n}\n\n.tab-content>.active, .pill-content>.active {\n  padding: 0;\n}\n\n.tab-content>.tab-pane, .pill-content>.pill-pane {\n  padding: 0;\n}\n\n.row.submit-container{\n\tpadding-left:15px; \n}\n\n.row-submit {\n\t/*padding: 0 20px;*/\n    margin-top: 25px;\n\tbackground-color: #e8f7fd;\n\tfont-size: 16px;\n\tline-height: 50px;\n}\n\n.row-submit-fixed {\n\tposition:fixed;\n\tbottom:0;\n\tz-index:50;\n\twidth:90%;\n}\n\n\n\n.grid {\n  margin-bottom: 0;\n}\n\n.panel-body {\n  padding: 0 0;\n}\n\n\n\n.panel > .panel-heading > .btn-toolbar {\n\tmargin: 4px 0;\n}\n\n.panel > .panel-heading > .btn-toolbar > .btn-group > a{\n\tfont-size: 16px;\n\tcolor: #fff;\n\tcursor: pointer;\n\tpadding-left:20px;\n}\n\n.savebutton, #body_edit_action .btn-danger, #body_edit_action .btn-success {\n  height: 28px;\n  margin-left: 203px !important;\n  width: 80px !important;\n  float: none !important;\n  padding:0 !important;\n}\n\n.row-submit > .btn-danger {\n  color: #666666;\n  background-color: #f5f5f5;\n  font-weight: normal;\n}\n\n.row-submit > .btn-danger:hover {\n  color: #fff;\n  background-color: #fe7858;\n   font-weight: bold;\n}\n\n#body_edit_action .btn-successadd {\n\theight: 28px;\n\tmargin-left: 10px!important;\n\tbackground-color: white;\n\tborder-color: #bfbfbf;\n\tcolor: #01a3f6;\n\twidth: 80px !important;\n  \tfloat: none !important;\n  \tpadding:0 !important;\n}\n\n\n#body_edit_action .btn-dangeradd:hover,#body_edit_action .btn-successadd:hover {\n\tbackground-color: #f6f7f9;\n}\n\n.u-grid .u-grid-content-sel-row{\n\tcolor: #666666 !important;\n\tbackground-color:#FFF8EE !important;\n}\n/*.u-grid-content tbody tr:nth-child(even){\n\tbackground-color:#fafafa;\n}\n\n.u-grid-content-num:nth-child(even){\n\tbackground-color:#fafafa;\n}*/\n\n\n\n\n.panel-heading {\n\t  padding: 10px 18px;\n}\n.panel-title {\n\tposition: relative;\n    font-size: 18px;\n    font-family: 'Microsoft YaHei',arial;\n    margin-left: 10px;\n    bottom: 3px;\n}\n\n.panel-heading .fa-th-large{\n\tvertical-align:initial;\n\tfont-size:14px;\n\tcolor:#87cfea;\n}\n\n.grid.simple .grid-title {\n\tborder: none;\n\tpadding-left: 18px;\n\tposition:relative;\n\tmargin: 10px 0;\n}\n.body_tab{\n\t\n    position: absolute;\n    bottom: 5px;\n    right: 0px;\n\n}\n\n\n.label-left-em {\n  border-left: 5px solid #4bb6f0!important;\n  padding-left: 15px!important;\n}\n\n.grid.simple .grid-body {\n  padding: 0;\n   background-color: #f9f9fa;\n}\n.grid-body input{\n\tfont-size: 14px !important;\n\tfont-family: 'Microsoft Yahei',Arial !important;\n}\n.grid-body .input-group.date.form_date div{\n\tfont-size: 14px !important;\n\tfont-family: 'Microsoft Yahei',Arial !important;\n}\n.panel-success>.panel-heading {\n\tcolor: #464646;\n\tbackground-color: #e8f7fd;\n\tborder-color: #e8f7fd;\n}\n\n.grid-title .tools, .grid-title .actions {\ndisplay: inline-block;\npadding: 0;\nmargin: 0;\nmargin-bottom: -8px;\nfloat: right;\n}\n\n\n.grid.simple .grid-title .left{\n\tfloat:left;\n\tpadding-top:5px;\n\twidth:30%;\n}\n.grid-title h4 {\n\tfont-size: 16px;\n\tmargin: 0;\n\tpadding: 0;\n\twidth: 60%;\n\twhite-space: nowrap;\n\toverflow: hidden;\n\ttext-overflow: ellipsis;\n}\n.u-grid-grid table {\n    background-color: transparent;\n    table-layout: fixed;\n}\n.u-grid table>tbody> tr> td.oper_td> .u-grid-content-td-div > a{\n\t\n\ttext-align: center;\n\tdisplay: inline-block;\n\tpadding: 0px;\n\tline-height: 30px;\n\tfont-size: 16px;\n\tcursor: pointer;\n\tcolor: #fff;\n\tmargin: 0 10px;\n\twidth: auto !important;\n\tvertical-align: sub;\n\t\n}\n.u-grid .u-grid-header{\n\theight: 40px;\n\tborder-width: 1px;\n}\n\n.u-grid-header {\n\tborder-width: 1px;\n\tbackground-color: #f8fdff;\n}\n\n.u-grid .u-grid-header .u-grid-header-th{\n\theight: 40px;\n\tborder: 0;\n\tvertical-align:middle;\n\n}\n\n/*.u-grid .u-grid-header .u-grid-header-th:before{\n\tcontent: \"|\";\n\tcolor: #c2c0c0;\n\tfloat: left;\n}*/\n\n/*siyunlong+*/\n.row-fluid .u-grid-grid .u-grid-header .u-grid-header-th:before{\n\tcontent: \"|\";\n\tcolor: #c2c0c0;\n\tfloat: left;\n\tposition: relative;\n\ttop:9px;\n}\n\n.u-grid-header-th-first:before{\n\tcontent: \"\" !important;\n}\n.u-grid td{\n\theight: 44px;\n\tborder: 0;\n\ttext-align: center;\n\tborder-bottom: 1px solid #e5e5e5;\n}\n.u-grid table>tbody> tr> td.oper_td> div> span> a .fa{\n\tposition: relative;\n\tbottom: 3px;\n}\n\n.u-grid table> tbody > tr > td.oper_td{\n\tpadding:0;\n\twidth:100%;\n}\n\n.u-grid table> tbody > tr > td.oper_td > div{\n  float: right;\n  text-right:right;\n  height:40px;\n\n}\n.u-grid table> tbody > tr > td.oper_td > div img{\n  vertical-align: top;\n \n}\n.u-grid .u-grid-header-link{\n    border-right: 1px solid #c2c0c0;\n\tfont-size:14px;\n\tfont-weight: normal;\n\tcolor:#464646;\n\theight: inherit;\n    line-height: inherit;\n}\n\n.oper_td > .u-grid-content-td-div > span {\n\tdisplay:block;\n\theight:100%;\n\tline-height: 40px;\n\toverflow: visible;\n}\n.oper_td > .u-grid-content-td-div{\n\tposition:relative;\n\toverflow:visible;\n}\n.oper_td > .u-grid-content-td-div > span >  a{\n\tline-height: 16px;\n\tdisplay: block;\n    margin-top: 10px;\n}\n\n/********************* siyl 详细信息只读环境下的编辑删除等按钮绝对定位 ************************/\n.bill-grid-detail .oper_td > .u-grid-content-td-div {\n\tposition: absolute;\n\tright: 0px;\n\toverflow: visible;\n\ttop:5px;\n}\n\n.preline:before {\n\tcontent:'|';\n\tfont-size:14px;\n\tpadding-right: 9px;\n}\n\n.panel-heading>.btn-group>.btn:first-child:before {\n\tcontent:none;\n}\n.panel-heading>.btn-group{\n\tfloat:right;\n\tpadding-right:4px;\n\tmargin-top:5px;\n}\n.row-submit .btn-primary{\n\tbackground-color:#4bb6f0;\n}\n.backtop{\n\tfont-size:14px !important;\n\tword-wrap: break-word;\n\tright: 0;\n\tbottom: 50px;\n\tz-index: 9999999999;\n\tposition:fixed;\n}\n\n.backtop > a {\n\twidth: 50px !important;\n\theight: 50px !important;\n\ttext-decoration:none;\n\t\n\tmargin:11px;\n}\n.backtop > .to-top{\n line-height:20px !important; \n background: url(/iwebap/css/img/up.png)\n}\n\n.backtop > .to-top:hover {\n background: url(/iwebap/css/img/up_hover.png)\n}\n\n\n.backtop > .v-center{\n\tline-height: 41px !important; \n}\n\n.col-md-12 > .btn-group >.btn:first-child{\n\tmargin-left:8px;\n}\n\n.bill-tab > li {\n\tdisplay:inline-block !important;\n\twidth:auto !important;\n}\n\n.bill-tab > li > a,.bill-tab > li:hover > a {\n\tborder: none !important;\n\tborder-radius: 0 !important;\n\tbackground:none !important;\n\t\n}\n\n.bill-tab > li > a{\n\tcolor: #4C4C4C;\n}\n\n.bill-tab > li:first-child > a {\n\tborder-left:none !important;\n}\n\n.bill-tab > li.active > a, .bill-tab > li:hover > a, .bill-tab > li:hover.active > a {\n\tcolor:#01A3F6 !important;\n\tfont-weight:bold;\n}\n\n.tab-readonly>.bill-tab > li.active > a, .tab-readonly>.bill-tab > li:hover > a, .tab-readonly>.bill-tab > li:hover.active > a {\n\tcolor:#fff !important;\n}\n\n.u-grid {\n\tfont-family: 'Microsoft Yahei',Arial !important;\n\tborder: none !important;\n\tcolor: #464646;\n}\n\n.u-grid-header-link {\n\tcolor: #666;\n\tfont-weight:normal;\n\t\n}\n\n.u-grid-header-sort-span {\n\t  right: 1.9em;\n}\n\n.u-grid-header-sort-priority {\n\t\tfont-size:10px !important;\n}\n\n.u-grid-edit-form {\n\tbackground-color: #f6f7f9;\n\tpadding: 25px 0 15px 10px;\n  \tbox-sizing: border-box;\n\t/*border-bottom: 1px solid #E5E5E5;*/\n\tfont-size: 14px;\n}\n.u-grid-edit-form .grid-combox{\n\tborder-right:none;\n\tbox-shadow: none;\n}\n\n.u-grid-edit-form .input-group-addon{\n\tbackground-color:#fff;\n}\n\n.u-grid-content-edit-menu-button-ok {\n  \n}\n.u-grid-edit-label {\n\theight: 30px;\n\tfont-weight: 400;\n\twhite-space: normal;\n\twidth: 96px;\n}\n\n.u-grid-content-edit-menu {\n background: none; \n top: initial !important;\n}\n\n.u-grid-edit-div > .u-grid-content-td-div {\n\tline-height:0 !important;\n\theight: 28px;\n\tfont-size:12px;\n\t}\n\n\n.u-grid-edit-div .form-control {\n    font-size: 12px;\n    height: 28px;\n\tline-height:1 !important;\n}\n\n\n\n\n.billitem-checkbox {\n\tfloat:right;\n}\n.billitem-checkbox input[type=checkbox]{\n\tposition:absolute;\n\tright:165px;\n}\n\n.covershade{\n \n position:absolute;\n top:0;\n left:0;\n width:100%;\n height:100%;\n display:block;\n background-color: #dedede;\n z-index: 10;\n opacity: 0;\n filter:alpha(opacity=20);\n}\n\n.disablecover > .form-control, .disablecover > input, .disablecover > .input-group-addon, .disablecover + .input-group-addon{\n    background-color: #dedede !important;\n}\n\n.text-summoney {\n\tfont-family:'Microsoft YaHei',arial;\n\tfont-size:18px;\n\tcolor:#f9a472;\n}\n.text-count {\n\tcolor:#3b83e1;\n}\n\n.grid-title .label-left-em > span {\n\tmargin-left:25px;\n}\n.u-grid-content-edit-menu-button{\n\twidth: 118px;\n\tfont-size: 16px;\n}\n\n.u-grid-content-edit-menu-button-cancel {\n\tmargin-left: -170px;\n\tcolor: #464646;\n\tright: 196px\n}\n\n.u-grid-edit-div > .input-group > .input-group-addon {\n\tpadding:3px 10px;\n\tbackground-color: #fff;\n}\n\n.u-grid-edit-div input:focus {\n\tborder-color:#c9c9c9;\n    -webkit-box-shadow: none;\n    box-shadow: none;\n    -webkit-transition: none;\n    transition: none;\n    outline: none;\n}\n\n.u-grid-edit-div input[type=text] {\n\tpadding-left: 8px;\n    padding-right: 8px;\n}\n.u-grid-edit-div input[type=text]:focus {\n\tborder-color: #00b9f4\n}\n\n.u-grid-noRowsShowDiv {\n\ttop: 0;\n}\n\n\n.input-group-addon {\n\tcolor: #c9c9c9;\n}\n\n.input-group-addon:hover {\n\tcolor: #00b5f4;\n}\n\n.u-grid-header-left{\n\theight:38px;\n\tbackground-color: #f8fdff;\n}\n.u-grid-header-multi-select{\n\theight:100%;\n\tborder: 0;\n}\n.u-grid-header-multi-select input[type=checkbox]{\n\t\n}\n.u-grid-header-num{\n\tborder: 0;\n}\n.u-grid-content-multiSelect{\n\n\theight:44px;\n\tborder:0;\n}\n.u-grid-content-multiSelect:nth-child(even){\n\t /*background-color:#fafafa;*/\n}\n.u-grid-content-focus-row{\n\tbackground-color: #edf9fd !important;\n\tcolor:#666  !important;\n}\n\n.u-grid-content-multiSelect input[type=checkbox]{\n\t\n}\n.u-grid-header-multi-select.checkbox{\n\tline-height: 36px;\n}\n.u-grid-content-multiSelect.checkbox{\n\tline-height: 33px;\n\tborder-bottom: 1px solid #e5e5e5;\n}\n.u-grid-content-left > .u-grid-content-num {\n    border-bottom: 1px solid #e5e5e5;\n}\n.u-grid .u-grid-content-num.u-grid-content-move-whole-row:hover {\n    border-left: none;\n}\n.u-grid-header-multi-select.checkbox label{\n\ttop: 3px;\n\tleft: 2px;\n}\n.u-grid-content-multiSelect.checkbox label{\n\ttop: 4px;\n\tleft: 2px;\n}\n\n.hover_box{\n\tposition: fixed;\n\tz-index: 99999999;\n\tdisplay:none;\n}\n.more_detail{\n\tborder: 1px solid #c9c9c9;\n\tposition: relative;\n\ttop: 6px;\n\tpadding: 0px;\n\t\n\tlist-style: none;\n\t\n\t\n\t\n\t\n}\n.more_detail:before {\n    content: \"\";\n    display: block;\n\tborder: 6px solid transparent;\n\t\n\tborder-bottom-color: #c9c9c9;\n\twidth: 10px;\n\tposition: absolute;\n\ttop: -12px;\n\tleft: 55px;\n\theight: 10px;\n\n}\n.more_detail:after {\n    content: \"\";\n    display: block;\n\tborder: 6px solid transparent;\n\t\n\tborder-bottom-color: #fff;\n\twidth: 10px;\n\tposition: absolute;\n\ttop: -11px;\n\tleft: 55px;\n\theight: 10px;\n\n}\n.more_detail li{\n\theight:38px;\n\tline-height:38px;\n\tpadding:0px 50px 0px 20px;\n\tbackground:#fff;\n}\n.more_detail li a{\n\tfont-size:12px;\n\tcolor:gray;\n\tcursor:pointer;\n}\n\n\n\n#moreIcon:hover+.hover_box{\n\tdisplay:block;\n}\n.hoverOpen{\n\tdisplay:block;\n}\n\n.tab-head + .tab-content {\n\tmargin-top:15px;\n}\n\n.tab-readonly > .bill-tab{\n\tbackground-color: #f4f9ff;\n}\n\n.tab-readonly > .bill-tab > li{\n\tpadding: 5px;\n}\n\n.tab-readonly > .bill-tab > li.active{\n\tbackground-color: #0090d9;\n}\n\n.tab-readonly > .bill-tab>li {\n\tborder-right:none;\n\theight:34px;\n\tline-height: 34px;\n    padding: 0 20px;\n}\n\n.tab-readonly + .tab-content>.tab-pane {\n\tdisplay:block;\n}\n\n\n.tools.nav-pills>li {\n\tpadding:0 10px;\n}\n\n.tools.nav-pills>:first-child {\n\tborder-right:solid 1px #cdcdcd;\n\tpadding-right:11px;\n}\n\n\n.tab-arrow-bottom {\n\tposition: absolute;\n\twidth: 0;\n\theight: 0;\n\ttop: 34px;\n\tleft: 47%;\n\tborder: 6px solid #0090d9;\n\tborder-right-color: transparent;\n\tborder-left-color: transparent;\n\tborder-bottom-color: transparent;\n\tdisplay:none;\n}\n\n.active > .tab-arrow-bottom {\n\tdisplay:block;\n}\n\n.bill-submit-btn {\n\tborder-radius: 0;\n\tpadding: 15px 0 !important;\n\twidth: 120px !important;\n\tborder: none !important;\n\theight:50px;\n\tfloat:right;\n\tfont-size: 18px;\n}\n\n.row-submit .btn-toolbar {\n\tfloat:left;\n\tpadding-left: 18px;\n    margin: 0;\n}\n\n.btn-toolbar.btn-left a.btn {\n    padding: 0;\n    margin-left: 0;\n}\n.btn-toolbar.btn-left a {\n    color: #4bb6f0;\n    font-size: 18px;\n}\n\n.row-submit .btn-group > a{\n\t  font-size:14px;\n\t  color:#01a3f6;\n\t  cursor:pointer;\n}\n\n.bill-submit-btn-cancel {\n\tbackground-color: transparent;\n\tfont-weight:normal;\n\tcolor:#464646;\n}\n\n.bill-submit-btn-cancel:hover {\n\tbackground-color: #e8f7fd;\n\tcolor: #464646;\n}\n\n.bill-submit-btn-save:hover {\n\tbackground-color: #4bb6f0;\n}\n\n.bill-view-btns{\n\tdisplay:none;\n}\n\n.bill-readonly .submit-container {\n\tdisplay:none;\n}\n\n.bill-readonly .bill-view-btns{\n\tdisplay:block;\n\tfloat:right;\n}\n\n.bill-readonly .bill-view-btns > .btn{\n\tborder: none;\n    background-color: transparent;\n    color: #464646;\n    font-size: 18px;\n}\n\n.bill-submit-btn-view {\n\tborder: none;\n    background-color: transparent;\n    color: #fff;\n    padding: 0 10px 0 0;\n}\n\n.bill-submit-btn-more, .bill-submit-btn-more:hover {\n\tcolor:#fff !important;\n}\n\n.bill-view-dropdown {\n\twidth: 126px;\n\tleft: initial;\n\tright: 0 !important;\n    min-width: auto;\n    border-radius: 0;\n    top: 31px;\n    border-color: #c9c9c9;\n    box-shadow: 0 2px 4px rgba(186,186,186,.3);\n}\n\n.bill-grid-view-btn {\n\tdisplay:block;\n\twidth:25px;\n\theight:25px;\n}\n\n.bill-grid-view-btn-list {\n\tbackground:url(\"/iwebap/css/img/grid_list.png\") no-repeat;\n}\n\n.active > a > .bill-grid-view-btn-list {\n\tbackground:url(\"/iwebap/css/img/grid_list_active.png\") no-repeat\n}\n\n.bill-grid-view-btn-form {\n\tbackground:url(\"/iwebap/css/img/grid_form.png\") no-repeat\n}\n\n.active > a > .bill-grid-view-btn-form {\n\tbackground:url(\"/iwebap/css/img/grid_form_active.png\") no-repeat\n}\n\n.tools.nav > li > a, .tools.nav > li > a:hover,.tools.nav > li > a:focus,.tools.nav > li.active > a {\n\t    padding: 0;\n    background-color: #fff;\n}\n\n.u-grid-header-link {\n\tpadding-left: 0;\n    padding-right: 0;\n        text-align: center;\n}\n\n[fieldname=\"0paybill_subjcode\"] .fa-angle-down {\n\tdisplay:none !important;\n}\n\n.u-grid-content-edit-menu-button-add {\n\tcolor: #01a3f6;\n}\n\n.u-grid-content-edit-menu-button-save {\n\tcolor: #4bb6f0;\n\tmargin-left: 10px;\n}\n.u-grid-focus-sel {\n\tbackground-color: #f0f8d6 !important;\n}\n.u-grid-move-bg{\n\tbackground-color: #fff8ee !important;\n}\n.grid_open_edit {\n\tbox-sizing: border-box;\n\tborder-bottom: 1px solid #E5E5E5;\n}\n\n@font-face {font-family: 'iconfont';\n    src: url('./font/iconfont.eot');\n    src: url('./font/iconfont.eot?#iefix');\n    url('./font/iconfont.woff') format('woff');\n    url('./font/iconfont.ttf') format('truetype'); \n    url('./font/iconfont.svg#iconfont') format('svg'); \n}\n\n.u-grid-content-td-div {\n\theight: 42px;\n\tline-height: 40px;\n\twhite-space: nowrap;\n    text-overflow: ellipsis;\n    position:relative;\n    font-size: 0.875em;\n}\n\n.bill-u-grid-mixcol-currtype {\nmargin-top:2px;\n\tcolor: #999;\n}\n\n.u-grid-edit-item-float, .u-grid-edit-item-currency, .u-grid-edit-item-integer {\n\ttext-align:right;\n}\n\n.u-grid-edit-label > div {\n    display: table-cell;\n    width: 96px;\n    height: 30px;\n    vertical-align: middle;\n    line-height: 15px;\n}\n\n\n\n.u-grid-header-columnmenu {\n\tdisplay:none !important;\n}\n\n.u-grid-edit-whole-div {\n\tposition: relative;\n    width: 306px;\n\tmax-width:306px;\n\tmin-width:306px;\n}\n@media (min-width: 1700px) {\n\t.u-grid-edit-whole-div {\n\t\twidth: 330px;\n\t\tmax-width:330px;\n\t\tmin-width:330px;\n\t}\n}\n\n.u-grid-edit-mustFlag {\n\tposition: absolute;\n    left: 98px;\n    top: 10px;\n}\n\ntr:hover > .oper_td > .u-grid-content-td-div {\n\tdisplay: block;\n}\n\ntr > .oper_td > .u-grid-content-td-div {\n\tdisplay: none;\n}\n.u-grid-edit-div {\n\tmargin-left: 14px;\n}\n.u-grid-edit-div .u-grid-content-td-div .u-grid-edit-item-comb div{\n\tfont-size: 14px;\n\t text-align: left;\n}\n\n.bill-grid-detail-readonly .grid-rowadd, .bill-grid-overview-readonly .grid-rowadd{\n\tdisplay:none !important;\n}\n\n\n.headform_more{\n\ttext-align:center;\n\tmargin:5px;\n}\n.headform_more a{\n\tdisplay: block;\n\tcursor: pointer;\n}\n\n.bill-grid-detail tr[editor=\"true\"]{\n\tbackground-color: #f6f7f9 !important;\n}\n\n.bill-grid-detail tr[editor=\"true\"] > td{\n\tpadding: 0 !important;\t\n}\n\n.bill-grid-detail tr[editor=\"true\"] > td > div{\n\tdisplay:none;\n}\n\n.bill-grid-detail tr[editor=\"true\"] > td > div > div{\n\tpadding-bottom: 40px;\n}\n\n/*.bill-grid-detail tbody > tr[eventr=\"true\"]{\n\tbackground-color: #f9f9fa;\n\tborder-bottom: 1px solid #fff;\n}\n\n.bill-grid-detail tbody > tr[eventr=\"false\"]{\n\tbackground-color: #fff;\n\tborder-bottom: 1px solid #fff;\n}*/\n\n.bill-grid-detail table tr {\n\tborder-top: 10px solid #ffffff;\n\tbackground-color: #ffffff;\n}\n.table-hover>tbody>tr:hover {\n\tbackground-color: #ffffff;\n}\n\n.bill-grid-detail tfoot > tr[editor=\"true\"]{\n\tborder-top: 10px solid #ffffff;\n}\n\n\n.bill-grid-detail table> tbody > tr > td{\n\tborder:none;\n\tpadding: 25px 0;\n\tline-height: 28px;\n}\n\n.bill-grid-detail table> tbody > tr > td.oper_td{\n\tpadding:0;\n\tline-height: 28px;\n}\n\n.bill-grid-detail table> tbody > tr > td.oper_td > div{\n\tfloat: right;\n\theight:40px;\n}\n\n.bill-grid-detail table> tbody > tr > td.oper_td > div img{\n\tvertical-align: top;\n}\n\n.bill-grid-detail table> tbody > tr > td.oper_td > div> span> a{\n\ttext-align: center;\n\tdisplay: block;\n\tpadding: 0px;\n\tline-height: 16px;\n\tfont-size: 16px;\n\tcursor: pointer;\n\tcolor: #fff;\n\tmargin-top: 10px;\n\twidth: auto !important;\n\tvertical-align: sub;\n}\n\n.bill-grid-detail .hover_box{\n\tmax-width: none !important;\n\t/*top: auto !important;*/\n}\n\n.bill-grid-detail .hover_box:hover{\n\t/*display: block;*/\n}\n\n.bill-grid-detail .more_detail:before, .bill-grid-detail .more_detail:after{\n\tleft: 65px !important;\n}\n\n.form-readonly-head, .form-readonly-td {\n\tpadding-top:25px;\n\t/*background-colo