            "text": "requirejs([],function (){\r\n\tvar protocol_name=\"TURLProtocol:\";\r\n\topenTBrowser=function(dataStr){\r\n\t\tif(dataStr.indexOf(\"{\")>-1&&dataStr.indexOf(\"}\")>-1){\r\n\t\t\tvar data=eval('('+dataStr+')');\r\n\t\t\tif(data.url_opensoft==null||data.url_opensoft==undefined||data.url_opensoft==\"\"){\r\n\t\t\t\talert(\"启动控件的url无效\");\r\n\t\t\t\treturn;\r\n\t\t\t}\r\n\t\t\tif(data.url_opensoft.indexOf(protocol_name)>-1){\r\n\t\t\t\tvar uuid=\"\";\r\n\t\t\t\tvar basePath=\"http://\"+data.ip+\":\"+data.port+\"/TIMS-Server/\";\r\n\t\t\t\t$.ajax({\r\n\t\t\t\t\turl:basePath+\"softController/beforeOpenSoft\",\r\n\t\t\t\t\tdataType:\"jsonp\",\r\n\t\t\t\t\tasync:false,\r\n\t\t\t\t\tjsonp:\"callback\",\r\n\t\t\t\t\tdata:{res:\"NC\"},\r\n\t\t\t\t\tsuccess:function(result){\r\n\t\t\t\t\t\tif(result.error==\"0\"){\r\n\t\t\t\t\t\t\tuuid=result.uuid;\r\n\t\t\t\t\t\t\tdata.wait_time=parseInt(result.time);\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tdata.wait_time=8;\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\t//window.location.href=data.url_opensoft+\"&uuid=\"+uuid;\r\n\t\t\t\t\t\t//控件启动方式改为iframe标签启动，以兼容IE和火狐浏览器\r\n\t\t\t\t\t\t//绑定beforeunload事件，防止旧版本IE浏览器跳转\r\n\t\t\t\t\t\t$(window).bind('beforeunload',function(){\r\n\t\t\t\t\t\t\t$(window).unbind('beforeunload');\r\n\t\t\t\t\t\t\treturn \"正在启动控件或打开控件下载页面，请留在此页等待控件响应！\";\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\tvar finalurl=data.url_opensoft+\"&uuid=\"+uuid;\r\n\t\t\t\t\t\t$(\"body\").append('<iframe style=\"display:none;\" src=\"'+finalurl+'\"></iframe>');\r\n\t\t\t\t\t\twindow.setTimeout(function(){\r\n\t\t\t\t\t\t\t$(window).unbind('beforeunload');\r\n\t\t\t\t\t\t\t$.ajax({\r\n\t\t\t\t\t\t\t\turl:basePath+\"softController/checkOpenStatus\",  \r\n\t\t\t\t\t\t\t\tdataType:\"jsonp\",\r\n\t\t\t\t\t\t\t\tjsonp:\"callback\",\r\n\t\t\t\t\t\t\t\tdata:{uuid:uuid,res:\"NC\"},\r\n\t\t\t\t\t\t\t\tasync:true,\r\n\t\t\t\t\t\t\t\tsuccess:function(result){\r\n\t\t\t\t\t\t\t\t\tif(result==\"no_file\"){\r\n\t\t\t\t\t\t\t\t\t\twindow.open(data.url_download, \"Download\", \"height=400, width=800, top=100, left=100, toolba=no, menubar=no, scrollbars=no, resizable=no, location=no, status=no\");\r\n\t\t\t\t\t\t\t\t\t}else if(result==\"no_soft\"){\r\n\t\t\t\t\t\t\t\t\t\twindow.open(data.url_download, \"Download\", \"height=400, width=800, top=100, left=100, toolba=no, menubar=no, scrollbars=no, resizable=no, location=no, status=no\");\r\n\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\t\terror:function(XMLHttpRequest, textStatus, errorThrown){\r\n\t\t\t\t\t\t\t\t\talert(\"验证控件启动情况失败，请检查网络或联系管理员！\");\r\n\t\t\t\t\t\t\t\t},\r\n\t\t\t\t\t\t\t\ttimeout:60*1000\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t},data.wait_time*1000);\r\n\t\t\t\t\t},\r\n\t\t\t\t\terror:function(XMLHttpRequest, textStatus, errorThrown){\r\n\t\t\t\t\t\talert(\"获取uuid失败，请检查网络或联系管理员！\");\r\n\t\t\t\t\t},\r\n\t\t\t\t\ttimeout:60*1000\r\n\t\t\t\t});\r\n\t\t\t}\r\n\t\t}else{\r\n\t\t\t//进入待办任务页面\r\n\t\t\twindow.open(dataStr);\r\n\t\t}\r\n\t};\r\n});"
          },
