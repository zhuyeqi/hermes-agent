          "content": {
            "size": 5739,
            "mimeType": "application/x-javascript",
            "text": "require(['jquery', '/iwebap/js/TBrowser.js'], function () {\r\n\timageshowBrowser = function (ipAddr, pk_jkbx) {\r\n\t\tvar url = \"http://\" + ipAddr + \"/TIMS-Server/nc-jsp/imageshow.jsp?\";\r\n\t\tvar pars = {};\r\n\t\tpars.pk_jkbx = pk_jkbx;\r\n\t\tpars.author = \"author\";\r\n\t\tfor (var k in pars) {\r\n\t\t\turl += k;\r\n\t\t\turl += \"=\"\r\n\t\t\turl += pars[k];\r\n\t\t\turl += \"&\";\r\n\t\t}\r\n\t\turl += \"1\";\r\n\t\timageshowBrowserByUrl(url);\r\n\t}\r\n\timageshowBrowserByUrl = function (factoryCode, ipAddr, paraStr) {\r\n\t\tif (factoryCode == \"tchzt\") {\r\n\t\t\tparaStr += \"&author=author\";\r\n\t\t\tvar data = {\r\n\t\t\t\turl_img : \"http://\" + ipAddr + \"/TIMS-Server/nc-jsp/imageshow.jsp?\" + paraStr,\r\n\t\t\t\turl_download : \"http://\" + ipAddr + \"/TIMS-Server/nc-jsp/downloadActivex.jsp\"\r\n\t\t\t}\r\n\t\t\treturn openTBrowser(data);\r\n\t\t} else if (factoryCode == \"tchzt2\") {\r\n\t\t\treturn openTBrowser(paraStr);\r\n\t\t} else {\r\n\t\t\twindow.open(paraStr);\r\n\t\t}\r\n\t}\r\n\timageuploadBrowser = function (ipAddr, pk_jkbx, scanType, modulename, tradtypeName, billNo, detailInfo) {\r\n\t\tvar url = \"http://\" + ipAddr + \"/TIMS-Server/nc-jsp/imageupload.jsp?\";\r\n\t\tvar pars = {};\r\n\t\tpars.pk_jkbx = pk_jkbx;\r\n\t\tpars.scanType = scanType;\r\n\t\tpars.modulename = modulename;\r\n\t\tpars.tradtypeName = tradtypeName;\r\n\t\tpars.billNo = billNo;\r\n\t\tpars.detailInfo = detailInfo;\r\n\t\tfor (var k in pars) {\r\n\t\t\turl += k;\r\n\t\t\turl += \"=\"\r\n\t\t\turl += pars[k];\r\n\t\t\turl += \"&\";\r\n\t\t}\r\n\t\turl += \"1\";\r\n\t\treturn imageuploadBrowserByUrl(url);\r\n\t}\r\n\timageuploadBrowserByUrl = function (factoryCode, ipAddr, paraStr) {\r\n\t\tif (factoryCode == \"tchzt\") {\r\n\t\t\tvar data = {\r\n\t\t\t\turl_img : \"http://\" + ipAddr + \"/TIMS-Server/nc-jsp/imageupload.jsp?\" + paraStr,\r\n\t\t\t\turl_download : \"http://\" + ipAddr + \"/TIMS-Server/nc-jsp/downloadActivex.jsp\"\r\n\t\t\t}\r\n\t\t\treturn openTBrowser(data);\r\n\t\t} else if (factoryCode == \"tchzt2\") {\r\n\t\t\treturn openTBrowser(paraStr);\r\n\t\t} else {\r\n\t\t\twindow.open(paraStr);\r\n\t\t}\r\n\t}\r\n\tinvoiceBindImageSend = function (YF_billtype, YF_billid, FP_billtype, FP_transtype, FP_billid, FP_billno, FP_amount, FP_billdate, FP_pkorg, userid) {\r\n\t\tvar param = {};\r\n\t\tparam.YF_billtype = YF_billtype;\r\n\t\tparam.YF_billid = YF_billid;\r\n\t\tparam.FP_billtype = FP_billtype;\r\n\t\tparam.FP_transtype = FP_transtype;\r\n\t\tparam.FP_billid = FP_billid;\r\n\t\tparam.FP_billno = FP_billno;\r\n\t\tparam.FP_amount = FP_amount;\r\n\t\tparam.FP_billdate = FP_billdate;\r\n\t\tparam.FP_pkorg = FP_pkorg;\r\n\t\tparam.userid = userid;\r\n\t\t$.ajax({\r\n\t\t\ttype : 'GET',\r\n\t\t\turl : '/iwebap/image_ctr/invoicebindimage?time=' + new Date().getTime(),\r\n\t\t\tdata : param,\r\n\t\t\tdataType : 'json',\r\n\t\t\tsuccess : function (data) {\r\n\t\t\t\tif (data[\"success\"] == \"true\") {\r\n\t\t\t\t\tvar bindurl = encodeURI(encodeURI(data[\"bindurl\"]));\r\n\t\t\t\t\twindow.open(bindurl);\r\n\t\t\t\t} else {\r\n\t\t\t\t\ttop.$.showMessageDialog({\r\n\t\t\t\t\t\ttype : \"info\",\r\n\t\t\t\t\t\ttitle : \"提示\",\r\n\t\t\t\t\t\tmsg : data[\"message\"],\r\n\t\t\t\t\t\tbackdrop : true\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\timageuploadBrowserSend = function (ko, ctrl, checkscanway) {\r\n\t\tvar openbillid = ctrl.openbillid;\r\n\t\tvar data = ctrl.getValue(false);\r\n\t\tif (!data)\r\n\t\t\treturn;\r\n\t\tif (openbillid != null && openbillid != undefined) {\r\n\t\t\tdata.head.openbillid = openbillid;\r\n\t\t}\r\n\t\tvar param = {};\r\n\t\tparam.tradetype = ctrl.app.getEnvironment().clientAttributes[\"tradetype\"];\r\n\t\tvar dataJson = ko.utils.stringifyJson(data);\r\n\t\tvar compressType = '';\r\n\t\tvar compression = true;\r\n\t\tif (compression) {\r\n\t\t\tif (!iweb.browser.isIE8 && window.pako) {\r\n\t\t\t\tdataJson = encodeBase64(window.pako.gzip(dataJson));\r\n\t\t\t\tcompressType = 'gzip';\r\n\t\t\t} else {\r\n\t\t\t\tcompression = false;\r\n\t\t\t}\r\n\t\t}\r\n\t\tparam.bill = dataJson;\r\n\t\tparam.compressType = compressType;\r\n\t\tparam.compression = compression;\r\n\t\tparam.checkscanway = checkscanway;\r\n\t\t$.ajax({\r\n\t\t\ttype : 'GET',\r\n\t\t\turl : '/iwebap/image_ctr/imageupload?time=' + new Date().getTime(),\r\n\t\t\tdata : param,\r\n\t\t\tdataType : 'json',\r\n\t\t\tsuccess : function (data) {\r\n\t\t\t\tif (data[\"success\"] == \"true\") {\r\n\t\t\t\t\tvar factoryCode = data[\"factoryCode\"];\r\n\t\t\t\t\tvar ipAddr = data[\"ipaddr\"];\r\n\t\t\t\t\tvar paraStr = '';\r\n\t\t\t\t\tif (factoryCode == \"tchzt2\") {\r\n\t\t\t\t\t\tparaStr = data[\"parastr\"];\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\tparaStr = encodeURI(encodeURI(data[\"parastr\"]));\r\n\t\t\t\t\t}\r\n\t\t\t\t\timageuploadBrowserByUrl(factoryCode, ipAddr, paraStr);\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$.showMessageDialog({\r\n\t\t\t\t\t\ttype : \"info\",\r\n\t\t\t\t\t\ttitle : \"提示\",\r\n\t\t\t\t\t\tmsg : data[\"message\"],\r\n\t\t\t\t\t\tbackdrop : true\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\timageshowBrowserSend = function (ko, ctrl, permission) {\r\n\t\tvar openbillid = ctrl.openbillid;\r\n\t\tvar data = ctrl.getValue(false);\r\n\t\tif (!data)\r\n\t\t\treturn;\r\n\t\tif (openbillid != null && openbillid != undefined) {\r\n\t\t\tdata.head.openbillid = openbillid;\r\n\t\t}\r\n\t\tvar param = {};\r\n\t\tparam.tradetype = ctrl.app.getEnvironment().clientAttributes[\"tradetype\"];\r\n\t\tvar dataJson = ko.utils.stringifyJson(data);\r\n\t\tvar compressType = '';\r\n\t\tvar compression = true;\r\n\t\tif (compression) {\r\n\t\t\tif (!iweb.browser.isIE8 && window.pako) {\r\n\t\t\t\tdataJson = encodeBase64(window.pako.gzip(dataJson));\r\n\t\t\t\tcompressType = 'gzip';\r\n\t\t\t} else {\r\n\t\t\t\tcompression = false;\r\n\t\t\t}\r\n\t\t}\r\n\t\tparam.bill = dataJson;\r\n\t\tparam.compressType = compressType;\r\n\t\tparam.compression = compression;\r\n\t\tparam.permission = permission;\r\n\t\t$.ajax({\r\n\t\t\ttype : 'GET',\r\n\t\t\turl : '/iwebap/image_ctr/imageshow?time=' + new Date().getTime(),\r\n\t\t\tdata : param,\r\n\t\t\tdataType : 'json',\r\n\t\t\tsuccess : function (data) {\r\n\t\t\t\tif (data[\"success\"] == \"true\") {\r\n\t\t\t\t\tvar ipAddr = data[\"ipaddr\"];\r\n\t\t\t\t\tvar paraStr = encodeURI(encodeURI(data[\"parastr\"]));\r\n\t\t\t\t\tvar factoryCode = data[\"factoryCode\"];\r\n\t\t\t\t\timageshowBrowserByUrl(factoryCode, ipAddr, paraStr);\r\n\t\t\t\t} else {\r\n\t\t\t\t\t$.showMessageDialog({\r\n\t\t\t\t\t\ttype : \"info\",\r\n\t\t\t\t\t\ttitle : \"提示\",\r\n\t\t\t\t\t\tmsg : data[\"message\"],\r\n\t\t\t\t\t\tbackdrop : true\r\n\t\t\t\t\t});\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n});\r\n"
          },
