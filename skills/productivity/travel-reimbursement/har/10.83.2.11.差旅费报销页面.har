t{\n\tpadding:0px;\n}\n\n.u-input{\n\tpadding:0px;\n\tborder-bottom:0px;\n\theight:100%;\n}\n\n.tooltip{\n\tfont-family:\"Helvetica Neue\",Helvetica,Arial,sans-serif;\n\tbackground:none;\n\ttransform:none;\n\tfont-weight:400;\n\tfont-size:12px;\n}\n\n\n/*message.less begin*/\n\n.alert-dialog {\n  position: fixed;\n  width: 500px;\n  height: auto;\n  top: 50%;\n  left: 50%;\n  margin-left: -250px;\n  margin-top: -160px;\n  display: block;\n  padding: 0px;\n  border-radius: 0px;\n  color: #333333;\n  background-color: #F2F2F2;\n  border-color: #C9C9C9;\n}\n\n.alert-dialog h4{\n\ttext-align: center;\n\tline-height: 20px;\n\tfont-size: 15px;\n\tbackground-color: #ffffff;\n\tpadding: 10px 15px;\n\tborder-bottom: 1px solid #C9C9C9;\n }\n.alert-dialog h4 span{\n\tfont-size: 18px;\n\tcolor: #FF9917;\n\tposition: relative;\n\tright: 20px;\n }\n .alert-dialog p{\t \t\n\t\n\tmin-height: 90px;\n\tmax-height: 200px;\n\tpadding: 10px 15px;\n\ttext-align: center;\n\toverflow-y: auto;\n }\n  .alert-dialog .close{\n\ttop: 5px;\n\tright: 14px;\n\tcolor: #333333;\n }\t\n .alert-dialog-footer{\n\t\n\tright:0px;\n\tleft:auto;\n }\t\n.alert-dialog-footer .btn{\n\tmin-height: 28px !important;\n\tpadding: 0px !important ;\t\t\t\n\tvertical-align:top !important;\t\n\tmargin: 0px auto !important;\t\t\n\tborder-radius: 0px;\n\tbackground-color: #ffffff;\n\twidth: 135px;\t\n\tcolor: #333333;\n\tborder-color:#C9C9C9;\n\t font-family: 'arial','微软雅黑','宋体' !important;\t\t\n }\n.alert-dialog-footer .btn-danger{\n\tbackground-color:#3385ff;\n\tcolor:#ffffff;\n} \n.alert-dialog-footer {\t\n\twidth:100%; \n\tbottom: 0; \n\tleft:0; \n\tpadding:10px;\n\t& div {\n\t\tpadding: 0 0 0 2px;\n\t}\n\t& div:first-child {\n\t\tpadding: 0 2px 0 0;\n\t}\n\n}\n.alert-dialog-footer:after{\n\t \tcontent:\"\";\n\t \tdisplay: block;\n\t \tclear: both;\n\t \tvisibility: hidden;\n}\n\n.alert-content {\n\t\n    overflow-y: auto;\n}\n\n.move-dialog {\n  position: fixed;\n  width: 520px;\n  height: 260px;\n  padding: 10px;\