            "mimeType": "text/plain",
            "text": "    define(['jquery', 'knockout','/iwebap/js/templetutils.js', '/iwebap/erm/js/liancha.commonctrl.js', '/iwebap/js/ext/gridRender.js', 'fullgridRender'], function($, ko, templetUtils, ctrl, gridRender, fullGridOper) {\n        window.ko = ko;\n        ctrl.pagesize = 50;\n        ctrl.grid_ys = {\n            columns:[\n            {\n                field: \"m_names\",\n                title: \"预算维度\",\n                width: 180,\n                editable: false,\n                sortable: false\n            },\n            {\n                field: \"m_begdate\",\n                title: \"起始日期\",\n                width: 180,\n                editable: false,\n                sortable: false\n            },   \n            {\n                field: \"m_enddate\",\n                title: \"终止日期\",\n                width: 115,\n                sortable: false,\n                editable: false,\n                dataType: \"Date\"\n            },\n            {\n                field: \"m_plandata\",\n                title: \"计划数\",\n                width: 115,\n                editable: false,\n                sortable: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            },\n            {\n                field: \"m_ctrldata\",\n                title: \"控制数\",\n                width: 115,\n                editable: false,\n                sortable: false,\n\t\t\t\tvisible: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            },\n            {\n                field: \"m_canusedata\",\n                title: \"可用预算数\",\n                width: 115,\n                editable: false,\n                sortable: false,\n\t\t\t\tvisible: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            },\n            {\n                field: \"m_rundata\",\n                title: \"执行数\",\n                width: 115,\n                editable: false, \n                sortable: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            },\n            {\n                field: \"m_readydata\",\n                title: \"预占数\",\n                width: 115,\n                editable: false,\n                sortable: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            },   \n            {\n                field: \"m_balance\",\n                title: \"余额\",\n                width: 115,\n                sortable: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            },\n            {\n                field: \"m_planname\",\n                title: \"计划名称\",\n                editable: false,\n                width: 115,\n                sortable: false\n            }              \n        ]};\n        ctrl.grid_pz_main = {\n            columns:[\n            {\n                field: \"explanation\",\n                title: \"摘要\",\n                width: 180,\n                editable: false,\n                sortable: false\n            },\n            {\n                field: \"accsubj\",\n                title: \"科目\",\n                width: 180,\n                sortable: false\n            },\n            {\n                field: \"amount\",\n                title: \"原币\",\n                width: 115,\n                editable: false,\n                sortable: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            },   \n            {\n                field: \"localdebitamount\",\n                title: \"借方本币\",\n                width: 115,\n                sortable: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            },\n            {\n                field: \"localcreditamount\",\n                title: \"贷方本币\",\n                editable: false,\n                width: 115,\n                sortable: false,\n\t\t\t\trenderType:\"ctrl.renderType\", \n\t\t\t\tdataType:\"float\"\n            }          \n        ]};\n        var myControllerFunction = function(){};\n        myControllerFunction.prototype = ctrl;\n        var myController = new myControllerFunction();\n        return myController;\n    });"
