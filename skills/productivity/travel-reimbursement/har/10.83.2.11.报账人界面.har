          "content": {
            "size": 15034,
            "mimeType": "text/css",
            "text": "@import 'bundle.css';\nbody {\n  font-family: Arial, \"Microsoft Yahei\", sans-serif;\n  /*background: #f5f5f5;*/\n  font-size: 14px;\n}\n* {\n  margin: 0;\n  padding: 0;\n}\nul li {\n  list-style: none;\n}\na:hover {\n  cursor: pointer;\n  text-decoration: none;\n}\n.blue {\n  color: #00b5f4;\n}\n/*布局*/\n.portal-nav {\n  background: #40c8f7 ;\n  overflow: hidden;\n}\n.portal-nav .portal-nav-logo {\n  float: left ;\n}\n.portal-nav .portal-nav-setting {\n  float: right;\n}\n.portal-content {\n  height: auto ;\n  min-height: 90%;\n  overflow: hidden;\n}\n/**齿轮样式**/\n.pub-btn-setting {\n  width: 24px;\n  height: 24px;\n  float: right;\n  margin: 8px 10px 0 0;\n  background: url(\"../image/public/settingBtn.png\");\n}\n.pub-btn-setting:hover {\n  background: url(\"../image/public/settingBtnHover.png\");\n}\n.pub-btn-search {\n  width: 24px;\n  height: 24px;\n  float: right;\n  margin: 10px 10px 0 0;\n  background: url(\"../image/public/searchSmallBtn.png\");\n}\n.pub-btn-search:hover {\n  background: url(\"../image/public/searchSmallBtnHover.png\");\n}\n/*更多**/\n.pub-btn-more {\n  width: 7px;\n  height: 12px;\n  background: url(\"../image/public/more.png\");\n  float: right;\n  margin: 15px 15px 0 0;\n}\n.pub-btn-more:hover {\n  background: url(\"../image/public/moreHover.png\");\n}\n/**grid table style*/\n.portal-table-search {\n  margin: -15px 10px 10px;\n}\n.portal-table-search li {\n  overflow: hidden;\n  height: 40px;\n  line-height: 30px;\n}\n.portal-table-search #billtype-tab {\n  line-height: 30px;\n  text-align: left;\n  width: 98%;\n  padding-left: 90px;\n  margin-left: -4px;\n  margin-bottom: 10px;\n}\n.portal-table-search .portal-table-search-span {\n  float: left;\n  margin: 0 15px;\n}\n.portal-table-search .active {\n  background: #00b5f4;\n  color: #fff;\n  border-radius: 4px;\n}\n.portal-table-search .portal-table-search-statu {\n  padding: 7px 18px;\n}\n.portal-table-search .portal-table-search-statu:hover {\n  cursor: pointer;\n}\n.portal-table-search .portal-table-search-btn {\n  background: #d6f0f9;\n  color: #337ab7;\n  padding: 0px 15px;\n  border-radius: 5px;\n  margin-left: 11px;\n  display: inline-block;\n}\n.portal-table-search .portal-table-search-btn:hover {\n  color: #fff;\n  cursor: pointer;\n  background: #00b5f4;\n}\n.portal-table-search .portal-table-search-btn:hover i {\n  background: url(\"../image/public/searchSmallBtn.png\");\n}\n.portal-table-search .portal-table-search-btn i {\n  width: 24px;\n  height: 24px;\n  background: url(\"../image/public/searchSmallBtnHover.png\");\n  float: left;\n  margin: 4px 4px 0 0;\n}\n.portal-table-search input {\n  height: 30px;\n  width: 200px;\n  font-size: 12px;\n}\n.portal-table-header {\n  background: #fff;\n  margin: 15px 0;\n  overflow: hidden;\n  padding-top: 15px;\n  min-height: 500px;\n}\n.portal-table-header .prop-table-span {\n  padding: 8px 20px;\n  line-height: 30px;\n  background: #d6f0f9;\n  margin-left: 20px;\n  cursor: pointer;\n  border-radius: 4px;\n}\n.portal-table-header .prop-table-span a {\n  text-decoration: none;\n}\n.portal-table-header .prop-table-span.active {\n  background: #00b5f4;\n}\n.portal-table-header .prop-table-span.active a {\n  color: #fff;\n}\n.container-table {\n  background: #fff;\n  overflow: hidden;\n}\n.grid-table {\n  font-size: 14px;\n  color: #464646;\n  border: 1px solid #f9f9fa;\n  border-collapse: collapse;\n  text-align: center;\n  width: 100%;\n}\n.grid-table th {\n  height: 40px;\n  text-align: center;\n  background-color: #f2fbfe;\n}\n.grid-table th .grid-table-title {\n  display: block;\n  padding: 0 5px;\n  border-left: 1px solid #ccc;\n  height: 14px;\n  line-height: 14px;\n}\n.grid-table th:first-child .grid-table-title {\n  border-left: 0;\n}\n.grid-table tr {\n  border-bottom: 1px solid #e5e5e5;\n}\n.grid-table tr:nth-child(even) {\n  background: #fafafa;\n}\n.grid-table tr:hover td {\n  background: #fff8ee;\n}\n.grid-table tr .total {\n  text-align: right;\n}\n.grid-table tr .datestyle {\n  text-align: center;\n}\n.grid-table td {\n  padding: 10px 5px;\n  background-color: #ffffff;\n  text-align: left;\n  overflow: hidden;\n  word-wrap: break-word;\n  word-break: break-all;\n}\n.delete-icon {\n  background: url('../image/public/icons.png') no-repeat;\n  width: 24px;\n  height: 24px;\n  float: right;\n  position: absolute;\n  background-position: 0 0;\n  margin: 5px 0 0 7px;\n}\n.add-icon-15 {\n  background: url(\"../image/public/addBtn15.png\") no-repeat;\n  float: left;\n}\n.add-icon-15 span {\n  margin-left: 20px;\n}\n.del-icon-15 {\n  background: url(\"../image/public/delBtn15.png\") no-repeat;\n  float: left;\n}\n.del-icon-15 span {\n  margin-left: 20px;\n}\n@media (max-width: 1366px) {\n  .menu-left {\n    display: none;\n  }\n  .cont-menu-screen-open {\n    top: 20%;\n    position: absolute;\n    width: 40px;\n    height: 49px;\n    overflow: hidden;\n    display: none !important;\n    padding-left: 10px;\n    background: url(\"../image/public/menuOpen.png\") no-repeat;\n  }\n  .menu-media-state {\n    display: block;\n    position: absolute;\n    background: url(\"../image/public/transparentBg.png\") repeat-y -7px 0px;\n    min-width: 160px;\n    padding-left: 10px;\n  }\n}\n@media (min-width: 1366px) {\n  .cont-menu-screen-open {\n    display: none;\n  }\n  .welcomeContainer,\n  .portal-nav-box {\n    width: 1200px;\n    margin: 20px auto;\n  }\n  /**main box*/\n  .menu-left {\n    float: left;\n    width: 150px;\n    min-width: 100px;\n  }\n  .menu-right {\n    overflow: hidden;\n  }\n}\n.portal-box {\n  width: 100%;\n  min-width: 900px;\n}\n.cont-menu-title {\n  line-height: 40px;\n  color: #8f8e8e;\n  font-weight: bold;\n  font-size: 12px;\n}\n.cont-menu-icon {\n  background: url('../image/public/icons.png') no-repeat;\n  width: 20px;\n  height: 20px;\n  float: right;\n  background-position: 0 -81px;\n  margin: 8px 30px 0 0;\n}\n.top-menu {\n  width: 100%;\n  overflow: hidden;\n}\n.top-menu li {\n  float: left;\n  color: #9d9d9d;\n  margin: 10px 20px;\n  font-size: 20px;\n  min-height: 30px;\n  line-height: 25px;\n  border: 1px solid #9d9d9d;\n}\n.top-menu li a {\n  display: block;\n  padding: 10px 20px 10px 30px;\n}\n.top-menu li a,\n.menu-lists-child li a {\n  color: #9d9d9d;\n  text-decoration: none;\n}\n.top-menu li .active {\n  color: #ff8c00;\n}\n/*左侧菜单样式**/\n.menu-lists {\n  line-height: 30px;\n}\n.menu-lists-title {\n  color: #464646;\n  font-weight: bold;\n}\n.menu-lists li {\n  line-height: 35px;\n}\n.menu-lists-box {\n  display: none;\n  overflow: hidden;\n  width: 80%;\n  margin: 10px 0 20px 0;\n}\n.menu-lists-child li a {\n  color: #8f8e8e;\n  font-size: 14px;\n}\n.menu-lists-title:hover {\n  cursor: pointer;\n}\n/*已完成 查询面板*/\n.query-panel {\n  color: #028FD1;\n  margin: 20px 0;\n  padding: 20px 0;\n  display: block;\n  background-color: #f1f1f1;\n}\n.query-panel li {\n  line-height: 30px;\n  margin-bottom: 5px;\n}\n.query-tit {\n  display: inline-block;\n  margin: 0 10px;\n  padding: 0 10px;\n}\n.query-select {\n  display: inline-block;\n}\n.query-select span {\n  margin: 0 10px;\n  padding: 0 10px;\n}\n.query-select .active {\n  background-color: #028fd1;\n  color: #fff;\n  float: left;\n}\n/**input style*/\n.input {\n  height: 25px;\n  line-height: 30px;\n}\n/*user selected */\n.user-label {\n  overflow: hidden;\n  background: #fff;\n  padding: 0 10px;\n}\n.user-label .user-opt {\n  width: 100px;\n  height: 100px;\n  display: inline-block;\n  text-align: center;\n  margin: 10px 1.5% 20px;\n}\n.user-label .user-opt:hover {\n  cursor: pointer;\n}\n.user-label .user-opt .user-opt-bill {\n  background: url(\"../image/demo/bill.png\");\n}\n.user-label .user-opt .user-opt-borrow {\n  background: url(\"../image/demo/borrow.png\");\n}\n.user-label .user-opt .user-opt-costAdjust {\n  background: url(\"../image/demo/costAdjust.png\");\n}\n.user-label .user-opt .user-opt-costApplication {\n  background: url(\"../image/demo/costApplication.png\");\n}\n.user-label .user-opt .user-opt-default {\n  background: url(\"../image/demo/default.png\");\n}\n.user-label .user-opt .user-opt-payable {\n  background: url(\"../image/demo/payable.png\");\n}\n.user-label .user-opt .user-opt-payment {\n  background: url(\"../image/demo/payment.png\");\n}\n.user-label .user-opt .user-opt-paymentApplication {\n  background: url(\"../image/demo/paymentApplication.png\");\n}\n.user-label .user-opt .user-opt-receivables {\n  background: url(\"../image/demo/receivables.png\");\n}\n.user-label .user-opt .user-opt-gathering {\n  background: url(\"../image/demo/gathering.png\");\n}\n.user-label .user-opt .user-opt-repayment {\n  background: url(\"../image/demo/repayment.png\");\n}\n.user-label .user-opt .user-opt-demo-img {\n  width: 50px;\n  height: 50px;\n  margin: 10px auto;\n  cursor: pointer;\n  transition: all 1.5s ease-in 0.1s;\n}\n.user-label .user-opt .user-opt-demo-img:hover {\n  -moz-transform: scale(1.2) rotate(360deg);\n  -webkit-transform: scale(1.2) rotate(360deg);\n  -ms-transform: scale(1.2) rotate(360deg);\n  transform: scale(1.2) rotate(360deg);\n}\n.user-addBtn {\n  position: absolute;\n  right: 5px;\n  top: 0;\n  overflow: hidden;\n  display: inline-block;\n  width: 100px;\n  height: 100px;\n  line-height: 100px;\n  text-align: center;\n  cursor: pointer;\n}\n.user-addBtn:hover {\n  border: #67c8f4 1px solid;\n  height: 98px;\n  line-height: 98px;\n}\n.user-opt-txt {\n  display: block;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.user-addBtn-hots {\n  width: 100% ;\n  height: 100%;\n  display: block;\n  padding-top: 26px;\n}\n.dialog-menu-list {\n  overflow-y: auto;\n  overflow-x: hidden;\n  margin-left: 20px;\n}\n.dialog-menu-list .dialog-menu-one .dialog-menu-tit {\n  font-weight: bold;\n  float: left;\n  border-left: 3px solid #00b5f4;\n  text-indent: 10px;\n}\n.dialog-menu-list .dialog-menu-one li {\n  float: left;\n  margin: 1px 15px 5px 5px;\n  height: 23px;\n  line-height: 18px;\n}\n.dialog-menu-list .dialog-menu-two {\n  overflow: hidden;\n}\n.dialog-menu-list .dialog-menu-two .dialog-check .dialog-select-tx {\n  max-width: 280px;\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n  display: inline-block;\n}\n.dialog-menu-list .dialog-menu-two .dialog-check .dialog-check-icon {\n  margin: 1px 3px 0 0;\n}\n.dialog-menu-list .dialog-menu-two .dialog-check:hover {\n  cursor: pointer;\n  color: #00b5f4;\n}\n.dialog-menu-list .dialog-menu-two .dialog-check:hover .dialog-check-icon {\n  background: url(\"../image/public/addBtn15.png\") no-repeat;\n}\n.dialog-menu-list .dialog-menu-two .dialog-check:hover .dialog-two-sure {\n  background: url(\"../image/public/delBtn15.png\") no-repeat;\n}\n.dialog-menu-list .dialog-menu-two .dialog-sure-hover {\n  color: #00b5f4;\n}\n.dialog-menu-list .dialog-menu-two .dialog-check-icon {\n  width: 15px;\n  height: 15px;\n  float: left;\n}\n/**瀑布流*/\n.water-fall {\n  position: relative;\n}\n.water-data-list {\n  display: block;\n  position: absolute;\n  width: 400px;\n}\n.dialog-close {\n  position: absolute;\n  width: 24px;\n  height: 24px;\n  line-height: 24px;\n  text-align: center;\n  background-color: #fff;\n  color: #b3b3b3;\n  border: 1px solid;\n  right: 3px;\n  top: 3px;\n  border-radius: 12px;\n}\n.dialog-close:hover {\n  cursor: pointer;\n  color: #333;\n  background-color: #ccc;\n}\n.dialog-footer-tips {\n  color: #e16430;\n  margin-left: 20px;\n  font-size: 14px;\n}\n.dialog-title {\n  font-weight: bold;\n  font-size: 16px;\n  margin: 20px 0 30px 20px;\n}\n.dialog-footer {\n  text-align: right;\n  font-size: 16px;\n  margin: 0 15px 15px 15px;\n}\n.dialog-footer .pub-button-exit {\n  padding: 10px 26px;\n  color: #c5c5cf;\n}\n.dialog-footer .pub-button-exit:hover {\n  text-decoration: none;\n}\n.dialog-footer .pub-button-save {\n  background: #00b5f4;\n  padding: 10px 26px;\n  color: #fff;\n  border-radius: 5px;\n}\n.dialog-footer .pub-button-save:hover {\n  text-decoration: none;\n}\n/*头部轮播样式*/\n.user-slider-page {\n  display: none;\n}\n.user-slider-page a {\n  text-decoration: none;\n  position: absolute;\n  top: 50%;\n  margin-top: -42px;\n  z-index: 1;\n  display: block;\n  width: 20px;\n  height: 62px;\n  line-height: 62px;\n  background: gray;\n  background: rgba(0, 0, 0, 0.2);\n  filter: progid:DXImageTransform.Microsoft.gradient(startColorstr=#32000000, 0, endColorstr=#32000000, 0);\n  color: #fff;\n  text-align: center;\n  font-size: 22px;\n  font-weight: 400;\n  font-family: simsun;\n}\n.user-slider-page .user-slider-prev {\n  left: 0;\n}\n.user-slider-page .user-slider-next {\n  right: 0;\n}\n.user-slider-num {\n  position: absolute;\n  left: 45%;\n  bottom: 0;\n  z-index: 2;\n  cursor: pointer;\n}\n.user-slider-num span {\n  float: left;\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: #d6d3d3;\n  margin: 3px;\n  line-height: 20px;\n  text-align: center;\n  color: #fff;\n  cursor: pointer;\n  text-indent: -9999em;\n}\n.user-slider-num span.active {\n  background: #67c8f4;\n}\n.user-box-list {\n  padding: 0 20px 10px 20px;\n  position: absolute;\n  width: 100%;\n  top: 0;\n}\n.user-box-page0 {\n  left: 0;\n}\n.user-box-page1 {\n  left: 100%;\n}\n.user-box-all {\n  position: relative;\n  height: 140px;\n  width: 100%;\n}\n.user-box-all:hover .user-slider-page {\n  display: block;\n}\n.user-box-all .user-box-xxx {\n  transition: all 1.5s ease-in 0.1s;\n}\n/*消息模块*/\n.message-box-container {\n  overflow: hidden;\n  margin: 20px 0 ;\n}\n.message-container {\n  float: left;\n  display: inline-block;\n  width: 30%;\n  margin-right: 5%;\n  background: #fff;\n  height: 250px;\n}\n/**IE8 兼容*/\n.message-container + div + div {\n  margin: 0;\n}\n.message-con-tit {\n  background: #f2fbfe;\n  line-height: 40px;\n  text-indent: 5px;\n}\n.message-con-tit span {\n  color: #3f3f3f;\n  font-weight: bold;\n  margin: 0 4%;\n}\n.message-box-list li {\n  line-height: 30px;\n  text-indent: 5px;\n}\n.message-box-list li a {\n  color: #3f3f3f;\n  width: 90%;\n  margin: 0 4%;\n  display: inline-block;\n  overflow: hidden;\n  white-space: nowrap;\n  text-overflow: ellipsis;\n}\n.message-box-list li a:hover {\n  text-decoration: none;\n  color: #337ab7;\n}\n.message-box-list li span {\n  width: 90%;\n  margin: 0 2%;\n}\n.message-box-list li:nth-child(n+4) a {\n  color: #aaa;\n}\n.pagination-style {\n  margin: 20px 20px 20px 0;\n  padding-right: 10px;\n  height: 34px;\n  line-height: 34px;\n  border: 1px solid #ddd;\n  border-left: 0;\n  border-bottom-right-radius: 4px;\n  border-top-right-radius: 4px;\n  float: right;\n  font-size: 12px;\n  color: #666666;\n}\n.pagination-style span:first-child {\n  margin-left: 10px;\n}\n.pagination-style .color-blue {\n  color: #337ab7;\n}\n.pagination-style .page_z,\n.pagination-style .page_j {\n  margin: 0 4px;\n  width: 42px;\n  border: 1px solid #ddd;\n  height: 22px;\n  line-height: 22px;\n  text-align: center;\n  color: #333333;\n  border-radius: 4px;\n}\n.pagination-style .pagination-jump {\n  background-color: #337ab7;\n  color: #fff;\n  padding: 2px 6px;\n  margin-top: -3px;\n  margin-left: 10px;\n}\n.pagination {\n  float: right;\n}\n.pagination li:last-child a,\n.pagination li:first-child a,\n.pagination li:last-child span,\n.pagination li:first-child span {\n  border-bottom-right-radius: 0;\n  border-top-right-radius: 0;\n}\n/*流程弹出框*/\n.dialog-flow {\n  position: absolute;\n  margin-left: -450px;\n  left: 50%;\n}\n.dialog-flow .tab-content .tab-pane {\n  overflow-x: auto;\n}\n.max-h-260 {\n  max-height: 260px;\n}\n.flow-grid {\n  margin: 15px 0;\n}\n.flow-grid .grid-table {\n  border: 1px solid #e5e5e5;\n  font-size: 12px;\n}\n.loading {\n  width: 80px;\n  height: 84px;\n  background: url(\"../image/public/loading.gif\") no-repeat 0 -1px;\n  margin: 0 auto;\n  border: 0;\n}\n"
