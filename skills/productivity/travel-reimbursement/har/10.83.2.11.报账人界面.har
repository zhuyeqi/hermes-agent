t<td class=\"userinfo\" align=\"left\">\n\t\t\t\t\t\t\t\t\t\t<div style=\"height:14px;overflow:hidden;\">\n\t\t\t\t\t\t\t\t\t\t\t<span style=\"float:left;display:block;\">毕征宇</span>\n\t\t\t\t\t\t\t\t\t\t\t<img id=\"imbutton\" style=\"margin-left:5px;float:left;\" onclick=\"loginYouYin('82031001','2C28907A1C494072EA02CC912F77A0CF.ncServer8008');\" src=\"/portal/frame/themes/webclassic/homepage/start_IM_icon.png\">\n\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t\t\t<div style=\"margin-top:5px;float:left;\">\n\t\t\t\t\t\t\t\t\t\t\t\t<a href=\"/portal/pt/home/logout\">注销</a>\n\t\t\t\t\t\t\t\t\t\t\t\t<a>|</a>\n\t\t\t\t\t\t\t\t\t\t\t\t<a id=\"portal_setting\" style=\"cursor: pointer;\" >更多<img src=\"/portal/frame/themes/webclassic/homepage/personal/personal_dropdown.png\" style=\"vertical-align:middle;padding-left: 8px;\"></a>\n\t\t\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t\t\t\t\t</tr>\n\t\t\t\t\t\t\t</table>\n\t\t\t\t\t\t</td>\n\t\t\t\t\t</tr>\n\t\t\t\t\t<tr>\n\t\t\t\t\t\t<td height=\"10\" colspan=\"3\"></td>\n\t\t\t\t\t</tr>\n\t\t\t\t</table>\n\t\t\t</div>\n\t\t\t<!-- 导航栏 -->\n<script>\nfunction hideTopHandler(){\n\tvar ohh = $(\"#head_top\").height();\n\t$(\"#head_top\").attr(\"oriHeight\",$(\"#head_top\").height());\n\t$(\"#head_top\").hide();\n\t$(\"#hideTop\").hide();\n\t$(\"#showTop\").show();\n\tvar ifms = $(\"iframe\");\n\tfor(var i = 0; i< ifms.length; i++){\n\t\tif(ifms[i].id=='more_if')continue;\n\t\tvar hh = $(ifms[i]).height();\n\t\t$(ifms[i]).height(hh + ohh);\n\t}\n}\n\nfunction showTopHandler(){\n\t$(\"#head_top\").show();\n\t$(\"#hideTop\").show();\n\t$(\"#showTop\").hide();\n\tvar ifms = $(\"iframe\");\n\tvar ohh = $(\"#head_top\").attr(\"oriHeight\");\n\tfor(var i = 0; i< ifms.length; i++){\n\t\tif(ifms[i].id=='more_if')continue;\n\t\tvar hh = $(ifms[i]).height();\n\t\t$(ifms[i]).height(hh - ohh);\n\t}\n}\n\nfunction showSrCtn(o){\n \t\t \n}\nfunction initMoreMenu(){\n\tvar sum = 14;\n\tvar width = $(\"#menutd\").width();\n\t$(\"#moreMenu\").empty();\n\t$(\"#menutd\").find(\".menu\").children().each(function(i){\n\t\t$(this).toggle(true);//先显示\n\t\tsum = sum + $(this).width();\n\t\tif(sum > width){//放在更多里\n\t\t\tvar clone = $(this).clone(true);\n\t\t\tclone.show();\n\t\t\t$(this).hide();\n\t\t\t$(\"#moreMenu\").append(clone);\n\t\t}\n\t});\n\tif($(\"#moreMenu\").children().length > 0){\n\t\t$(\"#more\").show();\n\t}else{\n\t\t$(\"#more\").hide();\n\t}\n}\nfunction moreMouseover(){\n\t$(\"#moreMessage\").attr(\"placein\",\"1\");\n\t$(\"#moreMessage\").hide();\n\t\n\tvar top = $(\"#more\").position().top + 9;\n\tvar left = $(\"#more\").position().left - 105;\n\t$(\"#moreMessage\").css(\"left\",left + \"px\");\n\t$(\"#moreMessage\").css(\"top\",top + \"px\");\n\t$(\"#moreMessage\").show();\n}\nfunction moreMessageMouseout(){\n\t$(\"#moreMessage\").attr(\"placein\",\"0\");\n\t\tsetTimeout(function(){\n\t\t\tif($(\"#moreMessage\").attr(\"placein\") == \"0\"){\n\t\t\t\t$(\"#moreMessage\").hide();\n\t\t\t}\n\t\t},2000);\n}\nvar serCount=0;\n$(function(){\n\t//初始化\"更多页签\"项\n\tinitMoreMenu();\n\t$(\"#searchMessage\").attr(\"placein\",\"0\");\n\t//绑定click 搜索关闭\n\t$(document).click(function(){\n\t\tserCount=serCount+1;\n\t\tif($(\"#searchMessage\").attr(\"placein\") == \"1\" && serCount !=2){\n\t\t\t$(\"#searchMessage\").attr(\"placein\",\"0\");\n\t\t\t$(\"#searchMessage\").hide();\n\t\t}\n\t\tserCount=0;\n \t});\n \t//搜索框click事件,避免搜索框隐藏\n \t$(\"#searchMessage\").click(function () {\n \t\tserCount=1;\n \t});\n\t$(\"#search1\").click(function () {\n\t\tif($(\"#searchMessage\").attr(\"placein\") == \"0\"){\n\t\t\t$(\"#searchMessage\").attr(\"placein\",\"1\");\n\t\t\t$(\"#searchMessage\").hide();\n\t\t\tvar top = $(this).position().top + $(\"#search1\").height()-10;\n\t\t\tvar left = $(this).position().left - $(\"#searchMessage\").width() + $(\"#search1\").width()/2 + 14;\n\t\t\t$(\"#searchMessage\").css(\"left\",left + \"px\");\n\t\t\t$(\"#searchMessage\").css(\"top\",top + \"px\");\n\t\t\t$(\"#searchMessage\").show();\n\t\t\tserCount=serCount+1;\n\t\t}else if($(\"#searchMessage\").attr(\"placein\") == \"1\"){\n\t\t\t$(\"#searchMessage\").attr(\"placein\",\"0\");\n\t\t\t$(\"#searchMessage\").hide();\n\t\t\tserCount=0;\n\t\t}\n\t\tinitSourceGroupItem();\n\t});\n\t//更多页签mouseover事件\n\t$(\"#more\").bind('mouseover touchend',function(event){\n\t\tif(event.type==\"mouseover\" || $(\"#moreMessage\").attr(\"placein\")==\"0\"){\n\t\t\tmoreMouseover();\n\t\t\treturn ;\n\t\t}\n\t\tif(event.type==\"touchend\" && $(\"#moreMessage\").attr(\"placein\")==\"1\"){\n\t\t\tmoreMessageMouseout();\n\t\t}\n\t});\n\t$(\"#moreMessage\").mouseout(moreMessageMouseout);\n\n\t$(\"#moreMessage\").mouseover(function () {\n\t\t$(\"#moreMessage\").attr(\"placein\",\"1\");\n\t\t$(\"#moreMessage\").hide();\n\t\n\t\tvar top = $(\"#more\").position().top + 9;\n\t\tvar left = $(\"#more\").position().left - 105;\n\t\t$(\"#moreMessage\").css(\"left\",left + \"px\");\n\t\t$(\"#moreMessage\").css(\"top\",top + \"px\");\n\t\t$(\"#moreMessage\").show();\n\t});\n\t//窗口大小改变事件\n\t$(window).resize(function(){\n\t\t //重新计算显示的页签项\n\t\t initMoreMenu();\n\t\t if($(\"#searchMessage\").attr(\"placein\") == \"1\"){\n\t\t \tvar top = $(\"#search1\").position().top + $(\"#search1\").height();\n\t\t\tvar left = $(\"#search1\").position().left - $(\"#searchMessage\").width() + $(\"#search1\").width()/2 + 4;\n\t\t\t$(\"#searchMessage\").css(\"left\",left + \"px\");\n\t\t\t$(\"#searchMessage\").css(\"top\",top + \"px\");\n\t\t }\n\t });\n});\n\nfunction debug(log){\n\tif(console){\n\t\tconsole.info(log);\n\t}\n}\n\nfunction sourceGroupSelected(obj){\n\tvar code=$(obj).attr(\"sourceGroupCode\");\n\t//改变下选中的颜色\n\t$(\"#sourceGroupItems\").find(\"div\").each(function(i){\n\t\tvar temp=$(this).attr(\"sourceGroupCode\");\n\t\tif(temp==code){\n\t\t\t$(this).css(\"color\",\"#666666\");\n\t\t\t$(this).css(\"font-weight\",\"bold\");\n\t\t}else{\n\t\t\t$(this).css(\"font-weight\",\"normal\");\n\t\t\t$(this).css(\"color\",\"#0086B2\");\n\t\t}\n\t});\n\t$(\"#groupCode\").val(code);\n}\n\nfunction initSourceGroupItem(){\n\tvar items = $(\"#sourceGroupItems\").children(\"div\");\n\tif(items && items.length > 0){\n\t\tvar width = 0;\n\t\tvar isShowMoreBtn = false;\n\t\titems.each(function(i){\n\t\t\twidth += $(this).outerWidth(true);\n\t\t\tif(width > 242){\n\t\t\t\t$(this).hide();\n\t\t\t\tisShowMoreBtn = true;\n\t\t\t}\n\t\t});\n\t\tif(isShowMoreBtn){\n\t\t\t$(\".search_more_left\").show();\n\t\t\t$(\".search_more_right\").show();\n\t\t}else{\n\t\t\t$(\".search_more_left\").hide();\n\t\t\t$(\".search_more_right\").hide();\n\t\t}\n\t}\n}\n\nfunction showNextSourceGroupItem(direction){\n\tvar items = $(\"#sourceGroupItems\").children(\"div\");\n\tif(items && items.length > 0){\n\t\tvar first = -1;\n\t\tvar last = -1;\n\t\titems.each(function(i){\n\t\t\tif(this.className == 'sourceGroupItem' && $(this).attr(\"sourceGroupCode\") != 'all'){\n\t\t\t\tif(this.style.display != 'none'){\n\t\t\t\t\tif(first == -1){\n\t\t\t\t\t\tfirst = i;\n\t\t\t\t\t}\n\t\t\t\t\tlast = i;\n\t\t\t\t}\n\t\t\t}\n\t\t});\n\t\tvar count = parseInt(direction, 10);\n\t\tif(count > 0){\n\t\t\tif(last + count < items.length){\n\t\t\t\tvar nextItem = $(items[last + count]);\n\t\t\t\t$(items[first]).hide();\n\t\t\t\tnextItem.show();\n\t\t\t}\n\t\t}else if(count < 0){\n\t\t\tif(first + count > 0){\n\t\t\t\tvar prevItem = $(items[first + count]);\n\t\t\t\t$(items[last]).hide();\n\t\t\t\tprevItem.show();\n\t\t\t}\n\t\t}\n\t}\n}\nfunction dosubmit(){\n\tdocument.myform.submit();\n}\n</script>\n<div>\n\t<table width=\"100%\" border=\"0\" cellpadding=\"0\" cellspacing=\"0\">\n\t\t<tr>\n\t\t\t<td class=\"nav_b_lr nav_b_l\"></td>\n\t\t\t<td id=\"menutd\" class=\"nav_b_m\">\n\t\t\t\t<ul class=\"menu\" style=\"height:39px;overflow:hidden;\">\n\t  \t  <li id=\"pserver_MP\"  ><a class=\"mi_l\"></a><a href=\"/portal/pt/home/view?pageModule=pserver&pageName=MP\"  ><span>审批工作台</span></a><a class=\"mi_r\"></a> <span class=\"mi_f mi_f_webclassic\"></span><