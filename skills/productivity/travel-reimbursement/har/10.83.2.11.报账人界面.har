ft;\n\trtn.y = top;\n\treturn rtn; \n}\nfunction showmore(obj){\n\tif($ge(\"more_if\").src==\"\"){\n \t\t$ge(\"more_if\").src=\"/portal/pt/setting/list\";\n \t}\n    $(\"#settingPopupWindow\").attr(\"placein\",\"1\");\n    $(\"#settingPopupWindow\").hide();\n    \n    var rtn = getXY($ge(\"portal_setting\"));\n    var top = rtn.y + $(\"#portal_setting\").height()-5;\n    var left=rtn.x+$(\"#portal_setting\").width()-$(\"#settingPopupWindow\").width()+10;\n\t$(\"#settingPopupWindow\").css(\"left\",left + \"px\");\n\t$(\"#settingPopupWindow\").css(\"top\",top + \"px\");\n\t$(\"#settingPopupWindow\").show();\n}\nfunction hidemore(){\n\t$(\"#settingPopupWindow\").hide();\n\t$(\"#settingPopupWindow\").attr(\"placein\",\"0\");\n}\nvar ishow=0;\n$(document).ready(function(){\n \t $(document).click(function(){\n \t  \tishow=ishow+1;\n \t \tif($(\"#settingPopupWindow\").attr(\"placein\") == \"1\" && ishow !=2){\n \t \t\thidemore();\n \t \t\tsetContentVisible(true);//设置父页面内容区显示\n \t \t}\n \t \tishow=0;\n \t });\n\t $('#portal_setting').click(function(event){\n\t\t if($(\"#settingPopupWindow\").attr(\"placein\") == \"1\"){\n\t \t\thidemore(); \n\t \t\tishow=0;\n\t \t\tsetContentVisible(true);//设置父页面内容区显示\n\t \t }else{\n\t \t \tif($ge(\"more_if\").src==\"\"){\n\t \t \t\t$ge(\"more_if\").src=\"/portal/pt/setting/list\";\n\t \t \t}\n\t \t  \tshowmore($(this));\n \t \t \tishow=ishow+1;\n \t \t \tsetContentVisible(false);//设置父页面内容区隐藏 \n\t \t }\n\t \t if(IS_IE){\n\t \t \tstopDefault(event);\n\t \t }\n     });\n\t $(window).resize(function(event){\n\t\t if($(\"#settingPopupWindow\").attr(\"placein\") == \"1\"){\n\t\t   \tvar rtn = getXY($ge(\"portal_setting\"));\n    \t\tvar top = rtn.y + $(\"#portal_setting\").height()-5;\n    \t\tvar left=rtn.x+$(\"#portal_setting\").width()-$(\"#settingPopupWindow\").width()+10;\n\t\t\t$(\"#settingPopupWindow\").css(\"left\",left + \"px\");\n\t\t\t$(\"#settingPopupWindow\").css(\"top\",top + \"px\");\n\t\t }\n\t\t  if(IS_IE){\n\t \t \tstopDefault(event);\n\t \t }\n\t });\n });\ndocument.body.onscroll = function(){\n\t if($(\"#settingPopupWindow\").attr(\"placein\") == \"1\"){\n\t \tif(document.documentElement && document.documentElement.scrollTop){\n\t\t\tvar top = $(\"#portal_setting\").position().top + $(\"#portal_setting\").height() - document.documentElement.scrollTop;\n\t\t\t$(\"#settingPopupWindow\").css(\"top\",top + \"px\");\t\n\t \t} else {\n\t\t\tvar top = $(\"#portal_setting\").position().top + $(\"#portal_setting\").height() - document.body.scrollTop;\n\t\t\t$(\"#settingPopupWindow\").css(\"top\",top + \"px\");\t\t \t\n\t \t}\n\t }\n}\n</script>\n\n<div id=\"settingPopupWindow\" class=\"popup_div_body\">\n\t<!--<iframe class=\"menu_iframe\" frameborder=\"0\"></iframe>-->\n\t<div class=\"body_top_left\"></div>\n\t<div class=\"body_top_center\"></div>\n\t<div class=\"body_top_right\"></div>\n\t\n\t<div class=\"body_center_left\"></div>\n\t<div class=\"body_center_center\"><iframe id=\"more_if\" frameborder=\"0\" class=\"center_iframe\"></iframe></div>\n\t<div class=\"body_center_right\"></div>\n\t\n\t<div class=\"body_bottom_left\"></div>\n\t<div class=\"body_bottom_center\"></div>\n\t<div class=\"body_bottom_right\"></div>\n</div>\n\t</div>\n</body>\n</html>"
