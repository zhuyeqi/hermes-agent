            "mimeType": "text/css",
            "text": "body{\r\n\t  background-color: #f0f0f0;\r\n\t   font-family:微软雅黑,宋体,黑体,Arial;\r\n\t   overflow:hidden;\r\n}\r\n.allcontent{\r\n\t  position: absolute;\r\n  width: 100%;\r\n  height: 100%;\r\n  overflow-y: auto;\r\n}\r\n.container{\r\n\tpadding-left: 20px;\r\n\tmin-width:700px;\r\n}\r\n.post {\r\n  /* border-bottom: 1px solid #EEE; */\r\n  word-wrap: break-word display:block;\r\n  /* position: relative; */\r\n  border: 1px solid #dedede;\r\n  /* margin-top: -1px; */\r\n  margin-top: 50px\r\n  background-color: #fff;\r\n  min-height: 130px;\r\n  border-radius: 2px;\r\n  border: none;\r\n  border-top: 1px solid #cccccc;\r\n    padding-bottom: 10px;\r\n\r\n}\r\n.psonslfoolter .post{\r\n\t  min-height: 0px;\r\n\t  background-color:#f2f2f2;\r\n}\r\n.fancy-view .fleft img {\r\n  float: left;\r\n  margin-right: 4px;\r\n  margin-top: 3px;\r\n}\r\n.post .p-excerpt .author {\r\n    float: left;\r\n    margin: 0 10px 0 0\r\n}\r\n.post .p-excerpt1 p {\r\n}\r\n.post .excerpt-bg1 p {\r\n  margin-left: 70px;\r\n  font-size: 12px;\r\n  color: #808080;\r\n}\r\n.post .excerpt-bg1 {\r\n\tfloat: left;\r\n}\r\n.post .p-summary {\r\n  float: left;\r\n  margin-left: 15px;\r\n    margin-top: 0px;\r\n}\r\n.post h2 {\r\n  font-size: 15px;\r\n  float: left;\r\n  width: 240px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  margin-top: auto;\r\n}\r\n\r\n\r\n\r\n@media (min-width: 768px) {\r\n          .post h2 {\r\n              width: 260px;\r\n        }\r\n }\r\n@media (min-width: 900px) {\r\n          .post h2 {\r\n              width: 200px;\r\n        }\r\n }\r\n @media (m-width: 1200px) {\r\n          .post h2 {\r\n            width: 400px;\r\n        }\r\n }\r\n \r\n@media (min-width: 1600px)\r\n          .post h2 {\r\n            width: 500px;\r\n        }\r\n}\r\n.post .indexmoreh2{\r\n\t  font-size: 15px;\r\n  float: left;\r\n  width: 300px;\r\n  overflow: hidden;\r\n  text-overflow: ellipsis;\r\n  white-space: nowrap;\r\n  margin-top: -10px;\r\n}\r\n.context1{\r\n  float: left;\r\n  width: 100%;\r\n    margin-bottom: 5px;\r\n        word-wrap: break-word;\r\n    word-break: break-all;\r\n}\r\n.context1 p{\r\n  font-size: 12px;\r\n  color: #666666;\r\n  margin-left: 69px;\r\n    float: left;\r\n        padding-right: 40px;\r\n}\r\n.post h2 a {\r\n\tfont-size:14px;\r\n\tcolor:#006da6;\r\n}\r\n.selectionContainer {\r\n  box-shadow: none;\r\n  border: 1px solid #dedede;\r\n}\r\n\r\n\r\n.post h2 a:hover {\r\n\t  color: #2a6496;\r\n\t  text-decoration: none;\r\n}\r\n.post .meta {\r\n  float: right;\r\n  /* margin-left: -20px; */\r\n  margin-right: 20px;\r\n  /* margin-top: 0px; */\r\n  font-size: 12px;\r\n   /*  color: #9d9d9d; */\r\n color: #808080\r\n}\r\n.post .meta span{\r\n  float: left;\r\n}\r\n.content_top{\r\n\tmargin-left:50px;\r\n}\r\n.content_hr {\r\n  width: 98%;\r\n  border-top: 1px dashed #dcdcdc;\r\n      margin-left: 1%;\r\n    float: left;\r\n    margin-top: 0;\r\n}\r\n.sub-tab-hr{\r\n  height: 12px;\r\n  border-left: 1px solid #b3b3b3;\r\n    margin-top: 2px;\r\n}\r\na.checked{\r\n\t-webkit-border-radius: 2px;\r\n\t background: #006da6;\r\n\t color: #FFF;\r\n\t text-decoration:none\r\n}\r\n.sub-tabcontent a{\r\n\t text-decoration:none\r\n}\r\n.toselectmore {\r\n\ttext-align:center;\r\n\tmargin-top:10px;\r\n\tmargin-bottom:10px;\r\n}\r\n\r\n.toselectmore a {\r\n\r\n  text-decoration: none;\r\n  background: #dce1e5;\r\n  font-size: 12px;\r\n  color: #4d4d4d;\r\n  display: block;\r\n  width: 205px;\r\n  height: 27px;\r\n  text-align: center;\r\n  margin: auto;\r\n  line-height: 27px;\r\n}\r\n\r\n.toselectmore a:hover {\r\n\ttext-decoration: none;\r\n}\r\n.r_title{\r\n\tcursor:pointer;\r\n\t  color: #e5e5e5;\r\n  font-size: 16px;\r\n  margin-top: 40px;\r\n/*   margin-left: 10px; */\r\n  position: relative;\r\n    left: 7%;\r\n    width: 93%;\r\n}\r\n.r_title>.meta-tags{\r\n  position: relative;\r\n    margin-left: 145px;\r\n  margin-top: -20px;\r\n}\r\n.r_span{\r\n  border: 0px;\r