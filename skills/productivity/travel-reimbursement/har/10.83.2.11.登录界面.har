            "mimeType": "application/x-javascript",
            "text": "\"use strict\";\r\n\r\nvar scan = {};\r\n\r\n(function($){\r\n\t\r\n\t$.fn.imgshow = function(pk,systemCode,pluginType){\r\n\t\t\r\n\t\tdebugger;\r\n\t\t\tvar data = {actionCode:\"ncimgshow\",\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\tpluginType: pluginType,\r\n\t\t\t\t\t\t\t\t\tpk_sourcemsg:pk,\r\n\t\t\t\t\t\t\t\t\tmsgtype:\"TASK\",\r\n\t\t\t\t\t\t\t\t\tnote:\"\",\r\n\t\t\t\t\t\t\t\t\tpk_message:pk,\r\n\t\t\t\t\t\t\t\t\tisChangeState:false,\r\n\t\t\t\t\t\t\t\t\tsourceSystemCode:systemCode};\r\n\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t$.ajax({\r\n\t\t\turl:\"/mp/msg/action\",\r\n\t\t\ttype:'POST',\r\n\t\t\tdataType:'json',\r\n\t\t\tcontentType: 'application/json',\r\n\t\t\tdata:JSON.stringify(data),\r\n\t\t\tcache:false,\r\n\t\t\tsuccess:function(tourl){\r\n\t\t\t\tif(tourl == 'ERROR') {\r\n\t\t\t\t\t$.scojs_message('未安装影像模块,无法打开影像查看', $.scojs_message.TYPE_ERROR);\r\n\t\t\t\t}else{\r\n\t\t\t\t\t//URL添加参数userName\r\n\t\t\t\t\tvar loginUserName ;\r\n\t\t\t\t\tif($(\"#nameli\").length > 0){\r\n\t\t\t\t\t\tloginUserName = $(\"#nameli\").text();//登录MP\r\n\t\t\t\t\t} else {\r\n\t\t\t\t\t\tloginUserName = $(\"#usernamehidd\").val();//portal中的MP\r\n\t\t\t\t\t}\r\n\t\t\t\t\twindow.open(tourl + \"&userName=\" + loginUserName);\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t},\r\n\t\t\terror:function(e){\r\n\t\t\t\tdebugger;\r\n\t\t\t\t$.scojs_message('ERROR', $.scojs_message.TYPE_ERROR);\r\n\t\t\t}\r\n\t\t});\r\n\t\t}\r\n\t\r\n\t$.fn.scan = function(pk,systemCode,pluginType){\r\n\t\tdebugger;\r\n\t\t\tvar data = {actionCode:\"ncscan\",\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\tpluginType: pluginType,\r\n\t\t\t\t\t\t\t\t\tpk_sourcemsg:pk,\r\n\t\t\t\t\t\t\t\t\tmsgtype:\"TASK\",\r\n\t\t\t\t\t\t\t\t\tnote:\"\",\r\n\t\t\t\t\t\t\t\t\tpk_message:pk,\r\n\t\t\t\t\t\t\t\t\tisChangeState:false,\r\n\t\t\t\t\t\t\t\t\tsourceSystemCode:systemCode};\r\n\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t$.ajax({\r\n\t\t\turl:\"/mp/msg/action\",\r\n\t\t\ttype:'POST',\r\n\t\t\tdataType:'json',\r\n\t\t\tcontentType: 'application/json',\r\n\t\t\tdata:JSON.stringify(data),\r\n\t\t\tcache:false,\r\n\t\t\tsuccess:function(tourl){\r\n\t\t\t\tif(tourl == 'ERROR') {\r\n\t\t\t\t\t$.scojs_message('未安装影像模块,无法打开影像扫描', $.scojs_message.TYPE_ERROR);\r\n\t\t\t\t}else{\r\n\t\t\t\t\twindow.open(tourl);\r\n\t\t\t\t}\r\n\t\t\t},\r\n\t\t\terror:function(e){\r\n\t\t\t\tdebugger;\r\n\t\t\t\t$.scojs_message('ERROR', $.scojs_message.TYPE_ERROR);\r\n\t\t\t}\r\n\t\t});\r\n\t}\r\n\t\r\n\t$.fn.filtBarcode = function(barcode){\r\n\t\t\tvar data = {actionCode:\"ncfilterbarcode\",\t\r\n\t\t\t\t\t\t\t\t\tbarcode:barcode,\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\tpluginType: \"ncdefault\",\r\n\t\t\t\t\t\t\t\t\tmsgtype:\"TASK\",\r\n\t\t\t\t\t\t\t\t\tnote:\"\",\r\n\t\t\t\t\t\t\t\t\tisChangeState:false,\r\n\t\t\t\t\t\t\t\t\tsourceSystemCode:\"UAP65\"};\r\n\t\tvar rtnID = \"\";\t\t\t\t\t\t\r\n\t\t$.ajax({\r\n\t\t\turl:\"/mp/msg/action\",\r\n\t\t\ttype:'POST',\r\n\t\t\tdataType:'json',\r\n\t\t\tcontentType: 'application/json',\r\n\t\t\tdata:JSON.stringify(data),\r\n\t\t\tcache:false,\r\n\t\t\tasync:false,\r\n\t\t\tsuccess:function(rtnid){\r\n\t\t\t\trtnID = rtnid;\r\n\t\t\t},\r\n\t\t\terror:function(e){\r\n\t\t\t\tdebugger;\r\n\t\t\t\t//不弹出提示返回空值\r\n\t\t\t\t//$.scojs_message('ERROR', $.scojs_message.TYPE_ERROR);\r\n\t\t\t}\r\n\t\t});\r\n\t\tif(rtnID==\"\") {\r\n\t\t\treturn \"\";\r\n\t\t}\r\n\t\tvar parseafter = {\"billno\":\"\",\"billtype\":\"\",\"billid\":rtnID};\r\n\t\treturn parseafter;\r\n\t}\r\n\t\r\n})(jQuery);\r\n\r\n"
