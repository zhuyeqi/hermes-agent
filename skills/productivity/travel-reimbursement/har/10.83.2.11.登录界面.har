 {\r\n    display: table\r\n}\r\n\r\n.tr {\r\n    display: table-row\r\n}\r\n\r\n.tc {\r\n    display: table-cell\r\n}\r\n\r\n.global-nav {\r\n    background: #323a37\r\n}\r\n\r\n.global-nav a {\r\n    display: block;\r\n    padding: 0 10px;\r\n    height: 36px;\r\n    line-height: 36px;\r\n    color: #bbc8c3\r\n}\r\n\r\n.global-nav a:hover, .global-nav a:active {\r\n    color: #FFF;\r\n    text-decoration: none\r\n}\r\n\r\n\r\n.has-dropdown {\r\n    position: relative\r\n}\r\n\r\n.has-dropdown.active > a, .has-dropdown {\r\n    color: #FFF;\r\n    background: #414a47\r\n}\r\n\r\n\r\n.site-header {\r\n    height: 60px;\r\n    background: #f3f6f5\r\n}\r\n\r\n.head-name, .head-search, .head-nav {\r\n    float: left\r\n}\r\n\r\n.head-name {\r\n    margin-top: 15px;\r\n    min-width: 182px\r\n}\r\n\r\n.head-name a:hover, .head-name a:active {\r\n    text-decoration: none\r\n}\r\n\r\n.head-name img {\r\n    vertical-align: middle\r\n}\r\n\r\n.head-name strong {\r\n    display: inline-block;\r\n    margin-left: 5px;\r\n    color: #666;\r\n    font-size: 18px;\r\n    line-height: .5;\r\n    vertical-align: middle\r\n}\r\n\r\n.head-logo {\r\n    display: inline-block;\r\n    width: 128px;\r\n    height: 30px;\r\n    text-indent: -9999em;\r\n    vertical-align: middle;\r\n    background: url(../img/logob.png) left center no-repeat\r\n}\r\n\r\n@media (-webkit-min-device-pixel-ratio: 2),(min-resolution: 192dpi) {\r\n    .head-logo2 {\r\n        background-image: url(../img/logo.png);\r\n        -webkit-background-size: 146px auto;\r\n        -moz-background-size: 146px auto;\r\n        -o-background-size: 146px auto;\r\n        background-size: 146px auto\r\n    }\r\n}\r\n\r\n.head-search {\r\n    position: relative;\r\n/*     margin: 13px 0 0 20px */\r\n}\r\n\r\n.head-search .input-search {\r\n    width: 200px\r\n}\r\n\r\n.head-search .btn-search {\r\n    position: absolute;\r\n    right: 5px;\r\n    top: 5px;\r\n    border: 0;\r\n    background: url(../img/search.png) center