          "content": {
            "size": 31644,
            "mimeType": "application/x-javascript",
            "text": " $(document).ready(function () {\r\n\t\t\t\tvar QueryEvent={\r\n\t\t\t\t\t'beforeInit':'beforeInit.query',\r\n\t\t\t\t\t'afterInit':'afterInit.query',\r\n\t\t\t\t\t'add':'add.query',\r\n\t\t\t\t\t'remove':'remove.query',\r\n\t\t\t\t\t'reset':'reset.query'\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\tvar selected = {};\r\n\t\t\t\tselected.selectedAttr = [];\r\n\t\t\t\tselected.addAttr = function(item){\r\n\t\t\t        this.selectedAttr.push(item);\r\n\t\t\t        return  this.selectedAttr.length;\r\n\t\t\t    };\r\n\t\t\t\t\r\n\t\t\t\tselected.removeAttr = function(item){\r\n\t\t\t        for (var id in this.selectedAttr)\r\n\t\t\t            this.selectedAttr[id] === item && this.selectedAttr.splice(id, 1);\r\n\t\t\t        return this.selectedAttr.length;\r\n\t\t\t    };\r\n\t\t\t\t \r\n\t\t\t\tselected.clean = function(){\r\n\t\t\t        this.selectedAttr = [];\r\n\t\t\t    };\r\n\t\t\t    \r\n\t\t\t    var query = {};\r\n\t\t\t\tquery.hasSetReferDefaultValue={};\r\n\t\t\t\t\r\n\t\t\t\tquery.trigger = function(name){\r\n\t\t\t\t\tvar args = Array.prototype.slice.call(arguments, 1);\r\n\t\t\t\t\t console.log(name+'\\tfire')\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\tquery.setValue = function(itemValue){\r\n\t\t\t\treturn;\r\n\t\t\t\t\tvar that=this;\r\n\t\t\t\t\tif(itemValue['dataType']==='5'){\r\n\t\t\t\t\t\tvar refVal={\r\n\t\t\t\t\t\t\trefpk:itemValue['dataValue'],\r\n\t\t\t\t\t\t\trefname:itemValue['dataName'],\r\n\t\t\t\t\t\t\trefcode:itemValue['dataCode']\r\n\t\t\t\t\t\t};\r\n\t\t\t\t\t\t//var refer=that.getRefer(itemValue['dataId']);\r\n\t\t\t\t\t\t \r\n\t\t\t\t\t}\r\n\t\t\t\t\tthis.trigger('add',itemValue);\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\tquery.buildItemValue = function(itemId,fieldCode,dataType,fieldName,operaCode,displayValue,dataValue,dataName,dataCode){\r\n\t\t\t\t\t  var itemValue={\r\n\t\t\t\t\t\t\t'title':displayValue,\r\n\t\t\t\t\t\t\t'dataId':itemId,\r\n\t\t\t\t\t\t\t'dataType':dataType,\r\n\t\t\t\t\t\t\t'dataName':dataName,\r\n\t\t\t\t\t\t\t'dataValue':dataValue,\r\n\t\t\t\t\t\t\t'dataCode':dataCode,\r\n\t\t\t\t\t\t\t'operaCode':operaCode,\r\n\t\t\t\t\t\t\t'fieldName':fieldName,\r\n\t\t\t\t\t\t\t'fieldCode':fieldCode,\r\n\t\t\t\t\t\t\t'fieldValue':displayValue.length>15?displayValue.substr(0,15):displayValue,\r\n\t\t\t\t\t\t};\r\n\t\t\t\t\t\treturn itemValue;\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\t/**\r\n\t\t\t\t * 操作符合取第一组\r\n\t\t\t\t * @param {Object} operaCode\r\n\t\t\t\t */\r\n\t\t\t\tquery.getDefaultOperaCode=function(operaCode){\r\n\t\t\t\t\tvar defaultOperaCode='';\r\n\t\t\t\t\tif(operaCode){\r\n\t\t\t\t\t\tdefaultOperaCode=operaCode.split('@')[0]+'@';\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tdefaultOperaCode='=@';\r\n\t\t\t\t\t}\r\n\t\t\t\t\treturn defaultOperaCode;\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\tquery.buildItemValueByItemId = function(itemId,displayValue,dataValue,dataName,dataCode){\r\n\t\t\t\t\t  var that=this;\r\n\t\t\t\t\t  var qItem=$('#'+itemId);\r\n\t\t\t\t\t  var $item=qItem.find(\".refer-value\");\r\n\t\t\t\t\t  var dataType=$item.attr('data-type');\r\n\t\t\t\t\t  var fieldCode=$item.attr('data-itemkey');\r\n\t\t\t\t\t  var fieldName = $item.attr('data-label');\r\n\t\t\t\t\t  var operaCode = $item.attr('data-operacode');\r\n\t\t\t\t\t  //拓展\r\n\t\t\t\t\t  defaultOperaCode=that.getDefaultOperaCode(operaCode);\r\n\t\t\t\t\t  \r\n\t\t\t\t\t  var itemValue={\r\n\t\t\t\t\t\t\t'title':displayValue,\r\n\t\t\t\t\t\t\t'dataId':itemId,\r\n\t\t\t\t\t\t\t'dataType':dataType,\r\n\t\t\t\t\t\t\t'dataName':dataName,\r\n\t\t\t\t\t\t\t'dataValue':dataValue,\r\n\t\t\t\t\t\t\t'operaCode':defaultOperaCode,\r\n\t\t\t\t\t\t\t'dataCode':dataCode||\"\",\r\n\t\t\t\t\t\t\t'fieldName':fieldName||\"\",\r\n\t\t\t\t\t\t\t'fieldCode':fieldCode,\r\n\t\t\t\t\t\t\t'fieldValue':displayValue.length>15?displayValue.substr(0,15):displayValue,\r\n\t\t\t\t\t\t};\r\n\t\t\t\t\t\treturn itemValue;\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\t/**\r\n\t\t\t\t * 增加已选条件\r\n\t\t\t\t * @param {Object} item\r\n\t\t\t\t * @param {Object} allTab 添加到所有页签\r\n\t\t\t\t */\r\n\t\t\t\tquery.addSelectedItem = function(item,allTab){\r\n\t\t\t\t\treturn;\r\n\t\t\t\t\tvar that=this;\r\n\t\t\t\t\tvar activeTabClass='.active';\r\n\t\t\t\t\tif(allTab){\r\n\t\t\t\t\t\tactiveTabClass='';\r\n\t\t\t\t\t}\r\n\t\t\t\t\tthat.setValue(item);\r\n\t\t\t\t\tvar selections = this.wrap.find(\".selectionContainer \"+activeTabClass+\" .selections\");\r\n\t\t\t\t\tvar clearAll=selections.find('span.clear-all');\r\n\t\t\t\t\t//$('#'+item['dataId']+'').addClass('added').hide();\r\n\t\t\t\t\t//判断条目是否已选\r\n\t\t\t\t\tif(selections.find('span').length>1){\r\n\t\t\t\t\t\tselections.find('span').each(function(){\r\n\t\t\t\t\t\t\tvar id = $(this).attr(\"data-id\");\r\n\t\t\t\t\t\t\tvar itemId=$('#'+id+'');\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tif(item['dataId']==id){\r\n\t\t\t\t\t\t\t\tvar selectedItem=selections.find('.ss-item[data-id='+id+']:not(.hide)').remove();\r\n\t\t\t\t\t\t\t\titemId.removeClass('added').show();\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\tvar itemValue=that.buildItemValueByItemId(id,selectedItem.attr('title'),selectedItem.attr('data-value'),selectedItem.attr('data-name'),selectedItem.attr('data-code'));\r\n\t\t\t\t\t\t\t\tquery.trigger('remove',itemValue);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t}\r\n\t\t\t\t\t//新增条目\r\n\t\t\t\t\t$('<span>').addClass('ss-item')\r\n\t\t\t\t\t\t\t\t.attr('data-id',\titem['dataId'])\r\n\t\t\t\t\t\t\t\t.attr('title',  \titem['title'])\r\n\t\t\t\t\t\t\t\t.attr('data-type',  item['dataType'])\r\n\t\t\t\t\t\t\t\t.attr('data-name',  item['dataName'])\r\n\t\t\t\t\t\t\t\t.attr('data-value', item['dataValue'])\r\n\t\t\t\t\t\t\t\t.attr('data-code',  item['dataCode'])\r\n\t\t\t\t\t\t\t\t.append('<b>'+item['fieldName']+'：</b>')\r\n\t\t\t\t\t\t\t\t.append('<em>'+item['fieldValue']+'</em>')\r\n\t\t\t\t\t\t\t\t.append('<i></i>').insertBefore(clearAll);\r\n\t\t\t\t\t\t\t\t\r\n\t\t\t\t\tif(selections.find('span.ss-item:not(.clear-all)').length>0){\r\n\t\t\t\t\t\tclearAll.show();\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tclearAll.hide();\r\n\t\t\t\t\t}\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t    query.init = function(opt){\r\n\t\t\t\t\tvar that=this;\r\n\t\t\t\t\tthis.options=opt;\r\n\t\t\t        that.wrap = $(\"#queryArea\");\r\n\t\t\t\t\tthat.qtid=that.wrap.attr(\"data-qtid\");\r\n\t\t\t\t\tthat.funcode=that.wrap.attr(\"data-funcode\");\r\n\t\t\t\t\tthat.ctx=window.ctx;\r\n\t\t\t\t\t//key,value= itemId,obj\r\n\t\t\t\t\tthat.sysfuncache={};\r\n\t\t\t\t\tthat.setMoreVisable(); \r\n\t\t\t\t\tthat.setMoreToggle();\r\n\t\t\t\t\tthat.setMultipleToggle();\r\n\t\t\t\t\tthat.setMultipleSelect();\r\n\t\t\t\t\tthat.bindSelectorMoreToggle();\r\n\t\t\t\t\tthat.bindNavClassTab();\r\n\t\t\t\t\tthat.bindTextInputBtn();\r\n\t\t\t\t\tthat.setRemoveSelector();\r\n\t\t\t\t\tthat.regroupSelectorLine();\r\n\t\t\t    };\r\n\t\t\t\t\r\n\t\t\t\tquery.resetClassItem = function(){\r\n\t\t\t\t\tthis.wrap.find(\".valueList\").each(function(){\r\n\t\t\t\t\t\t$(this).scrollTop(0);\r\n\t\t\t\t\t\tif($(this).hasClass('hotData'))\r\n\t\t\t\t\t\t{\r\n\t\t\t\t\t\t\t$(this).find(\"li\").css(\"display\", \"none\");\r\n\t\t\t\t\t\t\t$(this).find(\"li[data-initial='hotData']\").css(\"display\", \"block\");\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t$(this).find(\"li\").css(\"display\", \"block\");\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t});\r\n                    this.wrap.find(\".classContainer\").find(\"li:first\").addClass(\"curr\").siblings().removeClass(\"curr\");\r\n\t\t\t    };\r\n\t\t\t\t\r\n\t\t\t\tquery.setMoreToggle = function(){\r\n\t\t\t        var that = this;\r\n                    this.wrap.find(\".moreItem\").bind(\"click\", function(){\r\n\t\t\t            var qItem=$(this).closest('.queryAreaItem');\r\n\t\t\t\t\t\tvar opened=$(this).hasClass(\"opened\");\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tvar refer = qItem.find(\".refer-value[data-type='5']\");\r\n\t\t\t\t\t\t    refer.trigger('more.query',opened);\r\n\t\t\t\t\t\t\r\n\t\t\t            opened?\r\n                            (qItem.find(\".refer-wrap\").removeClass(\"extend\"),\r\n                                $(this).html(\"更多\").removeClass(\"opened\"),\r\n                                $(this).parents(\".queryAreaItem\").hasClass(\"refer\") && that.resetClassItem(), qItem.find(\".valueList\").scrollTop(0)) :\r\n                            (qItem.find(\".refer-wrap\").addClass(\"extend\"), $(this).html(\"收起\").addClass(\"opened\"))\r\n\t\t\t        })\r\n\t\t\t    };\r\n\t\t\t\t\r\n\t\t\t\tquery.setMultipleToggle = function(){\r\n\t\t\t        var that = this;\r\n\t\t\t\t\tvar wrap=this.wrap;\r\n\t\t\t        this.wrap.on(\"click\",\".multi-btn\", function(){\r\n\t\t\t            var qItem=$(this).closest('.queryAreaItem');\r\n\t\t\t            qItem.hasClass(\"refer\") || 0 === $(\".refer\").find(\".multiple\").length || that.resetClassItem(),\r\n                        qItem.find(\".refer-wrap\").removeClass(\"extend\").addClass(\"multiple\"),\r\n                        qItem.siblings().find(\".multiple .cancel-btn\").trigger(\"click\");\r\n\t\t\t        }),\r\n\t\t\t\t\tthis.wrap.on(\"click\",\".ok-btn\", function(e){\r\n\t\t\t\t\t\tvar qItem=$(this).closest('.queryAreaItem');\r\n\t\t\t\t\t\tvar $item=qItem.find(\".refer-value\");\r\n\t\t\t\t\t\tvar dataType=$item.attr('data-type');\r\n\t\t\t\t\t\tvar fieldCode=$item.attr('data-itemkey');\r\n\t\t\t\t\t\tvar label = $item.attr('data-label');\r\n\t\t\t\t\t\tvar subSelected=[];\r\n\t\t\t\t\t\tvar subSelectedCode=[];\r\n\t\t\t\t\t\tvar subSelectedVal=[];\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tvar multiSelector='';\r\n\t\t\t\t\t\tif(dataType==='5'){\r\n\t\t\t\t\t\t\tmultiSelector=qItem.find('.selectedContainer ul li');\r\n\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\tmultiSelector=qItem.find('.multiple ul li.i-selected');\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tmultiSelector.each(function(){\r\n\t\t\t\t\t\t\t subSelected.push($(this).attr('data-name'));\r\n\t\t\t\t\t\t\t subSelectedCode.push($(this).attr('data-code'));\r\n\t\t\t\t\t\t\t subSelectedVal.push($(this).attr('data-value'));\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\tvar title=subSelected.join('、');\r\n\t\t\t\t\t\tvar itemValue=that.buildItemValueByItemId(qItem.attr(\"id\"),title,subSelectedVal.join(\",\"),subSelected.join(','),subSelectedCode.join(\",\"));\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tthat.addSelectedItem(itemValue);\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tqItem.find(\".cancel-btn\").trigger(\"click\");\r\n\t\t\t\t\t\te.preventDefault(); \r\n\t\t\t\t\t\te.stopPropagation();\r\n\t\t\t        }),\r\n\t\t\t\t\tthis.wrap.on(\"click\",\".cancel-btn\", function(){\r\n\t\t\t            var qItem=$(this).closest('.queryAreaItem');\r\n\t\t\t            qItem.hasClass(\"refer\") && that.resetClassItem();\r\n\t\t\t\t\t\tqItem.find(\".refer-wrap\").removeClass(\"extend\").removeClass(\"multiple\").find(\".moreItem\").html(\"更多\").removeClass(\"opened\");\r\n\t\t\t\t\t\tqItem.find(\".ok-btn\").addClass(\"disabled\");\r\n\t\t\t\t\t\tqItem.find(\".refer-ext\").show();\r\n\t\t\t\t\t\tqItem.find(\".selectedContainer\").hide().find(\".q-list\").html(\"\");\r\n\t\t\t\t\t\tselected.clean();\r\n                        qItem.find(\".valueList\").scrollTop(0).find(\".i-selected\").removeClass(\"i-selected\")\r\n\t\t\t        })\r\n\t\t\t    };\r\n\t\t\t\t\r\n\t\t\t\t/**\r\n\t\t\t\t * 当前是否多选\r\n\t\t\t\t * @param {Object} qItem\r\n\t\t\t\t */\r\n\t\t\t\tquery.isMultiple = function(qItem){\r\n\t\t\t\t\treturn qItem.find(\".refer-wrap\").hasClass(\"multiple\");\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\tquery.setMultipleSelect = function(){\r\n\t\t\t\t\tvar that=this;\r\n\t\t\t\t\tvar wrap=this.wrap;\r\n\t\t\t        var torggleBtn = function(a, b, c){\r\n\t\t\t            0 >= a ? (b.addClass(\"disabled\"), c.hide()) : (b.removeClass(\"disabled\"), c.show())\r\n\t\t\t        };\r\n\t\t\t        wrap.find(\".refer-value\").on(\"click\",\".valueList li span\", function(e){\r\n\t\t\t            var qItem=$(this).closest('.queryAreaItem');\r\n\t\t\t            var item = $(this).parent(\"li\");\r\n\t\t\t            var selectedContainer = qItem.find(\".selectedContainer\");\r\n\t\t\t            var okBtn = qItem.find(\".ok-btn\");\r\n\t\t\t            if (qItem.find(\".refer-wrap\").hasClass(\"multiple\")) {\r\n\t\t\t                e.preventDefault();\r\n                            e.stopPropagation();\r\n\t\t\t                var id = item.attr(\"id\");\r\n\t\t\t                var size = selected.selectedAttr.length;\r\n\t\t\t                if (item.hasClass(\"i-selected\")) {\r\n\t\t\t                    size = selected.removeAttr(id);\r\n\t\t\t\t\t\t\t\titem.removeClass(\"i-selected\");\r\n\t\t\t\t\t\t\t\tselectedContainer.length && selectedContainer.find('li[data-brand-id=\"' + item.attr(\"id\") + '\"]').remove();\r\n\t\t\t\t\t\t\t}else {\r\n\t\t\t                        if (size = selected.addAttr(id), item.addClass(\"i-selected\"), selectedContainer.length) {\r\n\t\t\t                            var brand = item.clone(false);\r\n\t\t\t                            brand.attr(\"data-brand-id\", brand.attr(\"id\")).removeAttr(\"id\").find(\"img\").remove();\r\n\t\t\t\t\t\t\t\t\t\tselectedContainer.find(\".q-list\").append(brand);\r\n\t\t\t                        }\r\n\t\t\t                torggleBtn(size, okBtn, selectedContainer);\r\n\t\t\t\t\t\t\t}\r\n\t\t\t            }else{\r\n\t\t\t\t\t\t\tvar $item=qItem.find(\".refer-value\");\r\n\t\t\t\t\t\t\tvar dataType=$item.attr('data-type');\r\n\t\t\t\t\t\t\tvar label = $item.attr('data-label');\r\n\t\t\t\t\t\t\tvar fieldCode=$item.attr('data-itemkey');\r\n\t\t\t\t\t\t\tvar title=item.attr('data-name');\r\n\t\t\t\t\t\t\tvar itemValue=that.buildItemValueByItemId(qItem.attr(\"id\"),title,item.attr('data-value'),item.attr('data-name'),item.attr('data-code'));\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\tthat.addSelectedItem(itemValue);\r\n\t\t\t\t\t\t}\r\n\t\t\t        }),\r\n\t\t\t\t\twrap.on(\"click\",\".selectedContainer li span\", function(a){\r\n\t\t\t            var qItem=$(this).closest('.queryAreaItem');\r\n\t\t\t            var item