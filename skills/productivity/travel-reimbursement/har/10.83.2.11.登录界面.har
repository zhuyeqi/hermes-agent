            "text": ".yfd{\n}\n.yfd .yfdbtns {\n\tmargin: -5px 0 10px 0;\n}\n\n.table td{\nfont-size:12px;\n}\n\n.with-scroll {\n\tposition: relative;  width: auto;  \n}\n\n.text-red {\n\tcolor:red;\n\tfont-weight: bold;\n}\n\n.text-blue {\n\tcolor:#337ab7;\n\tfont-weight: bold;\n}\n\n.xxxx table tbody tr td:nth-child(4) {\n\tcolor:#337ab7;\n}\n#gridOperHndler{\n\tposition: absolute;\n\tdisplay: block;\n\twidth: 100px;\n\theight: 30px;\n\tborder: 1px solid;\n}\n\n#body_tab{display: inline;}\n\n\n.nav-pills > li > a{\n\tbackground-color: #e3e4e5;\n\tcolor:#333;\n}\n\n.oper_td i.fa.fa-arrows{\n\tcursor:move;\n}\n\n.rowdragover {\n\theight:37px;\n}\n.rowdragover td{\n\tborder:dashed 2px !important;\n}\n\n#dragfollower {\n\tbackground-color:#40e0d0;\n\twidth:500px;\n\theight:30px;\n\tposition:fixed;\n\tz-index:9999\n}\n\n.oper_td i:hover{\n\t \n\tcolor:#0090d9;\n}\n.copy-img {\nwidth: 24px;\nheight: 24px;\nfloat: left;\nbackground: url(\"../fiimage/copy.png\") no-repeat;\n}\n\n.edit-img {\nwidth: 24px;\nheight: 24px;\nfloat: left;\nbackground: url(\"../fiimage/edit.png\") no-repeat;\n}\n.form-readonly  .col-md-2{\n\tmin-height:18px\n}\n.delete-img {\nwidth: 24px;\nheight: 24px;\nfloat: left;\nbackground: url(\"../fiimage/delete.png\") no-repeat;\n}\n\n.panel-primary{\n\tborder-width: 0px;\n}\n\nbody{\n\tbackground-color:#e5e9ec;\n}\n.panel-body-gray{\nbackground-color:#fff;\n}\n\n.savebutton, #body_edit_action .btn-danger,#body_edit_action .btn-success{\n\twidth:160px;\n\tfloat:right;\n\tmargin-left:5px;\n}\n\n\n\n\n.tab-content {\n\n margin-bottom: 0px; \n   overflow: inherit;\n}\n\n.panel-body{\n\tmargin-bottom:0px;\n}\n\n.panel{\nmargin-bottom:0px;\n}\n/**form globle control*/\n.form-inline[enable=\"false\"]  fieldset[enable=\"\"],  fieldset[enable=\"false\"]{\n\tposition: relative;\n}\n\n.form-inline[enable=\"false\"]  , fieldset[enable=\"false\"] .form-control,fieldset[enable=\"false\"] .input-group-addon,fieldset[enable=\"false\"] .btn-select{\n  cursor: not-allowed;\n  background-color: #f6f7f9;\n  opacity: 1;\n}\n\nfieldset[enable=\"false\"]:after,fieldset[disabled]:after{\n\t  content: \" \";\n\t  width: 100%;\n\t  height: 32px;\n\t  position: absolute;\n\t  top: 0px;\n\t  left: 0px;\n\t  z-index: 50;\n\t  background-color:#fff;\n\t  opacity: 0;\n\t  cursor: not-allowed;\n}\n"
