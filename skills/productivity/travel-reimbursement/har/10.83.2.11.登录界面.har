            "size": 1774,
            "mimeType": "text/css",
            "text": "\n.approve-reject {\n    line-height: 50px;\n    height: 50px;\n    font-family: \\5b8b\\4f53 13px;\n    text-align: center;\n}\n\n.approve-flow-reject {\n    font-weight: bold;\n    color: #000000;\n    width: 60px;\n    float: left;\n    /*border: 1px solid red;*/\n}\n\n.approve-infos-reject {\n    text-align: center;\n\n}\n\n.approve-info-reject {\n    /*line-height: 20px;*/\n    float: left;\n}\n\n.approve-person-reject {\n    width: 50px;\n    float: left;\n}\n\n.approve-action-reject {\n    width: 50px;\n    float: left;\n}\n\n.approve-note-reject {\n    width: 80px;\n    text-align: center;\n    float: left;\n}\n\n.clear {\n    clear: both;\n}\n\n.reject-header {\n    color: #ffffff;\n    background-color: #0090D9;\n    height: 60px;\n}\n\n.reject-content {\n    width: 500px;\n}\n\n.reject-footer {\n    height: 48px;\n    background: #f5f5f5;\n}\n\n.title {\n    color: white;\n    font-weight: bold;\n    text-align: left;\n    line-height: 60px;\n    margin-left: 20px;\n}\n\n.names {\n    width: 90px;\n    overflow: hidden;\n    text-overflow: ellipsis;\n    white-space: nowrap;\n    display: block;\n}\n\n.reject-sur-btn {\n    margin-top: -8px;\n    width: 100px !important;\n    height: 36px !important;\n    margin-right: 7px !important;\n    /*display: none;*/\n}\n\n.dialog-close {\n    margin-top: 15px;\n    float: right;\n    margin-right: 15px;\n}\n\n.reject-sub-table, .reject-table {\n    background: transparent !important;\n}\n\n.reject-table tr {\n    height: 48px !important;\n}\n\n.reject-sub-table td, .reject-table td {\n    border: none !important;\n}\n\n.selected {\n    background-color: #E5F6FE;\n}\n\n.phase {\n    font-weight: bold;\n    margin-left: 30px;\n}\n\n.reject-header h4 {\n    float: left;\n    color: #ffffff;\n    font-weight: bold;\n}\n\n.reject-head-close {\n    float: right;\n}\n\n.datarow-choosen {\n    background-color: #E5F6FE;\n}"
