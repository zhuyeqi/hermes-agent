            "mimeType": "text/css",
            "text": ".approve {\n    /*background: #F2F2F2;*/\n    padding: 10px;\n/*     white-space: nowrap; */\n    font-size: 1.125em;\n    color: #000;\n}\n\n.approve .btn {\n    padding: 5px;\n    width: 100px;\n    font-weight: bold;\n    margin-top: 5px;\n}\n\n.btn-seldefined {\n    margin-right: 15px;\n    width: 68px !important;\n}\n\n.btn-mini-selfdefined {\n    /*color: transparent !important;*/\n    background: transparent !important;\n    width: 40px !important;\n    /*display: inline-block;*/\n}\n\n.div-inline-block {\n    display: inline-block;\n}\n\n.approve-ver {\n    margin: 10px;\n}\n\n.approve-ver .approve-left {\n    /* margin: 0 10px; */\n    margin-top: 0px;\n    margin-right: 15px;\n}\n\n.approve-bage {\n /*  border-radius: 50%; */\n  width: 40px;\n  height: 40px;\n  /* background-color: #3bbb37; */\n  text-align: center;\n  line-height: 40px;\n  color: #fff;\n  margin: auto;\n  font-weight: normal;\n  margin-top: 2px;\n  background:url(/mp/img/approve-bage.png) no-repeat;\n}\n.out_circle{\n /*  border-radius: 50%; */\n  width: 40px;\n  height: 40px;\n  font-weight: bold;\n /*  border: 1px solid #3bbb37; */\n}\n.whitecircle {\n /*  width: 5px;\n  height: 5px;\n  background: #fff;\n  float: left;\n  border-radius: 50%;\n  margin-left: 4px;\n  margin-top: 12px; */\n}\n.out_circletodo{\n  /* border-radius: 50%; */\n  width: 40px;\n  height: 40px;\n  font-weight: bold;\n  /* border: 1px solid #3fa8f4; */\n}\n.out_circletodo-dealed{\n  /* border-radius: 50%; */\n  width: 40px;\n  height: 40px;\n  font-weight: bold;\n /*  border:1px solid gray; */\n}\n.approve p {\n    margin-bottom: 0px;\n}\n\n.approve-pending .approve-bage {\n  /* background: #fff; */\n  /* border: solid 2px #0AC2ED; */\n  /* color: #0AC2ED; */\n  /* background:url(../img/edit_icon.svg) no-repeat #3fa8f4; */\n  background:url(../img/edit_icon.png) center no-repeat;\n  line-height: 23px;\n}\n.approve-pending .approve-bage-dealed{\n\t    /* border-radius: 50%; */\n    width: 40px;\n    height: 40px;\n    /* background-color: gray; */\n    text-align: center;\n    line-height: 40px;\n    color: #a9a9a9;\n    margin: auto;\n    font-weight: normal;\n    margin-top: 2px;\n/*     line-height: 23px; */\n    background:url(/mp/img/approve-bage-dealed.png) no-repeat;\n\t\n}\n.approve-passed .approve-bage {\n    background: #fff;\n    border: solid 2px #32cd32;\n    color: #32cd32;\n    line-height: 23px;\n}\n\n.approve-reject .approve-bage {\n    background: #fff;\n    border: solid 2px #ff7f50;\n    color: #ff7f50;\n    font-size: 0.5em;\n    line-height: 22px;\n}\n\n.approve-unpassed .approve-bage {\n    background: #fff;\n    border: solid 2px #ff7f50;\n    color: #ff7f50;\n    line-height: 23px;\n}\n\n.approve-discard .approve-bage {\n    background: #fff;\n    border: solid 2px #ff7f50;\n    color: #ff7f50;\n    line-height: 23px;\n}\n\n.approve-vertical-line {\n  margin-bottom: 7px;\n  margin-right: 18px;\n  height: 70px;\n  border-right: 1px solid #3bbb37;\n}\n\n.approve-timespan {\n    color: #A9A9A9;\n    font-size: 0.875em;\n}\n\n.approve-nopass .approve-person {\n    color: red;\n}\n\n.approve-hor {\n    border-left: solid 8px blue;\n    width: 100%;\n    height: 80px;\n    padding-top: 15px;\n    padding-bottom: 15px;\n    background: #F4F9FF;\n    display: none;\n    position: fixed;\n    top: 0;\n    left: 0;\n\n}\n\n.approve-hor .approve-title {\n    font-size: 1.5em;\n    font-weight: bold;\n    line-height: 50px;\n    float: left;\n    margin-right: 30px;\n}\n\n.approve-horizon-line {\n    border-top: solid 2px #cacaca;\n}\n\n.approve-textarea {\n    margin-left: 15px;\n}\n\n.approve-hor .approve-pass, .approve-hor .approve-pending {\n    float: left;\n}\n\n.approve-more .approve-bage:hover {\n    cursor: pointer;\n}\n\n.approve-popup {\n    margin-left: -29px;\n    background: #fff;\n    border: solid 1px #c0c0c0;\n    padding: 20px;\n    display: none;\n    position: absolute;\n    top: 63px;\n    left: 0;\n    width: 350px;\n    z-index: 9999;\n    margin-left: -30px;\n}\n\n.approve-left {\n    margin-top: 10px;\n    margin-bottom: -10px;\n    float: left;\n}\n\n.approve-ver .approve-pending .approve-vertical-line {\n    height: 0;\n}\n\n.approve-more .approve-bage {\n    line-height: 20px;\n}\n\n.approve-ver .row {\n\tmin-width: 300px;\n    padding-left: 10px;\n}\n\n/* .approve-person { */\n/* color: #32cd32; */\n/* overflow: hidden; */\n/* font-weight: bold; */\n/* margin-right: 10px; */\n/* white-space: nowrap; */\n/* font-style: normal; */\n/* display: inline-block; */\n/* text-overflow: ellipsis; */\n/* width: 84px; */\n/* } */\n\n\n.approve-action {\n    color: #000;\n    font-weight: bold;\n    font-style: normal;\n    margin-right: 10px;\n}\n\n.approve-note {\n    line-height: 13px;\n    overflow: hidden;\n    padding-top: 3px;\n    display: inline-block;\n    white-space: nowrap;\n    font-style: normal;\n    text-overflow: ellipsis;\n    width: 160px;\n    margin-top: 6px;\n    margin-left: 13px;\n\n}\n\n.approve-right {\n    padding-left: 0;\n    float: left;\n    /*portal端审批记录折行，去掉 min-width*/\n    /* min-width: 300px; */   \n}\n\n.approve-textarea-scale {\n    height: 45px;\n    width: 200px;\n}\n\n.approve-pending .approve-person {\n    color: #4169e1;\n    margin: 0 3px;\n    text-decoration: underline;\n    cursor: pointer;\n}\n\n.approve-hor .approve-content {\n    float: left;\n}\n\n.approve-hor .btn, .approve-hor textarea {\n\n    display: inline-block;\n}\n\n.approve-btn {\n    width: 80px;\n    height: 28px;\n}\n\n.approve-dopass-btn {\n    color: #01A3F6;\n}\n\n.approve-arrow-bottom {\n    position: absolute;\n    width: 0;\n    height: 0;\n    top: -40px;\n    left: 32px;\n    border: 20px solid #c0c0c0;\n    border-right-color: transparent;\n    border-left-color: transparent;\n    border-top-color: transparent;\n}\n\n.approve-arrow-bottom:after {\n    content: '\\00a0';\n    position: absolute;\n    width: 0;\n    height: 0;\n    border: 18px solid #fff;\n    right: -18px;\n    top: -17px;\n    border-right-color: transparent;\n    border-left-color: transparent;\n    border-top-color: transparent;\n}\n\n.approve-square-bottom {\n    position: absolute;\n    width: 37px;\n    height: 10px;\n    top: -1px;\n    left: 34px;\n    background: #fff;\n}\n\n"
