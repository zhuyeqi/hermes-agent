            "text": ".MyDiv_left{position: relative;float: left;width: 70%;height: 100%;overflow: hidden;}\r\n.preview_left{height: 100%;float: left;width: 10%;text-overflow:ellipsis;}\r\n.preview_right{float: left;height: 100%;width:90%;background-color: white;margin: auto;padding-left: 8px;padding-right: 8px;}\r\n.pleft-attach{display: inline-block;/* background:url(/mp/img/preview_attach.png) no-repeat 1px;background-size: 10px 14px; */color: #e5e5e5;font-size: 12px;}\r\n.pleft-content{padding: 9px 0px;}\r\n.preview_left a{margin-left: 20px;font-size:12px;color: #e5e5e5;text-decoration: none;vertical-align: middle;}\r\n.preview_left .select{color: #2a6496;}\r\n.click-preview{margin-top: 8px;white-space: nowrap;overflow: hidden;text-overflow: ellipsis;}\r\n.pleft-bill{width:100%;height:30px;background:url(/mp/img/bill-normal-01.svg) no-repeat;background:url(/mp/img/bill-normal-01.svg) no-repeat \\9\\0;background:url(/mp/img/bill-normal-01.png) no-repeat \\9;background-size: 16px 24px;cursor:pointer;margin-left: 3px;margin-top: 10px;color: white;}\r\n.pleft-bill-select{width:100%;height:30px;background:url(/mp/img/bill-press-01.svg) no-repeat;background:url(/mp/img/bill-press-01.svg) no-repeat \\9\\0;background:url(/mp/img/bill-press-01.png) no-repeat \\9;background-size: 16px 24px;background-color: white;cursor:pointer;margin-left: 3px;margin-top: 10px;color: #2a6496;}\r\n.attach-span{text-align: center;white-space: nowrap;}\r\n.pleft-excel{width:100%;height:24px;background:url(/mp/img/excel-normal-01.svg) no-repeat 1px;background:url(/mp/img/excel-normal-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/excel-normal-01.png) no-repeat 1px \\9;background-size: 15px 15px;cursor:pointer;color: white;}\r\n.pleft-excel-select{width:100%;height:24px;background:url(/mp/img/excel-press-01.svg) no-repeat 1px;background:url(/mp/img/excel-press-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/excel-press-01.png) no-repeat 1px \\9;background-size: 15px 15px;background-color: white;cursor:pointer;color: #2a6496;}\r\n.pleft-other{width:100%;height:24px;background:url(/mp/img/other-normal-01.svg) no-repeat 1px;background:url(/mp/img/other-normal-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/other-normal-01.png) no-repeat 1px \\9;background-size: 15px 15px;cursor:pointer;color: white;}\r\n.pleft-other-select{width:100%;height:24px;background:url(/mp/img/other-press-01.svg) no-repeat 1px;background:url(/mp/img/other-press-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/other-press-01.png) no-repeat 1px \\9;;background-size: 15px 15px;background-color: white;cursor:pointer;color: #2a6496;}\r\n.pleft-pdf{width:100%;height:24px;background:url(/mp/img/pdf-normal-01.svg) no-repeat 1px;background:url(/mp/img/pdf-normal-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/pdf-normal-01.png) no-repeat 1px \\9;background-size: 15px 15px;cursor:pointer;color: white;}\r\n.pleft-pdf-select{width:100%;height:24px;background:url(/mp/img/pdf-press-01.svg) no-repeat 1px;background:url(/mp/img/pdf-press-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/pdf-press-01.png) no-repeat 1px \\9;;background-size: 15px 15px;background-color: white;cursor:pointer;color: #2a6496;}\r\n.pleft-ppt{width:100%;height:24px;background:url(/mp/img/ppt-normal-01.svg) no-repeat 1px;background:url(/mp/img/ppt-normal-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/ppt-normal-01.png) no-repeat 1px \\9;background-size: 15px 15px;cursor:pointer;color: white;}\r\n.pleft-ppt-select{width:100%;height:24px;background:url(/mp/img/ppt-press-01.svg) no-repeat 1px;background:url(/mp/img/ppt-press-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/ppt-press-01.png) no-repeat 1px \\9;;background-size: 15px 15px;background-color: white;cursor:pointer;color: #2a6496;}\r\n.pleft-word{width:100%;height:24px;background:url(/mp/img/word-normal-01.svg) no-repeat 1px;background:url(/mp/img/word-normal-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/word-normal-01.png) no-repeat 1px \\9;background-size: 15px 15px;cursor:pointer;color: white;}\r\n.pleft-word-select{width:100%;height:24px;background:url(/mp/img/word-press-01.svg) no-repeat 1px;background:url(/mp/img/word-press-01.svg) no-repeat 1px \\9\\0;background:url(/mp/img/word-press-01.png) no-repeat 1px \\9;;background-size: 15px 15px;background-color: white;cursor:pointer;color: #2a6496;}\r\n.preview_bill_content{display: block;width: 100%;height: 100%;overflow-y: visible;overflow-x: auto;}\r\n.preview_bill_content table{font-size: 8px;}\r\n.preview_html{margin-left: 8px;}\r\n.preview_html table{font-size: 8px;}\r\n.preview_download{display: none;width:100%;height:100%;background:url(/mp/img/preview-notsupport.png) no-repeat;background-position: center;text-align: center;}\r\n.preview_download div{padding-top: 80%;}\r\n.preview_download a{color: #428bca;text-decoration: none;font-weight: bold;}\r\n.preview_download a:hover{text-decoration: none;}\r\n.preview_content{display:none;width: 100%;height: 100%;overflow-x: auto;overflow-y: visible;}\r\n.preview-controls{margin-left: 0px;}\r\n.preview-controls div{position: absolute;top:50%;width:40px;height: 80px;margin-top:-40px;margin-left:-9px; text-indent: -9999px;cursor:pointer;}\r\n.preview-previous{background:url(/mp/img/previous.png) no-repeat;}\r\n.preview-previous-hover{background:url(/mp/img/previous-hover.png) no-repeat;}\r\n.preview-next{background:url(/mp/img/next.png) no-repeat;right:0px;}\r\n.preview-next-hover{background:url(/mp/img/next-hover.png) no-repeat;right:0px;}\r\n.preview-loading{display: none;position: absolute;top:30%;left:35%;background:url(/mp/img/preview-loading.gif) no-repeat;width:400px;height: 300px;text-indent: -9999px;}\r\n.preview-error{color: red; margin-left: 20%; margin-right: 20%;text-align: left;}"
