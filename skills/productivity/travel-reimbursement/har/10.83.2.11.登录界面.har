        \t\tparent.checkLogin(XMLHttpRequest);\n                \t}else if(typeof top.checkLogin =='function'){\n                \t\ttop.checkLogin(XMLHttpRequest);\n                \t}\n                },\n                success:function(ret){\n                    if(typeof ret.status !== \"undefined\"){\n                        $.scojs_message(ret.msg, ret.status?$.scojs_message.TYPE_OK:$.scojs_message.TYPE_ERROR);\n                    }else{\n                        var data = _.extend({msgsystem: ret});\n                        that.SourceSystem=ret;\n                        $(\"nav\").find(\".sourcesystem\").empty();\n                        //$(\"nav\").prepend(that.msg_system_template(data));\n                    }\n                }\n            });\n\n        },\n\n        renderPagination:function(){\n            var that=this;\n            $(\".pagination\").empty();\n            if(app.msgs.length>0){\n                var paginator=this.page;\n                if(!paginator){\n                    var paginator = new  Backgrid.Extension.Paginator({\n                        collection: app.msgs,\n                        windowSize:5\n                    });\n                    this.page=paginator\n                }\n                $(\".pagination\").append(paginator.render().$el);\n            }\n        },\n\n        isHidden: function () {\n\t\t\tvar isCompleted = this.model.get('completed');\n\t\t\tif (!this.$el.hasClass('editing')) {\n\t\t\t\treturn;\n\t\t\t}\n\t\t},\n\n        // appending its element to the container.\n        addOne: function (todo) {\n            var view = new app.MsgItemView({ model: todo });\n            this.$el.append(view.render().el);\n//            if(window.scrollBottom){\n//            \twindow.scrollHeight+=$('article:last').height();\n//            \t$('.allcontent').scrollTop(window.scrollHeight);\n//            \t//window.scrollBottom;//在loadMoreResultsNew中被初始化 true 将滚动条滑动到底部\n//            }\n            //转换html实体字符\n           \n            var str = this.HTMLEncode($('#'+view.render().el.id).find('.p-excerpt1.excerpt-bg1 .preStyle').html());\n            if(!str){\n            \tstr=\"\";\n            }\n            $('#'+view.render().el.id).find('.p-excerpt1.excerpt-bg1').html(\"\").append($('<div class=\"preStyle\">'+str+'</div>'));\n            //任务添加title及显示部分信息\n            $('.normaltext').each(function(){\n            \tif($(this).html()){\n            \t\tvar orHtml = $(this).html();\n        \t\t\t$(this).attr('title',orHtml);\n        \t\t\tvar indexFlag,totalLength=0;\n            \t\tif($(this).html().length>18){\n            \t\t\tvar myReg = /^[\\u4e00-\\u9fa5]+$/;\n            \t\t\tfor(var i=0;i<orHtml.length;i++){\n            \t\t\t\tindexFlag = i;\n            \t\t\t\tif (myReg.test(orHtml.substring(i,i+1))) {//中文\n            \t\t\t\t\ttotalLength  = totalLength+2;\n                            }else{\n                            \ttotalLength  = totalLength+1;\n                            }\n            \t\t\t\tif(totalLength>36){\n            \t\t\t\t\t$(this).css('line-height','15px');\n            \t\t\t\t}\n            \t\t\t\tif(totalLength>=70){\n            \t\t\t\t\t$(this).html(orHtml.substring(0,indexFlag)+'...') ;\n            \t\t\t\t\tbreak;\n            \t\t\t\t}\n            \t\t\t}\n                        \n            \t\t\t\n            \t\t}\n            \t}\n            });\n            $('.keytext').each(function(){\n            \tif($(this).html()){\n            \t\tvar orHtml = $(this).html();\n        \t\t\t$(this).attr('title',orHtml);\n        \t\t\tvar indexFlag,totalLength=0;\n            \t\tif($(this).html().length>14){\n            \t\t\tvar myReg = /^[\\u4e00-\\u9fa5]+$/;\n            \t\t\tfor(var i=0;i<orHtml.length;i++){\n            \t\t\t\tindexFlag = i;\n            \t\t\t\tif (myReg.test(orHtml.substring(i,i+1))) {//中文\n            \t\t\t\t\ttotalLength  = totalLength+2;\n                            }else{\n     