            "mimeType": "application/x-javascript",
            "text": "var app = app || {};\n\n(function ($) {\n    'use strict';\n\n    var viewHelper = {\n        //notice mail note closed\n        msgType:function(msg){\n        \t\n            var ret='';\n            var msgtype=msg.msgtype;\n            if('TASK'===msgtype){\n                ret='notice';\n            }else if('notice'===msgtype){\n                ret='note';\n            }else {\n                ret='mail';\n            }\n            return ret;\n        },\n\n        currentStatus:function(msg){\n            var ret={status:'answered-accepted',name:msg.label||'未处理'};\n            var msgstatus=msg.msgstatus;\n            if('waitdeal'===msgstatus){\n                ret.status='answered-accepted';\n            }else if('dealed'===msgstatus){\n                ret.status='closed';\n                ret.name=msg.label||'已处理';\n            }\n            return ret;\n        },\n\n        //是否添加显示单据ActionCode\n        addBillActionBtn:function(msg){\n            var ret=false;\n            if(msg.showBill){\n                var showBillAction={pk_messageaction:'showBill',actioncode:'showBill',actionname:'单据'};\n                if(msg.actionlist){\n                    var hasshowBill=false;//avoid dup\n                    $(msg.actionlist).each(function(i,val){\n                        if('showBill'===val.actioncode){\n                            hasshowBill=true;\n                            return;\n                        }\n                    });\n                    if(!hasshowBill){\n                        msg.actionlist.unshift(showBillAction);\n                    }\n                    ret=true;\n                }\n            }\n            return ret;\n        },\n        //2014-09-29 11:20:00\n        dateTimeFromNow:function(msg){\n            var ret='最新';\n            var dateString=this.timeStamp2String(msg.extendattrobj.workflowInfo.commtTime);\n            if(!dateString){\n                return '';\n            }\n\n            var timeNow = new Date();\n            timeNow.setYear\t(parseInt(dateString.substr(0, 4), 10));\n            timeNow.setMonth   (parseInt(dateString.substr(5, 2), 10)-1);\n            timeNow.setDate    (parseInt(dateString.substr(8, 2), 10));\n            timeNow.setHours   (parseInt(dateString.substr(11, 2), 10));\n            timeNow.setMinutes (parseInt(dateString.substr(14, 2), 10));\n            timeNow.setSeconds (parseInt(dateString.substr(17, 2), 10));\n            //发送时间和当前时间差 的天数\n            var timemouse = Math.floor((new Date().getTime()-timeNow.getTime())/(24*3600*1000));\n            var nyear = new Date().getFullYear();\n            var nmon = new Date().getMonth()+1;\n            var nday = new Date().getDate();\n            \n            \n            var nowweek = new Date().getDay();\n            var numarray = ['日','一','二','三','四','五','六'];\n            var nyr = dateString.substring(0,10);\n                \n                if(nyear!=parseInt(dateString.substr(0, 4), 10)){\n                \treturn nyr;\n                }\n                if(nmon > parseInt(dateString.substr(5, 2), 10)){\n                \treturn nyr;\n                }\n                if(parseInt(dateString.substr(8, 2), 10)==nday){\n                \treturn dateString.substring(11,16);\n                }\n                \n                if(timemouse<31 && timemouse > 0){\n                    if(timemouse<nowweek){\n                    \tif(timemouse==1){\n                    \t\treturn '昨天';\n                    \t}else{\n                    \t\treturn '星期'+numarray[nowweek-timemouse];\n                    \t}\n                    }else{\n                    \treturn nyr;\n                    }\n                }else if(timemouse==0){\n                \tvar t = nday-parseInt(dateString.substr(8, 2), 10);\n                \tif(t!=0 && nowweek > 0){\n//                \t\treturn '星期'+numarray[nowweek-1];\n                \t\treturn '昨天';\n                \t}else{\n                \t\treturn dateString.substring(11,16);\n                \t}\n                \t\n                }else{\n                \treturn nyr;\n                }\n\n            return ret;\n\n        },\n        //将时间戳转化成 yyyy-MM-dd hh:mm:ss\n       timeStamp2String:function(time){\n            var datetime = new Date();\n            datetime.setTime(time);\n            var year = datetime.getFullYear();\n            var month = datetime.getMonth() + 1 < 10 ? \"0\" + (datetime.getMonth() + 1) : datetime.getMonth() + 1;\n            var date = datetime.getDate() < 10 ? \"0\" + datetime.getDate() : datetime.getDate();\n            var hour = datetime.getHours()< 10 ? \"0\" + datetime.getHours() : datetime.getHours();\n            var minute = datetime.getMinutes()< 10 ? \"0\" + datetime.getMinutes() : datetime.getMinutes();\n            var second = datetime.getSeconds()< 10 ? \"0\" + datetime.getSeconds() : datetime.getSeconds();\n            return year + \"-\" + month + \"-\" + date+\" \"+hour+\":\"+minute+\":\"+second;\n        },\n        timeofdealpeo:function(time){\n        var datetime = new Date();\n        datetime.setTime(time);\n        var year = datetime.getFullYear();\n        var month = datetime.getMonth() + 1 < 10 ? \"0\" + (datetime.getMonth() + 1) : datetime.getMonth() + 1;\n        var date = datetime.getDate() < 10 ? \"0\" + datetime.getDate() : datetime.getDate();\n        var hour = datetime.getHours()< 10 ? \"0\" + datetime.getHours() : datetime.getHours();\n        var minute = datetime.getMinutes()< 10 ? \"0\" + datetime.getMinutes() : datetime.getMinutes();\n        var second = datetime.getSeconds()< 10 ? \"0\" + datetime.getSeconds() : datetime.getSeconds();\n        var dateString= year + \"-\" + month + \"-\" + date+\" \"+hour+\":\"+minute+\":\"+second;\n        \n            var ret='最新';\n\n            var time = new Date();\n            var timeNow = new Date();\n            timeNow.setYear\t(parseInt(dateString.substr(0, 4), 10));\n            timeNow.setMonth   (parseInt(dateString.substr(5, 2), 10)-1);\n            timeNow.setDate    (parseInt(dateString.substr(8, 2), 10));\n            timeNow.setHours   (parseInt(dateString.substr(11, 2), 10));\n            timeNow.setMinutes (parseInt(dateString.substr(14, 2), 10));\n            timeNow.setSeconds (parseInt(dateString.substr(17, 2), 10));\n\n            var mseconds =  time- timeNow; //返回所有的毫秒数\n            if(mseconds>=0){\n                var min=parseInt(mseconds / (1000 * 60),10);\n                var hour=parseInt(min/60,10);\n                var day=parseInt(hour/24,10);\n                var mon=parseInt(day/31,10);\n                var year=parseInt(mon/12,10);\n\n                if(min<60){\n                    return min+'分钟前';\n                }\n                if(hour<24){\n                    return hour+'小时前';\n                }\n                if(day<31){\n                    return day+'天前';\n                }\n                if(mon<12){\n                    return mon+'月前';\n                }\n                return year+'年前';\n            }\n\n            return ret;\n\n        }\n    };\n\n    // Msg Item View\n    // --------------\n\n    // The DOM element for a Msg item...\n    app.MsgItemView = Backbone.View.extend({\n        //el wrap\n        tagName  : 'article',\n        attributes : function () {\n            return {\n                'class' : 'post',\n                id : this.model.get( 'pk_sourcemsg' )\n            };\n        },\n        // Cache the template function for a single item.\n        template: _.template($('#msg_item_template').html()),\n\n        AssignUser:_.template($('#msg_assignuser_template').html()),\n\n        AssignNode:_.template($('#msg_node_template').html()),\n        \n        workflowspjl:_.template($('#msg_workflowdealhis_template').html()),\n        \n        moreassignuser:_.template($('#assignusermore_template').html()),\n        \n        activityitem:_.template($('#msg_activityitem_template').html()),\n        \n        todoaction:_.template($('#msg_todoaction_template').html()),\n//        AssignUserNew:_.template($('#msg_assignusernew_template').html()),\n        // The DOM events specific to an item.\n            events: {\n            'click .destroy': 'clear',\n            'click .p-summary': 'aticve'\n        },\n\n        \t\n        initialize: function () {\n            this.listenTo(this.model, 'change', this.render);\n            this.listenTo(this.model, 'destroy', this.remove);\n        },\n\n        aticve:function(){\n            this.$el.addClass('article-active');\n        },\n\n        isMobileView:function(){\n            return  $('#msg_item_template').data('mobileview');\n        },\n        afterRender:function(){\n            var that=this;\n            //bind actionCode\n                var sourceSystem=this.model.get(\"jsPluginCode\");\n                var staticVersion=this.model.get(\"staticVersion\");\n                var link='js/mp-plugin/'+sourceSystem+'.js?_version='+staticVersion||'0';\n\n\n            if(typeof $[sourceSystem] ==='undefined'){\n                $.loadScriptAsync(link,function() {\n                    $[sourceSystem](that.$el,that,that.isMobileView())\n                })\n            }else{\n                $[sourceSystem](that.$el,that,that.isMobileView());\n            }\n\n            //附件控件\n            this.$el.find('.attch').hoverIntent(function () {\n//                var t =  $(this).find(\".attch\");\n                $(this).attchPopup(\"hide\");\n                $(this).attchPopup(\"show\");\n            }, function () {\n                var t =  $(this).find(\".attch\");\n                t.attchPopup(\"hide\");\n            });\n            this.$el.find('.attch').toggle(function () {\n            \t\t $(this).attchPopup(\"hide\");\n            \t\t $(this).attchPopup(\"show\");\n               \n            },function () {\n            \t $(this).attchPopup(\"hide\");\n            });\n\n            //展开阅读\n            this.$el.find('.p-excerpt').hide();\n            this.$el.find('.open-msg').click(function(e){\n                e.preventDefault();\n                if($(this).closest('.post').find('.p-excerpt').hasClass('q-highlight')){\n\t\t\t\tapp.msgs.get($(this).closest('.post').attr('id')).attributes.toOpen=false;\n                    $(this).closest('.post').find('.p-excerpt').fadeOut('slow');\n                    $(this).closest('.post').find('.p-excerpt').removeClass('q-highlight');\n                    $(this).closest('.post').find('.btn-first').show('slow');\n                }else{\n\t\t\t\tapp.msgs.get($(this).closest('.post').attr('id')).attributes.toOpen=true;\n                    $(this).closest('.post').find('.btn-first').hide('slow');\n                    $(this).closest('.post').find('.p-excerpt').fadeIn('slow');\n                    $(this).closest('.post').find('.p-excerpt').addClass('q-highlight');\n                }\n                $(this).closest('.post').find('.preview').toggleClass('preview-open');\n            });\n        },\n        // Re-render the titles of the\n        render: function () {\n            var data = _.extend({msg: this.model.toJSON()}, viewHelper);\n            var dval = JSON.parse(data.msg.extendattr);\n            if( data.msg.content!=null){\n            \tdata.msg.content = data.msg.content.replace(/(^\\s*)|(\\s*$)/g,'');\n            }\n            //data.msg.content = data.msg.content.replace(/(^\\s*)|(\\s*$)/g,'');\n            data.msg.extendattrobj = dval;\n            this.$el.html(this.template(data));\n            this.afterRender();\n            return this;\n        },\n        assingerSelector:function(nodeassignuser){\n            var data = _.extend({nodeAssignUser: nodeassignuser});\n            $(\"#point .ext-content\").empty().append(this.AssignUser(data));\n\n            $('.refUserMulti').multiselect({\n                buttonClass: 'btn btn-default form-control btn-justified',\n                buttonContainer: '<div class=\"btn-group \" style=\"width:100%\"/>',\n                filterPlaceholder: '搜索',\n                enableFiltering: true,\n                filterBehavior: 'both',\n                dropRight: true,\n                maxHeight: 200,\n                nonSelectedText:'请选择审批人'\n            });\n\n        },\n        assingerSelectornew:function(nodeAssignUser){\n\t        var data = _.extend({nodeAssignUser: nodeAssignUser});\n\t        $(\".assignpeo_middle\").empty().append(this.AssignUser(data));\n\t        //$('.people-tab').children().last().hide();\n\t        $('.people-tab > div').attr(\"class\",\"\");\n\t        $('.people-tab > div:eq(0)').attr(\"class\",\"checked\");\n\t        \n\t        var tid = $('.people-tab > div:eq(0)').attr(\"id\");\n\t        \n\t        $('.middlecontent').css('display','none');\n\t        $('.middlecontent[forkey=\"'+tid+'\"]').css('display','block');\n\t       \n\t    },\n\t    \n\t    workflowitem:function(workitem){\n\t    \n\t        var data = _.extend({workitem: workitem});\n\t        var parentbody = \"\";\n\n\t    \tif($('#isdealed').val()=='dealed'){\n\t    \t\tparentbody = $('body',window.parent.document);\n\t    \t}else{\n\t    \t\tparentbody = $('body');\n\t    \t}\n\t        \n\t        \n\t        if($('#isdealed').val() == 'dealed'){\n\t        \tparentbody.find('#page3>.bootstrap-tablediv').empty().append(this.activityitem(data));\n\t        }else{\n\t        \t $('#page3>.bootstrap-tablediv').empty().append(this.activityitem(data));\n\t        }\n\t       \n\n\t    },\n\t    \n\t    moreassignuserSelector:function(morenodeAssignUser){\n\t    \t\n\t        var data = _.extend({morenodeAssignUser: morenodeAssignUser});\n\t        var parentbody = \"\";\n\n\t    \tif($('#isdealed').val()=='dealed'){\n\t    \t\tparentbody = $('body',window.parent.document);\n\t    \t}else{\n\t    \t\tparentbody = $('body');\n\t    \t}\n\t        \n\t        \n\t        \n\t        $(\".people-tablediv\").empty().append(this.moreassignuser(data));\n\t        \n\t        $(\".people-tablediv\").each(function(){\n\t        \t $(this).find('.people-tab > div').attr(\"class\",\"\");\n\t        \t $(this).find('.people-tab > div:eq(0)').attr(\"class\",\"checked\");\n\t \t        \n\t \t        var tid = $(this).find('.people-tab > div:eq(0)').attr(\"id\");\n\t \t        \n\t \t       $(this).find('.moremiddlecontent').css('display','none');\n\t \t      $(this).find('.moremiddlecontent[forkey=\"'+tid+'\"]').css('display','block');\n\t        });\n\t        \n\t        \n\t        parentbody.find(\".people-tablediv\").empty().append(this.moreassignuser(data));\n\t        \n\t        parentbody.find(\".people-tablediv\").each(function(){\n\t\t        \t $(this).find('.people-tab > div').attr(\"class\",\"\");\n\t\t        \t $(this).find('.people-tab > div:eq(0)').attr(\"class\",\"checked\");\n\t\t \t        \n\t\t \t        var tid = $(this).find('.people-tab > div:eq(0)').attr(\"id\");\n\t\t \t        \n\t\t \t       $(this).find('.moremiddlecontent').css('display','none');\n\t\t \t      $(this).find('.moremiddlecontent[forkey=\"'+tid+'\"]').css('display','block');\n\t        });\n\t       \n\t    },\n        renderWorkFlowspjl:function(historyvo){\n        \n\n    \tvar parentbody = \"\";\n\n    \tif($('#isdealed').val()=='dealed'){\n    \t\tparentbody = $('body',window.parent.document);\n    \t}else{\n    \t\tparentbody = $('body');\n    \t}\n\t        if($('#isdealed').val() == 'dealed'){\n\t        \tvar data = _.extend({workflowsphis: historyvo},viewHelper);\n\t        \tparentbody.find(\"#workflowiera\").empty().append(this.workflowspjl(data));\n\t\t        var actions = historyvo.todo_action_info.actions;\n\t\t        var aa =  parentbody.find(\".tabcontent .tabhost\").find('a');\n\t\t        \n\t\t        var flagreject = false;\n\t\t        var flagreassign = false;\n\t\t        var flagaddApprove = false;\n\t\t        \n\t\t        for(var i=0;i < actions.length;i++){\n\t\t        \tif(actions[i].action_code=='reject'){\n\t\t        \t\tflagreject = true;\n\t\t        \t}\n\t\t        \tif(actions[i].action_code=='reassign'){\n\t\t        \t\tflagreassign = true;\n\t\t        \t}\n\t\t\t\t\tif(actions[i].action_code=='addApprove'){\n\t\t\t\t\t\tflagaddApprove = true;\n\t\t\t\t\t}\n\t\t        }\n\t\t        if(flagreject){\n\t\t        \taa.eq(2).show();\n\t\t        }else{\n\t\t        \taa.eq(2).hide();\n\t\t        }\n\t\t        if(flagreassign){\n\t\t        \taa.eq(3).show();\n\t\t        }else{\n\t\t        \taa.eq(3).hide();\n\t\t        }\n\t\t        if(flagaddApprove){\n\t\t        \taa.eq(4).show();\n\t\t        }else{\n\t\t        \taa.eq(4).hide();\n\t\t        }\n\t\t        var users = data.workflowsphis.todo_users;\n\t\t        \n\t\t        var userstr = \"\";\n\t\t        if(users!=null && users != undefined && users.length > 0){\n\t\t        \t for(var i=0;i < users.length;i++){\n\t\t        \t\t userstr=userstr+users[i].name+\"  \";\n\t\t        \t }\n\t\t        \t parentbody.find('.approve-content').html((data.workflowsphis.todo_activity==undefined?\"\":data.workflowsphis.todo_activity)+\"  \"+userstr+\"处理中\");\n\t\t        }\n\t\t       \n\t\t        \n\t        }else{\n\t        \tvar data = _.extend({workflowsphis: historyvo},viewHelper);\n\t\t        $(\"#workflowiera\").empty().append(this.workflowspjl(data));\n\t\t        var actions = historyvo.todo_action_info.actions;\n\t\t        var aa =  $(\".tabcontent .tabhost\").find('a');\n\t\t        var flagreject = false;\n\t\t        var flagreassign = false;\n\t\t        var flagaddApprove = false;\n\t\t        \n\t\t        for(var i=0;i < actions.length;i++){\n\t\t        \tif(actions[i].action_code=='reject'){\n\t\t        \t\tflagreject = true;\n\t\t        \t}\n\t\t        \tif(actions[i].action_code=='reassign'){\n\t\t        \t\tflagreassign = true;\n\t\t        \t}\n\t\t\t\t\tif(actions[i].action_code=='addAp