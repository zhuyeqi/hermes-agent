attr('data-value');\r\n\t\t\t\t\t\t\tvar $item=$('#'+itemId+' .refer-value');\r\n\t\t\t\t\t\t\tvar itemkey=$item.attr('data-itemkey');\r\n\t\t\t\t\t\t\tvar itemType=$item.attr('data-type');\r\n\t\t\t\t\t\t\t//后端解析系统函数\r\n\t\t\t\t\t\t\tif (that.isSysFun(itemValue)) {\r\n\t\t\t\t\t\t\t\tvar itemSysFun=that.sysfuncache[itemId];\r\n\t\t\t\t\t\t\t\tif(itemSysFun){\r\n\t\t\t\t\t\t\t\t\tthat.setSysFun(itemSysFun);\r\n\t\t\t\t\t\t\t\t}else{\r\n\t\t\t\t\t\t\t\t\treferSysFns.push({itemid:itemId,itemtype:itemType,sysfunckey:itemValue});\r\n\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\r\n\t\t\t\t\t$.ajax({ \r\n\t\t\t\t\t\t\ttype: \"post\", \r\n\t\t\t\t\t\t\turl: that.ctx+\"/querysysfunc/convertSysFun\",\r\n\t\t\t\t\t\t\tdata: {'sysfunckeys':JSON.stringify(referSysFns)},\r\n\t\t\t\t\t\t\tasync : true,\r\n\t\t\t\t\t\t\tdataType: \"json\" ,\r\n\t\t\t\t\t\t\tbeforeSend:function(XMLHttpRequest){\r\n\t\t\t\t\t\t\t\tif(typeof checkLogin =='function'){\r\n\t\t\t                \t\tcheckLogin(XMLHttpRequest);\r\n\t\t\t                \t}else if(typeof parent.checkLogin =='function'){\r\n\t\t\t                \t\tparent.checkLogin(XMLHttpRequest);\r\n\t\t\t                \t}else if(typeof top.checkLogin =='function'){\r\n\t\t\t                \t\ttop.checkLogin(XMLHttpRequest);\r\n\t\t\t                \t}\r\n\t\t\t\t            },\r\n\t\t\t\t\t\t\tsuccess: function(result) {\r\n\t\t\t\t\t\t\t\t $.each(result,function(i,v){\r\n\t\t\t\t\t\t\t\t \tthat.sysfuncache[v.itemid]=v;\r\n\t\t\t\t\t\t\t\t \tthat.setSysFun(v);\r\n\t\t\t\t\t\t\t\t });\r\n\t\t\t\t\t\t\t   }\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\tquery.initBillTypeRefer=function(){\r\n\t\t\t\treturn;\r\n\t\t\t\tvar $pop = $('.pop');\r\n\t\t\t\tvar $valuelist = $('.valueList li span');\r\n\t\t\t\t\tvar that=this;\r\n\t\t\t\t\tvar refers = this.wrap.find(\"#allbilltype\");\r\n\t\t\t\t\trefers.each(function(i,val){\r\n\t\t\t\t\t\tvar ele = $(this)\r\n\t\t\t\t\t\tvar qItem=$(this).closest('.queryAreaItem');\r\n\t\t\t\t\t\tvar contentId='BillType'+qItem.attr(\"id\");\r\n\t\t\t\t\t\tvar refContainer='#'+contentId.replace(/[^\\w\\s]/gi, '\\\\$&'); \r\n\t\t\t\t\t\t$('body').append($('<div>').attr('id',contentId)); \r\n\t\t\t\t\t\tvar refInput=$('.refer-ext .pop'); \r\n\t\t\t\t\t\tvar $contentEle=$(refContainer); \r\n\t\t\t\t\t\tvar data=app.msgs.allcommonbilltype; \r\n\t\t\t\t\t\t$(refContainer).Refer({ \r\n\t\t\t\t\t\t\t\tctx:window.ctx, \r\n\t\t\t\t\t\t\t\tdata:data, \r\n\t\t\t\t\t\t\t\trefInput:refInput, \r\n\t\t\t\t\t\t\t\tisBillType:false, \r\n\t\t\t\t\t\t\t\t\"refName\":\"币种档案\", \r\n\t\t\t\t\t\t\t\twrapRefer:{ \r\n\t\t\t\t\t\t\t\t\tcontentEle:$contentEle,// 参照容器的el\r\n\t\t\t\t\t\t\t\t\tcontentId:contentId,// 参照的id\r\n\t\t\t\t\t\t\t\t\tsetVal: function(data) { \r\n\t\t\t\t\t\t\t\t\t\tif (data) { \r\n\t\t\t\t\t\t\t\t\t\t\tvar options=$(refContainer).Refer('getOptions'); \r\n\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\tvar pk = $.map(data,function(val, index) { \r\n\t\t\t\t\t\t\t\t\t\t\t\treturn val.refpk \r\n\t\t\t\t\t\t\t\t\t\t\t}).join(','); \r\n\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\tvar name = $.map(data,function(val, index) { \r\n\t\t\t\t\t\t\t\t\t\t\t\treturn val.refname \r\n\t\t\t\t\t\t\t\t\t\t\t}).join(','); \r\n\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\tvar code=$.map(data,function(val, index) { \r\n\t\t\t\t\t\t\t\t\t\t\t\treturn val.refcode \r\n\t\t\t\t\t\t\t\t\t\t\t}).join(','); \r\n\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\tif(name){\r\n\t\t\t\t\t\t\t\t\t\t\t\t$pop.html(name);\r\n\t\t\t\t\t\t\t\t\t\t\t\t$pop.attr('class','pop selected');\r\n\t\t\t\t\t\t\t\t\t\t\t\t$pop.attr('data-code',code);\r\n\t\t\t\t\t\t\t\t\t\t\t\t$pop.parent().prev().find('span.selected').css('color','#005aa0');\r\n\t\t\t\t\t\t\t\t\t\t\t\t$pop.parent().prev().find('span').attr('class','');\r\n\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\t\t\r\n\t\t\t\t\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\t\t\t\t\t//$that.html(options.isReturnCode?code:name); \r\n\t\t\t\t\t\t\t\t\t\t} \r\n\t\t\t\r\n\t\t\t\t\t\t\t\t\t}, \r\n\t\t\t\t\t\t\t\t} \r\n\t\t\t\t\t\t}); \r\n\t\t\t\t\t   $valuelist.unbind('click').bind('click',function(){\r\n                  \t\t  var valueList = $(this).parent().parent();\r\n                      \t  valueList.find('span').each(function(){\r\n                      \t\t  $(this).attr('class','');\r\n                      \t\t  $(this).css('color','#005aa0');\r\n                      \t  });\r\n                      \t  \r\n                      \t  $(this).attr('class','selected');\r\n                      \t  $(this).css('color','#fff');\r\n                      \t  $('.pop.selected').html('更多');\r\n                      \t  $('.pop.selected').attr('class','pop');\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\r\n             \t\t });\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t\t\r\n\t\t\t\t};\r\n\t\t\t \r\n\t\t\t\tquery.buildQueryModel=function(){\r\n\t\t\t\t\tvar that=this;\r\n\t\t\t\t\tvar queryModel={};\r\n\t\t\t\t\tvar queryitems=[];\r\n\t\t\t\t\t\r\n\t\t\t\t\tqueryModel.beanID = this.wrap.attr(\"data-beanid\");\r\n\t\t\t\t\tvar selections = this.wrap.find(\".selectionContainer .active .selections\");\r\n\t\t\t            selections.find(\"span.ss-item:not(.clear-all)\").each(function(){\r\n\t\t\t\t\t\tvar $this=$(this);\r\n\t\t\t\t\t\tvar itemId=$this.attr('data-id');\r\n\t\t\t\t\t\tvar $item=$('#'+itemId+' .refer-value');\r\n\t\t\t\t\t\tvar itemkey=$item.attr('data-itemkey');\r\n\t\t\t\t\t\tvar itemType=$item.attr('data-type');\r\n\t\t\t\t\t\tvar returnType=$item.attr('data-returnType');\r\n\t\t\t\t\t\tvar operaCode = $item.attr('data-operacode');\r\n\t\t\t\t\t\tvar itemLabel=$item.attr('data-label');\r\n\t\t\t\t\t\tvar itemName= $this.attr('data-name');\r\n\t\t\t\t\t\tvar itemValue=$this.attr('data-value');\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tvar defaultOperaCode=that.getDefaultOperaCode(operaCode);\r\n\t\t\t\t\t\tvar referValues=[];\r\n\t\t\t\t\t\t//参照=5 枚举=6\r\n\t\t\t\t\t\tif((itemType==='5' || itemType==='6' ) && itemValue.length > 0){\r\n\t\t\t\t\t\t\tvar itemCode='';\r\n\t\t\t\t\t\t\tif(itemType==='5'){\r\n\t\t\t\t\t\t\t\titemCode=$this.attr('data-code');\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t\tvar itemCodes=itemCode.split(',');\r\n\t\t\t\t\t\t\tvar itemNames=itemName.split(',');\r\n\t\t\t\t\t\t\tvar itemValues=itemValue.split(',');\r\n\t\t\t\t\t\t\t$.each(itemValues,function(i,v){\r\n\t\t\t\t\t\t\tvar referValue={};\r\n\t\t\t\t\t\t\t\treferValue.pk=v;\r\n\t\t\t\t\t\t\t\treferValue.code=itemCodes[i];\r\n\t\t\t\t\t\t\t\treferValue.name=itemNames[i];\r\n\t\t\t\t\t\t\t\treferValues.push(referValue);\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t}\r\n\t\t\t\t\t\tqueryitems.push({\r\n\t\t\t\t\t\t\t'itemType':itemType,\r\n\t\t\t\t\t\t\t'returnType':returnType,\r\n\t\t\t\t\t\t\t'operaCode':defaultOperaCode,\r\n\t\t\t\t\t\t\t'itemKey':itemkey,\r\n\t\t\t\t\t\t\t'itemName':itemLabel,\r\n\t\t\t\t\t\t\t'itemValue':itemValue,\r\n\t\t\t\t\t\t\t'referValue':referValues\r\n\t\t\t\t\t\t\t});\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\tqueryModel.queryItems=queryitems;\r\n\t\t\t\t\t\t\t\r\n\t\t\t\t\treturn queryModel;\r\n\t\t\t\t};\r\n\t\t\t\t\r\n\t\t\t\tquery.bindEvent = function(){\r\n\t\t\t\t\tvar that=this;\r\n\t\t\t\t\tvar selectionContainer = that.wrap.find(\".selectionContainer\");\r\n\t\t\t\t\t\r\n\t\t\t\t    that.wrap.find('.query-btn').on('click',function(){\r\n\t\t\t\t\tvar selections = query.wrap.find(\".selections\");\r\n\t\t\t\t\tvar mustItemId=[],currItemID;\r\n\t\t\t\t\t\tquery.wrap.find('.refer-value[data-ifMust=\"true\"]').each(function(){\r\n\t\t\t\t\t\t\tmustItemId.push($(this).closest('.queryAreaItem').attr('id'));\r\n\t\t\t\t\t\t});\r\n\t\t\t\t\t\t\r\n\t\t\t\t\t\t$.each(mustItemId,function(i,v){\r\n\t\t\t\t\t\t\tif(selections.find('span.ss-item[data-id=\"'+v+'\"]:not(.hide)').length===0){\r\n\t\t\t\t\t\t\t\tcurrItemID=v;\r\n\t\t\t\t\t\t\t\treturn false;\r\n\t\t\t\t\t\t\t}\r\n\t\t\t\t\t\t});\r\n\t\t\t        \t\r\n\t\t\t\t\tif(currItemID){\r\n\t\t\t\t\t\tvar msg=$('#'+currItemID+' .refer-value').attr('data-label')+' 是必输项 ！';\r\n\t\t\t\t\t\t$.scojs_message(msg, $.scojs_message.TYPE_WARN);\r\n\t\t\t\t\t\treturn;\r\n\t\t\t\t\t}\t\r\n\t\t\t\t\tvar queryModel=query.buildQueryModel();\r\n\t\t\t\t\tcompevent.fire('main.query',this,JSON.stringify(queryModel));\r\n\t\t\t\t});\r\n\t\t\t\t\r\n\t\t\t  };\r\n\t\t\t\t\r\n\t\t\tquery.init();\r\n\t\t\tquery.initDate();\r\n\t\t\tquery.initBillTypeRefer();\r\n\t\t\tquery.initDefaultValue();\r\n//\t\t\tquery.tranSysFun();\r\n\t\t\tquery.bindEvent();\r\n });  \r\n"
