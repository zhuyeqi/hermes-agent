            "mimeType": "application/x-javascript",
            "text": "/*global Backbone */\nvar app = app || {};\n\n(function () {\n    'use strict';\n   \n    var Msgs = Backbone.PageableCollection.extend({\n        // Reference to this collection's model.\n        model: app.MSG,\n        url:'/mp/msg/msgs',\n\n        mode: \"server\",\n        state: {\n            pageSize: 5,\n            currentPage:1\n        },\n        queryParams: {\n            _timestamp:function(){return new Date().getTime()},\n            msgStatus:function(){  return app.params.msgStatus},\n            msgDate:function(){ \n            \tif(app.params.msgDate){\n            \t\tvar str = app.params.msgDate.replace(/-/g,'/'); \n            \t\treturn new Date(str).getTime()+'';\n            \t}\n            \t \n            \treturn '';\n            },\n            msgType:function(){ return app.params.msgType},\n            msgSystem:function(){ return app.params.msgSystem},\n            msgSearch:function(){ return app.params.msgSearch},\n            billtype:function(){ return app.params.billtype},\n            seachSender:function(){ return app.params.seachSender},\n            endtime:function(){ \n            \tif(app.params.endtime){\n            \t\tvar str = app.params.endtime.replace(/-/g,'/'); \n            \t\treturn new Date(str).getTime()+'';\n            \t}\n            \treturn '';\n            },\n            starttime:function(){ \n            \tif(app.params.starttime){\n            \t\tvar str = app.params.starttime.replace(/-/g,'/'); \n            \t\treturn new Date(str).getTime()+'';\n            \t}\n            \treturn '';\n            },\n            billtypecache:function(){ return app.params.billtypecache},\n            refreshFlag:function(){ return app.params.refreshFlag},\n            beforedays:function(){ return app.params.beforedays}\n        },\n        parseState: function (resp, queryParams, state, options) {\n//        state.totalPages=10;\n        if(resp.total!=undefined && resp.total>0 && state.totalRecords!=undefined && state.totalRecords>0){\n        \tif(resp.total>state.totalRecords){\n        \t\tstate.totalRecords=resp.total;\n        \t\tstate.totalPages=Math.floor(resp.total/state.pageSize)+1;\n        \t\tstate.lastPage=state.totalPages;\n        \t}\n        }\n        \tif( app.params.refreshFlag == true || app.params.refreshFlag == undefined){\n        \t\tapp.params.refreshFlag = false;\n        \t}\n        \t\n        \tif(window.refreshFlag == true || window.refreshFlag==undefined){\n        \t\t //$(\"#task_tab_item\").html(resp.total);\n        \t\t window.refreshFlag = false;\n        \t}\n        \t       \t\n        \tif(resp.total<=state.pageSize || (state.currentPage!=undefined &&  state.totalPages!=undefined && state.currentPage==state.totalPages)){\n        \t\t$('.toselectmore').hide();\n        \t}\n            return {totalRecords: resp.total};\n        },\n\n        // get the actual records\n        parseRecords: function (resp, options) {\n            if(resp.status){\n                return resp.data;\n            }else{\n                var msg=resp.msg||'获取消息异常';\n                $.scojs_message(msg, $.scojs_message.TYPE_ERROR);\n            }\n        },\n\n        search : function(letters){\n            if(letters == \"\") return this;\n\n            var pattern = new RegExp(letters,\"gi\");\n            return _(this.fullCollection.filter(function(data) {\n                return pattern.test(data.get(\"subject\"));\n            }));\n        }\n\n    });\n    window.pending = true;\n    window.morepending = true;\n    // Create our global collection of **Msgs**.\n    app.msgs = new Msgs();\n    \n})();"
          },
