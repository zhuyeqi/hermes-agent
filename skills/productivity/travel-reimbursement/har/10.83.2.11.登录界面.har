            "mimeType": "application/x-javascript",
            "text": "/*global Backbone, jQuery, _, ENTER_KEY */\nvar app = app || {};\n\n(function ($) {\n    'use strict';\n    var viewHelper = {\n        \ttimeStamp2String : function(time){\n        \t\tif(!time){\n        \t\t\treturn'';\n        \t\t}\n    \t\t    var datetime = new Date();\n    \t\t    datetime.setTime(time);\n    \t\t    var year = datetime.getFullYear();\n    \t\t    var month = datetime.getMonth() + 1 < 10 ? \"0\" + (datetime.getMonth() + 1) : datetime.getMonth() + 1;\n    \t\t    var date = datetime.getDate() < 10 ? \"0\" + datetime.getDate() : datetime.getDate();\n    \t\t    var hour = datetime.getHours()< 10 ? \"0\" + datetime.getHours() : datetime.getHours();\n    \t\t    var minute = datetime.getMinutes()< 10 ? \"0\" + datetime.getMinutes() : datetime.getMinutes();\n    \t\t    var second = datetime.getSeconds()< 10 ? \"0\" + datetime.getSeconds() : datetime.getSeconds();\n    \t\t    return year + \"-\" + month + \"-\" + date+\" \"+hour+\":\"+minute+\":\"+second;\n        \t}\n    };\n\n    // The Application\n    // ---------------\n    app.AppView = Backbone.View.extend({\n        //  present in the HTML.\n        el: '#container',\n\n        mask:'#content',\n\n        msg_type_template:_.template($('#msg_type_template').html()),\n\n        msg_system_template:_.template($('#msg_system_template').html()),\n        \n        task_tab_template:_.template($('#task_tab_template').html()),\n        \n        notice_tab_template:_.template($('#notice_tab_template').html()),\n        \n        alert_tab_template:_.template($('#alert_tab_template').html()),\n\n        publicarea:_.template($('#msg_area_template').html()),\n        \n        msg_item_template:_.template($('#msg_item_template').html()),\n        \n        notice_detail_template:_.template($('#notice_detail_template').html()),\n        \n        alert_detail_template:_.template($('#alert_detail_template').html()),\n\n        // Delegated events for  items\n        events: {\n            'click article': 'clearActive',\n        },\n\n        initialize: function () {\n            var urlParams=$.urlParam();\n            //单条消息无需类型\n            if(typeof urlParams['signature']==='undefined'){\n            \t\n                this.renderMsgType();\n               \n                this.renderMsgSourceSystem();\n               \n                if($('#isdealed').val()=='dealed'){\n                \tthis.rendBillTypeMore();\n                \tthis.renderCommonBillType();\n                }else{\n                \tthis.renderbilltype();\n                \tthis.renderEvents();\n                }\n                if(!$.isMobile()){\n                    this.renderUser();\n                }\n\n                this.renderCustomer();\n//                this.renderSearch();\n\n                urlParams.msgType=$('.head-nav li.current').data('type');\n                urlParams.msgSystem=$('.sub-tab a.checked').data('type');\n                urlParams.msgStatus=$('input[name=dealstatus]').val();\n                \n                if($('.valueList').length!=0){\n                \t urlParams.msgStatus=$('#status').find('.valueList span.selected').attr('data-code');\n                }\n               \n                urlParams.msgDate='';\n                urlParams.msgSearch='';\n                \n            }\n            // 首次加载设置为true，保证加载到最新数据\n            urlParams.refreshFlag = true;\n            \n            this.listenTo(app.msgs, 'reset', this.addAll);\n            this.listenTo(app.msgs, 'pullpush', this.loadMoreResults);\n            this.listenTo(app.msgs, 'pullpushnew', this.loadMoreResultsNew);\n            this.listenTo(app.msgs, 'filter', this.filterAll);\n            this.listenTo(app.msgs, 'remove', this.render);\n            this.listenTo(app.msgs, 'add', this.render);\n            this.listenTo(app.msgs, 'beforeFetch', this.showLoader);\n            this.listenTo(app.msgs, 'refrash', this.renderRefrashCountMsg);\n            this.listenTo(app.msgs, 'senderInit', this.loadSenderInfo);\n            this.listenTo(app.msgs, 'loadallbilltype', this.loadallbilltype);\n            this.listenTo(app.msgs, 'refrashTaskItem', this.refrashTaskItemMsg);\n            this.listenTo(app.msgs, 'getNewMessages', this.getNewMessages);\n            this.listenTo(app.msgs, 'renderbilltype', this.renderbilltype);\n            this.listenTo(app.msgs, 'showMsgForPortal', this.showMsgForPortal);\n            this.listenTo(app.msgs, 'refrashIndexTask', this.refrashIndexTaskArea);\n            \n            \n            app.params=urlParams;\n            \n            app.msgs.fetch({dataType:'json',reset: true,data: (urlParams)});\n            //tab init msg count\n            /*this.renderTaskTabCountMsg();\n            this.renderNoticeTabCountMsg();\n            this.renderAlertTabCountMsg();*/\n        },\n\n        loadMoreResults: function (pullOrpush,refreshUI,iscroll) {\n               if(pullOrpush&&app.msgs.hasNextPage()){\n                   app.msgs.state.currentPage+=1;\n                   app.msgs.fetch({\n                       remove: false,\n                       silent:true,\n                       beforeSend:function(XMLHttpRequest){\n                    \t   if(typeof checkLogin =='function'){\n                       \t\tcheckLogin(XMLHttpRequest);\n                       \t}else if(typeof parent.checkLogin =='function'){\n                       \t\tparent.checkLogin(XMLHttpRequest);\n                       \t}else if(typeof top.checkLogin =='function'){\n                       \t\ttop.checkLogin(XMLHttpRequest);\n                       \t}\n                       },\n                       success: function (msgs) {\n                           $(app.appview.mask).toggleClass('loader');\n                           msgs.each(app.appview.addOne, app.appview);\n                           refreshUI.call(iscroll);\n                       }\n                   });\n               }else  {\n                   refreshUI.call(iscroll);\n                   $.scojs_message(\"没有更多消息了\", $.scojs_message.TYPE_WARN);\n               }\n\n        },\n        loadMoreResultsNew: function (pullOrpush,refreshUI,iscroll) {\n        \t//任务点击更多获取查询条件\n        \tvar msgStatus=\"\";\n            var billtypecachespan = $('.burright.billtype .buritem.selected');\n            var billtypecache='';\n            if(billtypecachespan.attr('ifwaittype')==1){\n            \tbilltypecache = $.trim($('.burright.billtype .buritem.selected').attr('data-code'));\n            }\n            \n            var billtype=\"\";\n            $('.valueList > span.selected').html();\n            var seachSender=\"\";\n            var endtime=\"\";\n            var starttime=\"\";\n            var beforedays=\"\";\n            var billtype=\"\";\n            var billno=\"\";\n            var billID=\"\";\n            var billstr=\"\";\n            var searchstr=\"\";\n            if($('#isdealed').val()=='dealed'){//当前页面是任务更多页面\n            \tif($('#themename').attr('placeholder')==$('#themename').val()){\n            \t\tsearchstr==\"\";\n            \t}else{\n            \t\tsearchstr = $('#themename').val()==\"\"?\"\": $('#themename').val();\n            \t}\n            \t/*endtime = $('#endtime').val();\n            \tstarttime = $('#starttime').val();\n            \tseachSender = $('#senderInput').attr('data-code')==undefined?$('#senderInput').val():$('#senderInput').attr('data-code');\n            \t*/\n            \tif($('#starttime').attr('placeholder')==$('#starttime').val()){\n            \t\tstarttime==\"\";\n            \t}else{\n            \t\tstarttime = $('#starttime').val()==\"\"?\"\": $('#starttime').val();\n            \t}\n            \tif($('#endtime').attr('placeholder')==$('#endtime').val()){\n            \t\tendtime==\"\";\n            \t}else{\n            \t\tendtime = $('#endtime').val()==\"\"?\"\": $('#endtime').val();\n            \t}\n            \tif($('#senderInput').attr('placeholder')==$('#senderInput').val()){\n            \t\tseachSender==\"\";\n            \t}else{\n            \t\tseachSender = $('#senderInput').attr('data-code')==undefined?$('#senderInput').val():$('#senderInput').attr('data-code');\n            \t}\n            \tmsgStatus = $('#status').find('.valueList span.selected').attr('data-code');\n            \tvar billspan=$('#allbilltype .valueList li span.selected');\n                if(billspan!=null && billspan.length>0){\n                \tbilltype = billspan.parent().attr('data-code')\n                }else if(1){\n                \tbilltype = $('.pop.selected').attr('data-code')==undefined?\"\":$('.pop.selected').attr('data-code');\n                }\n            \t\n            }else{\n            \tmsgStatus = $('.burcontent.dealstatus .buritem.selected').attr('data');\n            \tbeforedays=$('.burcontent.time .buritem.selected').attr('data');\n            \tbilltype = $('.burright.billtype .buritem.selected').attr('data-code');\n            \tif($('.task-input-search').val()==$('.task-input-search').attr('placeholder')){\n            \t\tsearchstr==\"\";\n            \t}else{\n            \t\tsearchstr = $('.task-input-search').val();\n            \t\tif(searchstr!=\"\"){\n            \t\t\trefreshFlag=true;\n            \t\t}\n            \t}\n            \tbilltypecache = msgStatus!='waitdeal'?'':billtypecache;\n            \t//如果是二维码检索\n            \tif($('#tasksearchhidd').val()!=''){\n                \tbillstr=JSON.parse($('#tasksearchhidd').val());\n                \tbilltype = billstr.billtype;\n                \tbillno = billstr.billno;\n                \tbillID=billstr.billid;\n                \tmsgStatus=\"all\";\n                \tsearchstr = \"\";\n                \t$('#tasksearchhidd').val('');\n            \t}\n            }\n            \n            var params={\n                    msgStatus:msgStatus,\n                    msgDate:starttime,\n                    beforedays:beforedays,\n                    msgType:\"\",//默认是 task\n                    msgSystem:\"\",//目前不区分是否那个系统\n                    refreshFlag:refreshFlag,\n                    billtypecache:billtypecache?encodeURI(encodeURI(billtypecache)):'',\n                    msgSearch:searchstr?encodeURI(encodeURI(searchstr)):'',\n                    seachSender:seachSender,\n                    \tendtime:endtime,\n                       starttime:starttime,\n                       billtype:billtype?encodeURI(encodeURI(billtype)):'',\n                       billno:billno,\n                       billID:billID,\n                };\n            if(this.filterParam){\n                params= $.extend(params,this.filterParam);\n            }\n            app.params=params;\n            \n//        \twindow.scrollBottom = false;//滚动条是否滑到最底\n//        \twindow.scrollHeight = lastHeight;//滚动条向下滑动的高度\n        \tif(!app.msgs.hasNextPage()){\n        \t\t$(\".toselectmore\").hide();\n        \t}else{\n        \t\t$(\".toselectmore\").show();\n        \t}\n            if(pullOrpush&&app.msgs.hasNextPage()){\n                app.msgs.state.currentPage+=1;\n                app.msgs.fetch({\n                    remove: false,\n                    silent:true,\n                    beforeSend:function(XMLHttpRequest){\n                    \tif(typeof checkLogin =='function'){\n                    \t\tcheckLogin(XMLHttpRequest);\n                    \t}else if(typeof parent.checkLogin =='function'){\n                    \t\tparent.checkLogin(XMLHttpRequest);\n                    \t}else if(typeof top.checkLogin =='function'){\n                    \t\ttop.checkLogin(XMLHttpRequest);\n                    \t}\n    \t            },\n                    success: function (msgs) {\n                    \t$(app.appview.mask).toggleClass('loader');\n                        var models = msgs.models;\n                        var length = msgs.length;\n                        msgs.models = msgs.models.slice((msgs.state.currentPage-1)*msgs.state.pageSize)\n//                      msgs.length = msgs.models.length;\n                        msgs.each(app.appview.addOne, app.appview);\n                        msgs.models = models;\n                        msgs.length = length;\n                    }\n                });\n            }else  {\n//                refreshUI.call(iscroll);\n//                $.scojs_message(\"没有更多消息了\", $.scojs_message.TYPE_WARN);\n            }\n     },\n        clearActive:function(e){\n            var activeArticle= $(e.target).parents().closest('article');\n\n            this.$el.find('.article-active').each(function(){\n                var article=$(this);\n                if(article.attr('id')!==activeArticle.attr('id'))\n                    article.removeClass('article-active');\n            });\n        },\n\n        // Re-rendering the App just means refreshing the statistics -- the rest\n        // of the app doesn't change.\n        showLoader:function(){\n//            this.$el.html('');\n            $(\".pagination\").empty();\n            $(this.mask).toggleClass('loader');\n        },\n        render: function (e) {\n        \tif(window.unclear){\n        \t \treturn;\n        \t}\n            this.$el.html('');\n            app.msgs.each(this.addOne, this);\n            this.renderPagination();\n        },\n\n        renderUser:function(){\n            var that=this;\n            $.ajax({\n                url: \"/mp/user\",\n                type:'GET',\n                dataType: 'json',\n                cache:false,\n                async:true,\n                beforeSend:function(XMLHttpRequest){\n                \tif(typeof checkLogin =='function'){\n                \t\tcheckLogin(XMLHttpRequest);\n                \t}else if(typeof parent.checkLogin =='function'){\n                \t\tparent.checkLogin(XMLHttpRequest);\n                \t}else if(typeof top.checkLogin =='function'){\n                \t\ttop.checkLogin(XMLHttpRequest);\n                \t}\n\t            },\n                success:function(ret){\n                    if(!ret.status){\n                        $.scojs_message(ret.msg, ret.status?$.scojs_message.TYPE_OK:$.scojs_message.TYPE_ERROR);\n                    }else{debugger;\n                    \t//单点登陆时，cookie中没有数据\n                    \t$.cookie('mp_name',ret.usercode);\n                    \t$(\"#usernamehidd\").val(ret.usercode);\n                        $(\"a.userinfo\").prepend(\"<span>\"+ret.username+\"</span>\");\n                        //更新姓名下拉框信息\n                        $(\"#usernameli\").prepend(ret.usercode);\n                        $(\"#nameli\").prepend(ret.username);\n                        $(\"#emailli\").prepend(ret.email);\n                        //更新姓名隐藏框\n                        $(\"#usernamehidd\").val(ret.username);\n                    }\n                }\n            });\n        },\n\n        renderCustomer:function(){\n            $(\"#customerfilter\").bind('click', function (e) {\n                var that=$(this);\n                var parent=that.parent();\n                var popover=that.next();\n\n                var popovery = 22+that.get(0).offsetTop, popoverx =that.get(0).offsetLeft-110;\n                  popover.css({top: popovery, left: popoverx}).toggle();\n\n                var btnOk= popover.find('.btn-ok');\n                var btnCancel= popover.find('.btn-cancel');\n\n                btnCancel.off('click').bind('click',function(){\n                    popover.hide();\n                });\n\n                btnOk.off('click').bind('click',function(){\n                    var status=popover.find('input[name=dealstatus]').val();\n                    var form_date=popover.find('input[name=form_date]').val();\n                    var param={msgStatus:status,msgDate:form_date};\n\n                    if('dealed'===status){\n                        $('#customerfilter').html('已处理');\n                    }else{\n                        $('#customerfilter').html('未处理');\n                    }\n                    app.appview.filterParam=param;\n                    popover.hide();\n                    app.msgs.trigger('filter');\n\n                });\n\n                $('.form_date').datetimepicker({\n                    language: 'zh-CN',\n                    format: 'yyyy-mm-dd',\n                    weekStart: 1,\n                    todayBtn: 1,\n                    autoclose: 1,\n                    todayHighlight: 1,\n                    startView: 2,\n                    minView: 2,\n                    forceParse: 0\n                });\n\n                $('div.btn-group[data-toggle-name]').each(function () {\n                    var group = $(this);\n                    if (!group.hasClass('init')) {\n                        group.addClass('init');\n                        var name = group.attr('data-toggle-name');\n                        var hidden = $('input[name=\"' + name + '\"]', group);\n                        $('button', group).each(function () {\n                            var button = $(this);\n                            if (button.val() === hidden.val()) {\n                                button.addClass('btn-primary');\n                            }\n                            button.live('click', function () {\n                                $('button', group).each(function () {\n                                    $(this).removeClass('btn-primary');\n                                });\n                                hidden.val($(this).val());\n                                button.addClass('btn-primary');\n                            });\n                        });\n                    }\n                });\n            });\n\n        },\n        //同步更新消息类型与插件多对多关系\n        syncMsgTypeWithSourceSystem:function(){\n            var that=this;\n            var msgType=$('.head-nav li.current').data('type');\n            var msgSystem=$('.sub-tab a.checked').data('type');\n\n            var SourceSystemStore = {};\n            that.SourceSystem.forEach(function(SourceSystem) {\n                SourceSystemStore[SourceSystem.code] = SourceSystem;\n            });\n\n            if(app.MsgFilter===1&&msgSystem){//system\n               var  associateMsgType= SourceSystemStore[msgSystem].reationWithMsgType;\n                if(associateMsgType){\n                    var msgTypeStore = {};\n                    associateMsgType.forEach(function(msgType) {\n                        msgTypeStore[msgType] = msgType;\n                    });\n\n                    $('.head-nav li').each(function(){\n                        if(!msgTypeStore[$(this).data('type')]){\n                            $(this).hide();\n                        }else{\n                            $(this).show();\n                        }\n                    });\n                }\n            }else if(app.MsgFilter===2){\n\n                $(that.SourceSystem).each(function(index,val){\n                    var msgTypeStore = {};\n                    val.reationWithMsgType.forEach(function(msgType) {\n                        msgTypeStore[msgType] = msgType;\n                    });\n\n                    if(msgTypeStore[msgType]){\n                        $('a[data-type=\"'+val.code+'\"]').show();\n                    }else{\n                        $('a[data-type=\"'+val.code+'\"]').hide();\n                    }\n                });\n\n            }\n\n        },\n        loadSenderInfo:function(){\n        $(\"#senderPopDiv\").attr( 'class','sender-div');\n        \tvar pageSize = 3;\n        \tvar baseParam = { \n        \t\t\tpluginType: \"default\",\n            \t\tsourceSystemCode: \"UAP65\",  //必须 \n            \t\tisChangeState:false\n        \t};\n        \t$('#senderRefTablegp').bootstrapTable('destroy').bootstrapTable({\n                url: '/mp/msg/action',\n                cache: false,\n                contentType: 'application/json',\n                jsonToSend: true,\n                method: 'POST',\n                striped: true,\n                pagination: true,\n                pageSize: pageSize,\n                minimumCountColumns: 2,\n                queryParams: function (res) {\n                    res.search = res.search || '';\n                    res = $.extend(res, baseParam);\n                    return $.extend(res, {actionCode: 'getUserList', ref_type: 'user',isChangeState:false});\n                },\n                responseHandler: function (res) {\n                    var ret = {};\n                    if (res) {\n                        ret.total = res.ref_count;\n                        ret.rows = res.ref_result;\n                    }\n                    return ret;\n                },\n                clickToSelect: true\n            }).on('check.bs.table',function(e,row){\n\t            $(\"#senderInput\").val(row.name);\n\t            $(\"#senderInput\").attr('data-code',row.code);\n\t            $(\"#senderPopDiv\").attr( 'class','hidden');\n            });\n        \tif($(\"#senderRefTablegp\").find(\"thead\").find(\"tr\").children('th').length==5){\n        \t\t$(\"#senderRefTablegp\").find(\"tr\").children('th:last-child').remove();\n        \t}\n        \t\n        },\n        renderSearch:function(){\n            var query = _(function(e) {\n                var searchstr=$(e.target).val();\n                if(\"btn-search\"==$(e.target).attr('id')){\n                \tsearchstr = $('#search').val();\n                }\n                app.appview.filterAll(searchstr);\n            }).debounce(500);\n\n            $('#search').bind('keydown', query);\n            $('#btn-search').bind('click', query);\n            var topNav = $('.head-nav'), search = $('#search').css({'position': 'relavtive', 'z-index': 10}), searchWidth = search.outerWidth();\n            search.focus(function () {\n                search.animate({width: searchWidth * 1.5}, 'fast');\n                topNav.show();\n            }).blur(function () {\n                    if (0 == search.val().length) {\n                        search.animate({width: searchWidth}, 'fast', function () {\n                            topNav.show();\n                        });\n                    }\n                });\n\n        },\n        renderMsgType:function(){\n            var that=this;\n            $.ajax({\n                url: \"/mp/msgtype/list\",\n                type:'GET',\n                dataType: 'json',\n                cache:false,\n                async:false,\n                beforeSend:function(XMLHttpRequest){\n                \tif(typeof checkLogin =='function'){\n                \t\tcheckLogin(XMLHttpRequest);\n                \t}else if(typeof parent.checkLogin =='function'){\n                \t\tparent.checkLogin(XMLHttpRequest);\n                \t}else if(typeof top.checkLogin =='function'){\n                \t\ttop.checkLogin(XMLHttpRequest);\n                \t}\n\t            },\n                success:function(ret){\n                    if(typeof ret.status !== \"undefined\"){\n                        $.scojs_message(ret.msg, ret.status?$.scojs_message.TYPE_OK:$.scojs_message.TYPE_ERROR);\n                    }else{\n                        var data = _.extend({msgtype: ret});\n                        $(\"ul.head-nav\").empty().append(that.msg_type_template(data));\n                    }\n                }\n            });\n            //固定类型\n            /*var msgType=[{\n                \"code\": \"TASK\",\n                \"name\": \"待办\"\n                },\n                {\n                    \"code\": \"notice\",\n                    \"name\": \"通知\"\n                },\n                {\n                    \"code\": \"alert\",\n                    \"name\": \"预警\"\n                }];\n\n            var data = _.extend({msgtype: msgType});\n            $(\"ul.head-nav\").empty().append(that.msg_type_template(data));*/\n\n        },\n    