{\r\n    border-bottom: 1px solid #999;\r\n    margin-bottom: -1px;\r\n    background: #999;\r\n    color: #fff\r\n}\r\n\r\n.tab-nav > a em {\r\n    margin-left: 4px;\r\n    padding: 1px 3px;\r\n    background-color: #9a4444;\r\n    color: #fff;\r\n    font-size: 12px;\r\n    font-style: normal;\r\n    font-weight: normal;\r\n    line-height: 1\r\n}\r\n\r\n.tab-nav .sub-tab {\r\n    float: right;\r\n    margin-top: -30px;\r\n    color: #DDD\r\n}\r\n\r\n.tab-nav .sub-tab a {\r\n    margin: 0 5px;\r\n    padding: 2px 4px;\r\n    text-decoration: none\r\n}\r\n\r\n.tab-nav .sub-tab a.checked {\r\n    background: #428bca;\r\n    color: #FFF\r\n}\r\n\r\n\r\n.tab-nav .sub-tab a:hover {\r\n    background: #428bca;\r\n    color: #FFF\r\n}\r\n\r\nform > p, .form > p, form .p, .form .p {\r\n    position: relative;\r\n    margin: 24px 0\r\n}\r\n\r\nform p {\r\n    position: relative\r\n}\r\n\r\n.form-ls {\r\n    list-style: none;\r\n    margin: 0;\r\n    padding: 0\r\n}\r\n\r\n.form-action {\r\n    text-align: right\r\n}\r\n\r\n.form-action .btn {\r\n    margin-left: 10px\r\n}\r\n\r\ntextarea.fold {\r\n    height: 60px\r\n}\r\n\r\n.input-error {\r\n    border-color: #bb3636 !important\r\n}\r\n\r\n.fix-inline-msg {\r\n    display: inline-block\r\n}\r\n\r\n.input-desc {\r\n    display: inline-block;\r\n    margin-top: 8px;\r\n    color: #999\r\n}\r\n\r\n.input-preview {\r\n    color: #444\r\n}\r\n\r\n.w-s {\r\n    width: 20%\r\n}\r\n\r\n.w-m {\r\n    width: 40%\r\n}\r\n\r\n.w-l {\r\n    width: 60%\r\n}\r\n\r\n.w-xl {\r\n    width: 80%\r\n}\r\n\r\n.w-xxl {\r\n    width: 100%\r\n}\r\n\r\n.required:before {\r\n    content: '* ';\r\n    color: #e20000\r\n}\r\n\r\n\r\n.fmt {\r\n    font-size: 14px;\r\n    word-wrap: break-word\r\n}\r\n\r\n.fmt h1 {\r\n    padding-bottom: 10px;\r\n    border-bottom: 1px solid #DDD;\r\n    font-size: 1.57143em\r\n}\r\n\r\n.fmt h2 {\r\n    font-size: 1.42857em\r\n}\r\n\r\n.fmt h3 {\r\n    font-size: 1.28571em\r\n}\r\n\r\n.fmt h4 {\r\n    font-size: 1.14286em\r\n}\r\n\r\n.fmt h5 {\r\n    font-size: 1em\r\n}\r\n\r\n.fmt h6 {\r\n    font-size: .85714em\r\n}\r\n\r\n.fmt p, .fmt ul, .fmt ol, .fmt h1, .fmt h2, .fmt h3, .fmt h4, .fmt pre, .fmt blockquote, .fmt table {\r\n    margin: 20px 0\r\n}\r\n\r\n.fmt ol li, .fmt ul li {\r\n    margin: 5px 0\r\n}\r\n\r\n.fmt ul ul, .fmt ul ol, .fmt ol ul, .fmt ol ol {\r\n    margin: 0\r\n}\r\n\r\n.fmt img, .fmt video {\r\n    max-width: 100%\r\n}\r\n\r\n.fmt blockquote {\r\n    border-color: #009a61;\r\n    color: #555;\r\n    font-size: 1em\r\n}\r\n\r\n.fmt blockquote p:first-child {\r\n    margin-top: 0\r\n}\r\n\r\n.fmt pre, .fmt code {\r\n    font-size: .92857em\r\n}\r\n\r\n.fmt code {\r\n    white-space: pre\r\n}\r\n\r\n.fmt pre {\r\n    padding: 10px;\r\n    border: 0;\r\n    overflow: auto;\r\n    max-height: 400px;\r\n    line-height: 1.3\r\n}\r\n\r\n.fmt pre code {\r\n    background-color: transparent;\r\n    font-size: 1em\r\n}\r\n\r\n.fmt hr {\r\n    margin: 2em auto;\r\n    border: 0;\r\n    width: 160px;\r\n    height: 4px;\r\n    background: #EEE\r\n}\r\n\r\n.fmt table {\r\n    margin: 1em 0;\r\n    width: 100%\r\n}\r\n\r\n.fmt table th, .fmt table td {\r\n    border: 1px solid #e6e6e6;\r\n    padding: 6px 10px\r\n}\r\n\r\n.fmt table th {\r\n    background: #f3f3f3\r\n}\r\n\r\npre code {\r\n    display: block;\r\n    color: #333\r\n}\r\n\r\npre .container {\r\n    padding: 0\r\n}\r\n\r\npre .container:before, pre .container:after {\r\n    content: none;\r\n    display: inline\r\n}\r\n\r\n.i-time, .i-view, .i-tag {\r\n    width: 14px;\r\n    height: 14px;\r\n    text-align: left;\r\n    display: inline-block;\r\n    vertical-align: text-top\r\n}\r\n\r\n\r\n.i-time {\r\n    background:  url(../img/clock.png) no-repeat;\r\n}\r\n\r\n\r\n\r\n.i-tag {\r\n    background:  url(../img/attach.png) no-repeat;\r\n}\r\n\r\n.i-more-tag {\r\n    background:  url(../img/grey_attach.png) no-repeat;\r\n    width: 14px;\r\n    height: 14px;\r\n    text-align: left;\r\n    display: inline-block;\r\n    vertical-align: text-top;\r\n    margin-left: 30px;\r\n}\r\n\r\n.msg_each_content {\r\n    background-color: #ffffff;\r\n    margin-left: 30px;\r\n    margin-right: 30px;\r\n}\r\n\r\n.i-vote, .i-voted {\r\n    background-position: -2px -192px\r\n}\r\n\r\n.i-voted {\r\n    color: #009a61 !important\r\n}\r\n\r\n.i-flag {\r\n    background-position: -2px -209px\r\n}\r\n\r\n.clear {\r\n    clear: both;\r\n    display: block;\r\n    overflow: hidden;\r\n    visibility: hidden;\r\n    width: 0;\r\n    height: 0\r\n}\r\n\r\n.clearfix, .detail, .post, .post-foot {\r\n    zoom: 1\r\n}\r\n\r\n.clearfix:before, .detail:before, .post:before, .post-foot:before, .clearfix:after, .detail:after, .post:after, .post-foot:after {\r\n    content: '.';\r\n    display: block;\r\n    overflow: hidden;\r\n    visibility: hidden;\r\n    font-size: 0;\r\n    line-height: 0;\r\n    width: 0;\r\n    height: 0\r\n}\r\n\r\n.clearfix:after, .detail:after, .post:after, .post-foot:after {\r\n    clear: both\r\n}\r\n\r\n\r\n.pop-tag {\r\n    position: absolute;\r\n    width: 260px;\r\n    border: 1px solid #BBB;\r\n    background: #FFF;\r\n    font-size: 13px;\r\n    line-height: 1.5;\r\n    color: #666;\r\n    z-index: 100;\r\n    -webkit-box-shadow: 0 1px 12px rgba(0, 0, 0, 0.25);\r\n    -moz-box-shadow: 0 1px 12px rgba(0, 0, 0, 0.25);\r\n    box-shadow: 0 1px 12px rgba(0, 0, 0, 0.25)\r\n}\r\n\r\n.pop-tag .pop-head {\r\n    padding: 12px 12px 10px\r\n}\r\n\r\n.pop-tag .pop-head h4 {\r\n    margin: 0;\r\n    font-size: 14px;\r\n    color: #333\r\n}\r\n\r\n.pop-tag .pop-head h4.tag-img {\r\n    background-position: left center;\r\n    background-repeat: no-repeat;\r\n    padding-left: 22px\r\n}\r\n\r\n.pop-tag .pop-body {\r\n    padding: 0 12px 12px;\r\n    line-height: 1.6\r\n}\r\n\r\n.pop-tag .pop-body a {\r\n    color: #009a61\r\n}\r\n\r\n.pop-tag .pop-body cite {\r\n    color: #999\r\n}\r\n\r\n.pop-tag .pop-foot {\r\n    min-height: 20px;\r\n    color: #999\r\n}\r\n\r\n.pop-tag .pop-foot a {\r\n    color: #333\r\n}\r\n\r\n.pop-tag .pop-foot span a {\r\n    color: #009a61\r\n}\r\n\r\n.pop-tag .pop-foot.form-action {\r\n    border-top: 1px solid #DDD;\r\n    padding: 6px 10px;\r\n    background: #EEE;\r\n    text-align: right;\r\n    -webkit-box-shadow: inset 0 1px 0 white;\r\n    -moz-box-shadow: inset 0 1px 0 white;\r\n    box-shadow: inset 0 1px 0 white\r\n}\r\n\r\n.pop-tag .pop-foot .left {\r\n    margin-top: 2px\r\n}\r\n\r\na.tag, h4.tag {\r\n    display: inline-block;\r\n    background: #FFF;\r\n    border: 1px solid #e6e6e6;\r\n    padding: 0 8px;\r\n    height: 28px;\r\n    line-height: 28px;\r\n    max-width: 180px;\r\n    overflow: hidden;\r\n    color: #666;\r\n    vertical-align: middle;\r\n    font-size: 13px\r\n}\r\n\r\na.tag:hover, h4.tag:hover {\r\n    border-color: #BBB;\r\n    background-color: #f0f0f0;\r\n    text-decoration: none\r\n}\r\n\r\na.tag-img, h4.tag-img {\r\n    padding-left: 32px;\r\n    background-position: 8px center;\r\n    background-repeat: no-repeat\r\n}\r\n\r\n.big-tag-img {\r\n    width: 64px;\r\n    height: 64px\r\n}\r\n\r\n\r\n.common-title {\r\n    margin-top: 0\r\n}\r\n\r\n.big-title {\r\n    margin: 0 0 20px;\r\n    font-size: 36px\r\n}\r\n\r\n\r\n.sub-search {\r\n    display: inline-block;\r\n    vertical-align: middle;\r\n    width: 200px\r\n}\r\n\r\na.tag-interest-click {\r\n    color: #93b9ab\r\n}\r\n\r\n.box {\r\n    margin-top: 30px;\r\n    padding-top: 30px;\r\n    border-top: 1px solid #EEE\r\n}\r\n\r\n.box:first-child {\r\n    margin-top: 0;\r\n    padding-top: 0;\r\n    border-top: 0\r\n}\r\n\r\n.box h3 {\r\n    margin: 0 0 15px;\r\n    font-size: 15px\r\n}\r\n\r\n\r\n.box.fix-top {\r\n    padding-top: 30px\r\n}\r\n\r\n\r\n.greeting{\r\n    padding: 15px;\r\n    background: #EFF5FC;\r\n    line-height: 1.6;\r\n    color: #666\r\n}\r\n\r\n.greeting h3 {\r\n    margin-top: 0;\r\n    font-size: 18px;\r\n    color: #e41b23\r\n}\r\n\r\n.greeting + .box{\r\n    margin-top: 0;\r\n    border-top: 0\r