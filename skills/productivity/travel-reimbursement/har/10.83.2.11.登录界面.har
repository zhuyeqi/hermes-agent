          "content": {
            "size": 11094,
            "mimeType": "application/x-javascript",
            "text": "function preview(me) {\r\n\t//右侧初始化->画布隐藏，下载页面隐藏\r\n\t$('.preview_download').html(\"\").hide();\r\n\t$('.preview_content').html(\"\").hide();\r\n\tvar downloadUrl = me.getAttribute(\"downloadurl\");\r\n\t// 除了me以外的所有节点都设置为未选中状态\r\n\tvar lengthDiv = $('.preview_left > .click-preview').length;\r\n\tfor ( var index = 0; index < lengthDiv; index++) {\r\n\t\tvar ele = $('.preview_left > .click-preview')[index];\r\n\t\t$('.preview_left > .click-preview')[index].childNodes[0].className = \"\";\r\n\t\tvar divClassName = ele.className;\r\n\t\tif (divClassName.indexOf(\"select\") > 0) {\r\n\t\t\t// 将本样式XXX改为XXX-select\r\n\t\t\tdivClassName = divClassName.replace(\"-select\", \"\");\r\n\t\t\t$('.preview_left > .click-preview')[index].className = divClassName;\r\n\r\n\t\t}\r\n\t}\r\n\t// 改变me样式\r\n\t// 得到me的class样式\r\n\tvar meParentClassName = me.parentNode.className;\r\n\t// 未选中状态\r\n\tif (me.className == \"\") {\r\n\t\tme.className = \"select\";\r\n\t}\r\n\tif (meParentClassName.indexOf(\"select\") <= 0) {\r\n\t\t// 选中状态\r\n\t\tme.parentNode.className = me.parentNode.className.replace(\r\n\t\t\t\t\" click-preview\", \"\")\r\n\t\t\t\t+ \"-select\" + \" click-preview\";\r\n\t}\r\n\t$('.preview-loading').show();\r\n\t$(\".black_overlay\").height(\"100%\");\r\n\t$(\".MyDiv_left\").height(\"100%\");\r\n\t$(\".MyDiv_right\").height(\"100%\");\t\r\n\t// 浏览器不支持\r\n//\tif (!isSupportPreview()) {\r\n//\t\t\tdownloadfun(downloadUrl);\r\n//\t} else {\r\n\t// 渲染页面\r\n\t\tif(downloadUrl!=\"\"){\r\n\t       geturl(downloadUrl);\r\n\t    }else{\r\n\t    //消息模板为空\r\n\t    var msg=\"&nbsp;&nbsp;&nbsp;&nbsp;该任务内容无法展现的原因是在提交或审批任务之前流程对应的消息模板没有正确的配置附件，建议您设置消息模板的附件并重新提交任务，也可以选择直接到NC系统中处理任务。\";\r\n\t    previewError(msg);\r\n\t    }\r\n//\t}\r\n\t\r\n}\r\nfunction geturl(download) {\r\n\t$('.preview_download').html(\"\").hide();\r\n\t$('.preview_content').html(\"\").hide();\r\n\tif(download==\"\"){\r\n\t\t//消息模板为空\r\n\t\tvar msg=\"&nbsp;&nbsp;&nbsp;&nbsp;该任务内容无法展现的原因是在提交或审批任务之前流程对应的消息模板没有正确的配置附件，建议您设置消息模板的附件并重新提交任务，也可以选择直接到NC系统中处理任务。\";\r\n\t    previewError(msg);\r\n\t\treturn;\r\n\t}\r\n\t// 附件\r\n\t$.ajax({\r\n\t\turl : \"/mp/preview/getAttachUrl\",\r\n\t\ttype : 'GET',\r\n\t\tdataType : 'json',\r\n\t\tdata : {\r\n\t\t\tdownload:download\r\n\t\t},\r\n\t\tcache : false,\r\n\t\tasync : true,\r\n\t\tsuccess : function(ret) {\r\n\t\t\t// 隐藏进度条\r\n\t\t\t$('.preview-loading').hide();\r\n\t\t\tif (ret.status == \"error\") {\r\n\t\t\t\tpreviewError(\"&nbsp;&nbsp;&nbsp;&nbsp;预览出错，预览的过程是先从服务器上下载文件，在下载文件时遇到错误，请检查文件服务器的配置或尝试从NC系统中查看。\");\r\n\t\t\t}else if (ret.status == \"download\") {\r\n\t\t\t\tdownloadfun(download);\r\n\t\t\t}else if(ret.status == \"img\"){\r\n\t\t\t\t$('.preview_right').css(\"padding-left\",\"8px\");\r\n\t\t\t\t$('.preview_right').css(\"padding-right\",\"8px\");\r\n\t\t\t\t$('.preview_content').height($(window).height());\r\n\t\t\t\t$('.preview_content').html(\"\");\r\n\t\t\t\t//var canvansHtml=\"<img class='preview_img' src='\"+ret.url+\"' />\";\r\n//\t\t\t\tvar styleHtml='width: 560px;height: 570px;background: url(\"'+ret.url+'\") center center no-repeat; background-size: cover; position: absolute;';\r\n//\t\t\t\tvar canvansHtml=\"<div class='preview_img' style='\"+styleHtml+\"'></div>\";\t\t\t\r\n\t\t\t\tvar imgHtml=\"<img class='preview_img' src='\"+ret.url+\"'/>\";\r\n\t\t\t\t$('.preview_content').html(imgHtml);\r\n\t\t\t\t$('.preview_content').show();\r\n\t\t\t\t// Get on screen image\r\n\t\t\t\tvar screenImage = $(\".preview_img\");\r\n\t\t\t\tvar theImage = new Image();\r\n\t\t\t\ttheImage.src = screenImage.attr(\"src\");\t\r\n\t\t\t\tvar imgWidth=0;\r\n\t\t\t\tvar imgHeight=0;\r\n\t\t\t\tif(theImage.complete){\r\n\t\t\t\t\timgWidth = theImage.width;\r\n\t\t\t\t\timgHeight = theImage.height;\r\n\t\t\t\t\t//图片水平居中显示\r\n\t\t\t\t\tif($(\".preview_right\").width()/2>imgWidth/2){\r\n\t             \t\t$('.preview_content > img').css('margin-left',$(\".preview_right\").width()/2-imgWidth/2);            \t\t\r\n\t\t\t\t\t}else{\r\n\t             \t\t$('.preview_content > img').css('margin-left',0);\r\n\t             \t\t$('.preview_content > img').css('width',$(\".preview_right\").width());\t             \t\t\r\n\t             \t}\r\n\t\t\t\t\t//图片垂直居中显示\r\n\t\t\t\t\tif($(\".preview_content\").height()>imgHeight){\r\n\t             \t\t$('.preview_content > img').css('margin-top',$(\".preview_content\").height()/2-imgHeight/2);\t             \t    \r\n\t\t\t\t\t}else{\r\n\t             \t\t$('.preview_content > img').css('margin-top',5);\r\n\t             \t\t$('.preview_content > img').css('height',$(\".preview_content\").height()-10);\t             \t\t\r\n\t             \t}\r\n\t\t\t\t}\r\n\t\t\t\telse{\r\n\t\t\t\t    theImage.onload = function(){\r\n\t\t\t\t\timgWidth = theImage.width;\r\n\t\t\t\t\timgHeight = theImage.height;\r\n\t\t\t\t\t//图片水平居中显示\r\n\t\t\t\t\tif($(\".preview_right\").width()/2>imgWidth/2){\r\n\t             \t\t$('.preview_content > img').css('margin-left',$(\".preview_right\").width()/2-imgWidth/2);            \t\t\r\n\t\t\t\t\t}else{\r\n\t             \t\t$('.preview_content > img').css('margin-left',0);\r\n\t             \t\t$('.preview_content > img').css('width',$(\".preview_right\").width());\t             \t\t\r\n\t             \t}\r\n\t\t\t\t\t//图片垂直居中显示\r\n\t\t\t\t\tif($(\".preview_content\").height()>imgHeight){\r\n\t             \t\t$('.preview_content > img').css('margin-top',$(\".preview_content\").height()/2-imgHeight/2);\r\n\t             \t    \r\n\t\t\t\t\t}else{\r\n\t             \t\t$('.preview_content > img').css('margin-top',5);\r\n\t             \t\t$('.preview_content > img').css('height',$(\".preview_content\").height()-10);           \t\t\t\r\n\t             \t}\r\n\t\t\t\t};\r\n\t\t\t\t}\r\n\t\t\t\t\r\n\t\t\t\t\r\n\t\t\t\t\r\n             \t$('.preview_download').hide();\r\n             \t//设置预览的高度\r\n             \tsetPreviewContentHeight($('.preview_content').height());\r\n\t\t\t\t\r\n\t\t\t}else if(ret.status == \"html\"){\r\n\t\t\t\t$('.preview_right').css(\"padding-left\",\"8px\");\r\n\t\t\t\t$('.preview_right').css(\"padding-right\",\"8px\");\r\n\t\t\t\t$('.preview_content').css(\"overflow-x\",\"auto\");\r\n\t\t\t\t$('.preview_content').css(\"overflow-y\",\"auto\");\r\n\t\t\t\t$('.preview_content').html(\"\");\r\n\t\t\t\tvar canvansHtml=\"<div class='preview_html'>\"+ret.url+\"</div>\";\r\n\t\t\t\t$('.preview_content').html(canvansHtml);\r\n\t\t\t\t$('.preview_content').show();\r\n\t\t\t\t\r\n\t\t\t\t//水平居中\r\n\t\t\t\tif(($(\".preview_content\").width()/2>$('.preview_html').width()/2)){\r\n             \t\t$('.preview_html').css('margin-left',$(\".preview_content\").width()/2-$('.preview_html').width()/2);\r\n             \t}else{\r\n             \t\t$('.preview_html').css('margin-left',0);\r\n             \t\t\r\n             \t}\r\n\t\t\t\t//垂直居中\r\n             \tif($(\".preview_content\").height()>$('.preview_html').height()){\r\n             \t\t$('.preview_html').css('margin-top',$(\".preview_content\").height()/2-$('.preview_html').height()/2);\r\n             \t}else{\r\n             \t\t$('.preview_html').css('margin-top',0);\r\n             \t\t\r\n             \t}\r\n             \t//设置预览的高度\r\n             \tsetPreviewContentHeight($('.preview_html').height());\r\n             \t\r\n\t\t\t\t$('.preview_download').hide();\r\n\t\t\t}\t\t\t\r\n\t\t\telse if (ret.status == \"preview\") {\r\n\t\t\t\t//预览pdf文件\r\n\t\t\t\t//浏览器不支持pdf.js\r\n\t\t\t\tif(!isSupportPreview()) {\r\n\t\t\t\t\t//IE8下面安装了插件使用插件预览\r\n\t\t\t\t\tif(isAdobeRead()){\r\n\t\t\t\t\t\tpreviewPdf(ret.urlie8);\t\t\t\t\t\t\r\n\t\t\t\t\t}else{\r\n\t\t\t\t\t\tdownloadfun(download);\r\n\t\t\t\t\t}\r\n\t\t\t\t}else{\r\n\t\t\t\t\tpreviewPdf(ret.url);\r\n\t\t\t\t}\t\t\t\t\r\n\t\t\t} \r\n\r\n\t\t}\r\n\t});\r\n}\r\n\r\nfunction previewPdf(url){\r\n\t$('.preview_right').css(\"padding-left\",\"0\");\r\n\t$('.preview_right').css(\"padding-right\",\"0\");\r\n\t$('.preview_content').css(\"overflow\",\"hidden\");\r\n\t$('.preview_content').html(\"\");\r\n\tvar iframeWidth=window.screen.width*0.63-4;\r\n\tvar iframeHeight=$(window).height()-5;\r\n\t//var iframeHtml=\"<iframe id='previewIframe' style='border: 0px;' name='previewIframe' src='\"+url+\"' width='\"+iframeWidth+\"' height='\"+iframeHeight+\"' >hello<iframe>\";\r\n\tvar iframeHtml=\"<iframe id='previewIframe' style='border: 0px;' name='previewIframe' src='\"+url+\"' width='100%'height='\"+iframeHeight+\"' >hello<iframe>\";\r\n\t$('.preview_content').html(iframeHtml);\r\n\t$('.preview_content').show();\r\n\t$('.preview_download').hide();\r\n\tsetPreviewContentHeight($(window).height());\t\r\n}\r\n\r\nfunction downloadfun(url) {\r\n\t$('.preview-loading').hide();\r\n\t$('.preview_content').hide();\r\n\t$('.preview_download').html(\"\");\t\r\n\tvar divHeight=$(window).height()/2+55;\r\n\t$('.preview_download').html('<div><a href=\"' + url + '\">请下载后查看</a></div>');\r\n\t$('.preview_download > div').css(\"padding-top\",divHeight);\r\n\t$('.preview_download').show();\r\n\t\r\n}\r\n\r\nfunction previewError(msg) {\r\n\t$('.preview-loading').hide();\r\n\t$('.preview_content').hide();\r\n\t$('.preview_download').html(\"\");\t\r\n\tvar divHeight=$(window).height()/2+55;\r\n\t$('.preview_download').html('<div class=\"preview-error\">'+msg+'</div>');\r\n\t$('.preview_download > div').css(\"padding-top\",divHeight);\r\n\t$('.preview_download').show();\r\n\t\r\n}\r\n\r\nfunction isSupportPreview() {\r\n\tua = navigator.userAgent;\r\n\tua = ua.toLocaleLowerCase();\r\n\tvar browserType = \"\";\r\n\tvar browserVersion = \"\";\r\n\tif (ua.match(/msie/) != null || ua.match(/trident/) != null) {\r\n\t\tbrowserType = \"IE\";\r\n\t\t// 哈哈，现在可以检测ie11.0了！\r\n\t\tbrowserVersion = ua.match(/msie ([\\d.]+)/) != null ? ua\r\n\t\t\t\t.match(/msie ([\\d.]+)/)[1] : ua.match(/rv:([\\d.]+)/)[1];\r\n\t\tif (browserVersion < 9.0) {\r\n\t\t\treturn 0;\r\n\t\t}\r\n\r\n\t} else if (ua.match(/firefox/) != null) {\r\n\t\tbrowserType = \"火狐\";\r\n\t} else if (ua.match(/opera/) != null) {\r\n\t\tbrowserType = \"欧朋\";\r\n\t} else if (ua.match(/chrome/) != null) {\r\n\t\tbrowserType = \"谷歌\";\r\n\t} else if (ua.match(/safari/) != null) {\r\n\t\tbrowserType = \"Safari\";\r\n\t}\r\n\treturn 1;\r\n}\r\n\r\nfunction setPreviewContentHeight(height){\r\n\tif(window.msg){\r\n\t\treturn;\r\n\t}\r\n\tif($(\".black_overlay\").height()<height){\r\n\t  $(\".black_overlay\").height(height);\r\n\t  $(\".MyDiv_left\").height(height);\r\n\t  $(\".MyDiv_right\").height(height);\r\n\t}\r\n}\r\n/***\r\n * IE8下检查是否安装了adobe read\r\n */\r\nfunction isAdobeRead(){\r\n\t\tif(~window.navigator.appVersion.indexOf('MSIE 8.0')) { \r\n\t\t\tvar version = null;\r\n\t\t\tvar control = null;\r\n\t\t\ttry {\r\n\t\t\t\tcontrol = new ActiveXObject('AcroPDF.PDF');\r\n\t\t\t} catch (e) {\r\n\t\t\t}\r\n\t\t\tif (!control) {\r\n\t\t\t\ttry {\r\n\t\t\t\t\tcontrol = new ActiveXObject('PDF.PdfCtrl');\r\n\t\t\t\t} catch (e) {\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif (!control) {\r\n\t\t\t\ttry {\r\n\t\t\t\t\tcontrol = new ActiveXObject('Adobe Acrobat');\r\n\t\t\t\t} catch (e) {\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif (!control) {\r\n\t\t\t\ttry {\r\n\t\t\t\t\tcontrol = new ActiveXObject('Adobe PDF Plug-in');\r\n\t\t\t\t} catch (e) {\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif (!control) {\r\n\t\t\t\ttry {\r\n\t\t\t\t\tcontrol = new ActiveXObject('FOXITREADEROCX.FoxitReaderOCXCtrl.1');\r\n\t\t\t\t} catch (e) {\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t\tif (control) {\r\n\t\t\t\t//document.body.innerHTML = control.GetVersions();\r\n\t\t\t\treturn 1;\r\n\t\t\t} else {\r\n\t\t\t\t//document.body.innerHTML = '没有安装pdf插件'\r\n\t\t\t\treturn 0;\r\n\t\t\t}\r\n\t\t}\r\n\t}\r\n\r\n\r\n\r\n\r\n\r\n$(document).ready(function(){\r\n\t$(window).resize(function(){\r\n\t\tif($('#previewIframe')[0]){\r\n\t\t\t$('#previewIframe').height($(window).height());\r\n\t\t\t$(\".black_overlay\").height($(window).height());\r\n\t\t}\r\n\t});\r\n});\r\n"
          },
