gin =='function'){\r\n                    \t\tparent.checkLogin(XMLHttpRequest);\r\n                    \t}else if(typeof top.checkLogin =='function'){\r\n                    \t\ttop.checkLogin(XMLHttpRequest);\r\n                    \t}\r\n    \t            },\r\n                    success:function(ret){\r\n                    \t if(!ret){\r\n                             $.scojs_message(ret.msg, ret.status?$.scojs_message.TYPE_OK:$.scojs_message.TYPE_ERROR);\r\n                         }else{\r\n                        \t pluginType = JSON.parse(ret.msgVo.extendattr).pluginType;\r\n                        \t var data = _.extend({msg: ret},viewHelper);\r\n                        \t if(msgtype==\"notice\"){\r\n                        \t\t html=_this.notice_detail_template(data);\r\n//                             \tstr = _this.HTMLEncode(data.msg.msgVo.content);\r\n                        \t\t str = data.msg.msgVo.content;\r\n                           \t     /*data.msg.msgVo.content=str;\r\n                        \t\t var point = html.indexOf(\"msg_detail_content\");\r\n                        \t\t var sub =html.substr(point+20);\r\n                        \t\t var newsub ='<pre>'+str+'</pre>'+sub;\r\n                        \t\t html=html.substr(0,point+20)+newsub;*/\r\n                        \t\t title=\"通知—详情\";\r\n                        \t }else if(msgtype==\"alert\"){\r\n                        \t\t html=_this.alert_detail_template(data);\r\n//                        \t\t str = _this.HTMLEncode(data.msg.msgVo.content);\r\n                        \t\t str = data.msg.msgVo.content;\r\n                        \t\t title=\"预警—详情\";\r\n                        \t }\r\n                             $.fancybox.open({\r\n                         \t\ttitle:title,\r\n                        \t\ttitleShow:true,\r\n                        \t\thelpers: {\r\n                                   title : {\r\n                        \t                type : 'inside',\r\n       