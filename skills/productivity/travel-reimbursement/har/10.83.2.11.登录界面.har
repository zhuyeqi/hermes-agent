l {\r\n    background:  url(../img/notice_16.png) no-repeat 20px;\r\n    color: #666\r\n}\r\n\r\n.post .status .notice {\r\n    background: url(../img/note_16.png) no-repeat 20px;\r\n    color: #666\r\n}\r\n\r\n.post .status .note {\r\n    background: url(../img/mail_16.png) no-repeat 20px;\r\n    color: #666\r\n}\r\n\r\n\r\n.post .status .closed {\r\n    background-color: #999\r\n}\r\n\r\n.post .p-summary {\r\n\tmargin-top:3px;\r\n}\r\n\r\n.post .p-summary .author {\r\n    float: right;\r\n    margin: 2px 0 0 10px;\r\n    line-height: 1\r\n}\r\n.post .task_content {\r\n\tdisplay:block;width:100px;overflow:hidden;\r\n\twhite-space:nowrap;text-overflow:ellipsis;  \r\n}\r\n.post .resolved:before {\r\n    content: \"\\2714\";\r\n    color: #009a61;\r\n    margin-right: 8px\r\n}\r\n\r\n.post .resolved-ignore:before {\r\n    content: \"✗\";\r\n    color: #9a4444;\r\n    margin-right: 8px\r\n}\r\n\r\n.post .p-excerpt {\r\n    margin: 10px 0 0;\r\n    color: #777;\r\n    font-size: 13px;\r\n    line-height: 1.6\r\n}\r\n\r\n.post .p-excerpt .author {\r\n    float: left;\r\n    margin: 0 10px 0 0\r\n}\r\n\r\n.post .p-excerpt p {\r\n    margin: 0\r\n}\r\n\r\n.post .excerpt-bg {\r\n    border: 1px solid #EEE;\r\n    border-width: 1px 0 0 1px;\r\n    padding: 10px 0 5px 10px;\r\n    min-height: 52px\r\n}\r\n\r\n.post .excerpt-bg p {\r\n    margin-left: 5px\r\n}\r\n\r\n.post .list-action {\r\n    margin: 10px 0 2px;\r\n    color: #999\r\n}\r\n\r\n.readmore {\r\n    display: inline-block\r\n}\r\n\r\n.q-highlight {\r\n    margin-top: -1px;\r\n    border-width: 1px 0;\r\n/*     background: #EFF5FC */\r\n}\r\n\r\n.q-post {\r\n    padding-bottom: 10px\r\n}\r\n\r\n.target-fix {\r\n    position: relative;\r\n    top: -44px;\r\n    display: block;\r\n    height: 0;\r\n    overflow: hidden\r\n}\r\n\r\n\r\n.voted, .voted:hover, .voted:active, .hated, .hated:hover, .hated:active {\r\n    color: #009a61;\r\n    background-position: -43px 38px;\r\n    border-color: #CCC;\r\n    -webkit-box-s