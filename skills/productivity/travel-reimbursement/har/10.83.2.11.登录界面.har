            "text": "/*global Backbone */\nvar app = app || {};\n\n(function () {\n    'use strict';\n\n    // Todo Router\n    // ----------\n    var MSGIndexRouter = Backbone.Router.extend({\n        routes: {\n        \t\"logout\" :\t\"logout\",\n            \"filter/:date\" : \"setFilterDate\",\n            \"msg/msgs/:type\" : \"setFilterType\"\n        },\n        setFilterDate: function (param) {\n            // Set the current filter to be used\n            app.MsgFilterDate = param || '';\n            app.MsgFilter=1\n            app.msgs.trigger('filter');\n        },\n        setFilterType: function (param) {\n            // Set the current filter to be used\n            app.MsgFilterType = param || '';\n            app.MsgFilter=2\n            app.msgs.trigger('filter');\n        },\n        logout:function(){\n        \t$.cookie('mp_name',null);\n        \twindow.location='/mp/logout?_timestamp='+new Date().getTime();\n        }\n    });\n\n    app.MsgRouter = new MSGIndexRouter();\n    Backbone.history.start();\n\n})();"
