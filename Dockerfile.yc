FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source
FROM tianon/gosu:1.19-trixie@sha256:3b176695959c71e123eb390d427efc665eeb561b1540e82679c15e992006b8b9 AS gosu_source
FROM debian:13.4

ENV PYTHONUNBUFFERED=1

# Store Playwright browsers outside the volume mount so the build-time
# install survives the /opt/data volume overlay at runtime.
ENV PLAYWRIGHT_BROWSERS_PATH=/opt/hermes/.playwright

# Virtual desktop: run Chromium in headed mode inside Xvfb so legacy systems
# (SAP, etc.) that block headless browsers see a "real" desktop browser.
ENV AGENT_BROWSER_HEADED=true
ENV DISPLAY=:99
# Anti-detection: suppress automation indicators.
ENV AGENT_BROWSER_CHROME_FLAGS=--disable-blink-features=AutomationControlled
# Optional VNC for remote browser debugging (set port to enable, e.g. 5900).
ENV HERMES_VNC_PORT=0

RUN sed -i 's|http://deb.debian.org/debian|http://mirrors.aliyun.com/debian|g; s|http://security.debian.org/debian-security|http://mirrors.aliyun.com/debian-security|g' /etc/apt/sources.list.d/debian.sources

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
        build-essential nodejs npm python3 ripgrep ffmpeg python3-dev libffi-dev curl \
        procps git openssh-client docker-cli poppler-utils tini ca-certificates \
        xvfb fluxbox x11vnc fonts-noto-cjk-extra && \
    rm -rf /var/lib/apt/lists/*

RUN useradd -u 10000 -m -d /opt/data hermes

COPY --chmod=0755 --from=gosu_source /gosu /usr/local/bin/
COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/uvx /usr/local/bin/

WORKDIR /opt/hermes

# ---------- Layer-cached dependency install ----------
COPY package.json package-lock.json ./
COPY web/package.json web/package-lock.json web/
COPY ui-tui/package.json ui-tui/package-lock.json ui-tui/
COPY ui-tui/packages/hermes-ink/ ui-tui/packages/hermes-ink/

ENV npm_config_install_links=false

RUN npm ci --prefer-offline --no-audit && \
    npx playwright install --with-deps chromium && \
    npm install -g --prefer-offline --no-audit agent-browser && \
    (cd web && npm ci --prefer-offline --no-audit) && \
    (cd ui-tui && npm ci --prefer-offline --no-audit) && \
    npm cache clean --force && \
    test -n "$(find /opt/hermes/.playwright -name chrome -type f 2>/dev/null | head -1)"

# Point agent-browser to the Playwright-installed Chromium (dynamic path for runtime).
RUN _BROWSER=$(find /opt/hermes/.playwright -name chrome -type f | head -1) && \
    echo "AGENT_BROWSER_EXECUTABLE_PATH=${_BROWSER}" >> /etc/environment && \
    echo "export AGENT_BROWSER_EXECUTABLE_PATH=${_BROWSER}" > /etc/profile.d/hermes-browser.sh

# ---------- Source code ----------
COPY --chown=hermes:hermes . .

RUN cd web && npm run build && \
    cd ../ui-tui && npm run build

# ---------- Python virtualenv ----------
# Use Aliyun mirror for faster downloads in China, with PyPI as fallback.
ENV UV_INDEX_URL=https://mirrors.aliyun.com/pypi/simple/
ENV UV_EXTRA_INDEX_URL=https://pypi.org/simple/
RUN uv venv && \
    uv pip install --no-cache-dir -e ".[all]" && \
    uv pip install --no-cache-dir httpx && \
    uv pip install --no-cache-dir pymupdf

# ---------- Webwright browser agent skill ----------
# Clone to /opt/webwright (outside the hermes-agent-src volume mount)
# so source + skill files persist across image rebuilds.
RUN git clone --depth 1 https://github.com/microsoft/Webwright.git /opt/webwright && \
    . .venv/bin/activate && \
    uv pip install --no-cache-dir /opt/webwright && \
    python -m playwright install chromium firefox && \
    rm -rf /opt/webwright/.git

# ---------- Build artifact cleanup ----------
# Purge compilers and headers only needed during pip/uv install.
# Strip Python bytecode and unused GPU driver files to save space.
RUN apt-get update && \
    apt-get purge -y build-essential python3-dev libffi-dev gcc g++ make dpkg-dev && \
    apt-get autoremove -y --purge && \
    rm -rf /var/lib/apt/lists/* && \
    find /opt/hermes/.venv -type d -name __pycache__ -exec rm -rf {} + 2>/dev/null; \
    find /opt/hermes/.venv -name '*.pyc' -delete 2>/dev/null; \
    find /usr/lib -name 'libLLVM-*.so*' -delete 2>/dev/null; \
    find /usr/lib -path '*/dri/*' -name '*_video.so' -delete 2>/dev/null; \
    find /usr/lib -path '*/gallium-pipe/*' -delete 2>/dev/null; \
    true

# ---------- Permissions ----------
# Must run AFTER venv creation so .venv/ is also world-readable.
RUN chmod -R a+rX /opt/hermes

ENV HERMES_WEB_DIST=/opt/hermes/hermes_cli/web_dist
ENV HERMES_HOME=/opt/data
ENV PATH="/opt/hermes/.venv/bin:/opt/hermes/node_modules/.bin:/opt/data/.local/bin:${PATH}"
VOLUME [ "/opt/data" ]

ENTRYPOINT [ "/usr/bin/tini", "-g", "--", "/opt/hermes/docker/entrypoint.sh" ]
